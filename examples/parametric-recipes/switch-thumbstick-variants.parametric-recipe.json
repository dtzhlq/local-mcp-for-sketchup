{
  "artifact": "ParametricRecipe",
  "version": 1,
  "id": "switch-thumbstick-variants-v1",
  "name": "Switch Thumbstick Feature Mapping First Slice",
  "profile_id": "game_controller_switch",
  "units": "mm",
  "description": "Static first slice for reviewable thumbstick mapping variations. This artifact does not execute open scripts; it only declares a graph that can feed safe PartGraph or DSL work later.",
  "source_artifacts": {
    "part_graph": "examples/part-graphs/switch-controller-reference.part-graph.json",
    "product_profile": "examples/product-profiles/game_controller_switch.json"
  },
  "parameters": [
    {
      "id": "thumbstick_recess_depth_mm",
      "type": "number",
      "default": 2.4,
      "min": 1.5,
      "max": 4,
      "description": "Recess depth for the shell-mounted thumbstick pocket."
    },
    {
      "id": "thumbstick_pad_lift_mm",
      "type": "number",
      "default": 0,
      "min": -1,
      "max": 4,
      "description": "Additional lift applied to the top pad origin for reviewed variants."
    },
    {
      "id": "thumbstick_ring_segments",
      "type": "integer",
      "default": 24,
      "min": 12,
      "max": 48,
      "description": "Segment count used when replacing helper rings with explicit feature-backed cylinders."
    }
  ],
  "part_keys": [
    {
      "key": "left_thumbstick_stack",
      "part_ids": [
        "left-analog-stick-recess-ring",
        "left-analog-stick-stem",
        "left-analog-stick-top-pad",
        "left-analog-stick-groove-ring"
      ],
      "description": "Reviewed left thumbstick stack from the accepted Switch PartGraph."
    },
    {
      "key": "left_thumbstick_shell",
      "part_ids": [
        "left-warm-white-joy-con-shell"
      ],
      "description": "Left Joy-Con shell that receives the reviewed thumbstick recess feature intent."
    },
    {
      "key": "right_thumbstick_stack",
      "part_ids": [
        "right-analog-stick-recess-ring",
        "right-analog-stick-stem",
        "right-analog-stick-top-pad",
        "right-analog-stick-groove-ring"
      ],
      "description": "Reviewed right thumbstick stack from the accepted Switch PartGraph."
    },
    {
      "key": "right_thumbstick_shell",
      "part_ids": [
        "right-warm-white-joy-con-shell"
      ],
      "description": "Right Joy-Con shell that receives the reviewed thumbstick recess feature intent."
    }
  ],
  "feature_mapping_graph": {
    "nodes": [
      {
        "id": "left_thumbstick_recess",
        "kind": "feature",
        "operation": "cut_recess",
        "part_keys": [
          "left_thumbstick_shell",
          "left_thumbstick_stack"
        ],
        "parameter_bindings": [
          {
            "parameter_id": "thumbstick_recess_depth_mm",
            "target": "parts[left-warm-white-joy-con-shell].feature_intents",
            "transform": "append",
            "value_template": {
              "id": "left-thumbstick-recess-feature",
              "operation": "cut_recess",
              "semantic": "thumbstick_recess",
              "face": "top",
              "fallback_state": "real_feature_op",
              "parameters": {
                "center": [
                  25,
                  97
                ],
                "size": [
                  38,
                  38
                ],
                "depth": {
                  "$parameter": "thumbstick_recess_depth_mm"
                },
                "radius": 17,
                "segments": 24
              },
              "grounding_status": "review_confirmed",
              "review_required": false,
              "helper_allowed": false
            }
          }
        ],
        "variation_points": [
          "thumbstick_height_family"
        ],
        "outputs": [
          "feature_mapping_plan",
          "part_graph"
        ],
        "notes": "First slice keeps recess promotion reviewable instead of directly mutating the accepted PartGraph."
      },
      {
        "id": "right_thumbstick_recess",
        "kind": "feature",
        "operation": "cut_recess",
        "part_keys": [
          "right_thumbstick_shell",
          "right_thumbstick_stack"
        ],
        "parameter_bindings": [
          {
            "parameter_id": "thumbstick_recess_depth_mm",
            "target": "parts[right-warm-white-joy-con-shell].feature_intents",
            "transform": "append",
            "value_template": {
              "id": "right-thumbstick-recess-feature",
              "operation": "cut_recess",
              "semantic": "thumbstick_recess",
              "face": "top",
              "fallback_state": "real_feature_op",
              "parameters": {
                "center": [
                  37,
                  34
                ],
                "size": [
                  38,
                  38
                ],
                "depth": {
                  "$parameter": "thumbstick_recess_depth_mm"
                },
                "radius": 17,
                "segments": 24
              },
              "grounding_status": "review_confirmed",
              "review_required": false,
              "helper_allowed": false
            }
          }
        ],
        "variation_points": [
          "thumbstick_height_family"
        ],
        "outputs": [
          "feature_mapping_plan",
          "part_graph"
        ],
        "notes": "Mirror of the left recess mapping."
      },
      {
        "id": "left_thumbstick_stack_alignment",
        "kind": "part",
        "operation": "cylinder",
        "part_keys": [
          "left_thumbstick_stack"
        ],
        "depends_on": [
          "left_thumbstick_recess"
        ],
        "parameter_bindings": [
          {
            "parameter_id": "thumbstick_pad_lift_mm",
            "target": "parts[left-analog-stick-top-pad].shape.parameters.origin[2]",
            "transform": "add"
          },
          {
            "parameter_id": "thumbstick_ring_segments",
            "target": "parts[left-analog-stick-groove-ring].shape.parameters.segments",
            "transform": "replace"
          }
        ],
        "variation_points": [
          "thumbstick_height_family",
          "thumbstick_finish_family"
        ],
        "outputs": [
          "feature_mapping_plan"
        ],
        "notes": "Static plan node for reviewed ring/pad variation before any runtime compile."
      },
      {
        "id": "right_thumbstick_stack_alignment",
        "kind": "part",
        "operation": "cylinder",
        "part_keys": [
          "right_thumbstick_stack"
        ],
        "depends_on": [
          "right_thumbstick_recess"
        ],
        "parameter_bindings": [
          {
            "parameter_id": "thumbstick_pad_lift_mm",
            "target": "parts[right-analog-stick-top-pad].shape.parameters.origin[2]",
            "transform": "add"
          },
          {
            "parameter_id": "thumbstick_ring_segments",
            "target": "parts[right-analog-stick-groove-ring].shape.parameters.segments",
            "transform": "replace"
          }
        ],
        "variation_points": [
          "thumbstick_height_family",
          "thumbstick_finish_family"
        ],
        "outputs": [
          "feature_mapping_plan"
        ],
        "notes": "Static plan node for the mirrored right thumbstick stack."
      }
    ]
  },
  "variation_points": [
    {
      "id": "thumbstick_height_family",
      "description": "Shared pad-lift and recess-depth changes that must be reviewed once before any fanout.",
      "parameter_ids": [
        "thumbstick_recess_depth_mm",
        "thumbstick_pad_lift_mm"
      ],
      "node_ids": [
        "left_thumbstick_recess",
        "right_thumbstick_recess",
        "left_thumbstick_stack_alignment",
        "right_thumbstick_stack_alignment"
      ],
      "part_keys": [
        "left_thumbstick_shell",
        "right_thumbstick_shell",
        "left_thumbstick_stack",
        "right_thumbstick_stack"
      ],
      "compile_paths": [
        "parts[left-warm-white-joy-con-shell].feature_intents",
        "parts[right-warm-white-joy-con-shell].feature_intents",
        "parts[left-analog-stick-top-pad].shape.parameters.origin[2]",
        "parts[right-analog-stick-top-pad].shape.parameters.origin[2]"
      ]
    },
    {
      "id": "thumbstick_finish_family",
      "description": "Ring segmentation changes should stay symmetric across left and right stacks.",
      "parameter_ids": [
        "thumbstick_ring_segments"
      ],
      "node_ids": [
        "left_thumbstick_stack_alignment",
        "right_thumbstick_stack_alignment"
      ],
      "part_keys": [
        "left_thumbstick_stack",
        "right_thumbstick_stack"
      ],
      "compile_paths": [
        "parts[left-analog-stick-groove-ring].shape.parameters.segments",
        "parts[right-analog-stick-groove-ring].shape.parameters.segments"
      ]
    }
  ],
  "compile": {
    "target": {
      "kind": "part_graph",
      "notes": "Current first slice emits a static FeatureMappingPlan toward PartGraph review, not direct runtime execution."
    },
    "batch": {
      "mode": "first_output_then_fanout",
      "first_output": {
        "candidate_id": "baseline",
        "required_artifacts": [
          "feature_mapping_plan",
          "compile_report"
        ],
        "required_report_shape": "parametric_recipe_compile_report_v1"
      },
      "fanout": [
        {
          "id": "baseline",
          "label": "Baseline reviewed thumbstick mapping",
          "parameter_overrides": {}
        },
        {
          "id": "taller_pad",
          "label": "Taller thumbstick pad review candidate",
          "parameter_overrides": {
            "thumbstick_pad_lift_mm": 1.5
          },
          "notes": "Only run after the baseline report shape exists."
        }
      ]
    }
  }
}
