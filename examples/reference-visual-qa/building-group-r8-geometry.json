      },
      {
        "id": "inner-south-warehouse-center",
        "view": "site_top",
        "item": "warehouse_inner_south_body",
        "point": "center",
        "expected": [0.354, 0.32],
        "tolerance": 0.07,
        "correction_target": {
          "part_id": "warehouse_inner_south_body",
          "path": "parts[warehouse_inner_south_body].shape.parameters.origin"
        }
      }
