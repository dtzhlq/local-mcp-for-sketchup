{
  "version": 1,
  "title": "Building Group R8 Editable Geometry Reference Visual QA",
  "description": "Reference-facing QA for the no-texture building-group boundary probe. It verifies visible site placement, four separated warehouse buildings, editable gable roofs, and accepted roof/facade feature detail without relying on image planes.",
  "rules": {
    "views": [
      {
        "name": "site_top",
        "title": "Editable Geometry Site Top Reference",
        "axes": ["x", "y"],
        "depth_axis": "z",
        "frame": {
          "items": ["site_boundary"]
        }
      },
      {
        "name": "height_front",
        "title": "Editable Geometry Height And Feature Reference",
        "axes": ["x", "z"],
        "depth_axis": "y",
        "frame": {
          "items": [
            "primary_blue_roof_hall_body",
            "primary_blue_hall_gable_roof",
            "warehouse_west_north_body",
            "warehouse_west_south_body",
            "warehouse_inner_north_body",
            "warehouse_inner_south_body",
            "utility_building",
            "admin_office",
            "tank_farm",
            "tank_farm_silo_east"
          ]
        }
      }
    ],
    "keypoints": [
      {
        "id": "blue-hall-geometry-center",
        "view": "site_top",
        "item": "primary_blue_roof_hall_body",
        "point": "center",
        "expected": [0.572, 0.65],
        "tolerance": 0.035,
        "correction_target": {
          "part_id": "primary_blue_roof_hall_body",
          "path": "parts[primary_blue_roof_hall_body].shape.parameters.origin"
        }
      },
      {
        "id": "parking-geometry-center",
        "view": "site_top",
        "item": "parking_lot",
        "point": "center",
        "expected": [0.782, 0.173],
        "tolerance": 0.04,
        "correction_target": {
          "part_id": "parking_lot",
          "path": "parts[parking_lot].shape.parameters.origin"
        }
      },
      {
        "id": "west-north-warehouse-center",
        "view": "site_top",
        "item": "warehouse_west_north_body",
        "point": "center",
        "expected": [0.152, 0.75],
        "tolerance": 0.07,
        "correction_target": {
          "part_id": "warehouse_west_north_body",
          "path": "parts[warehouse_west_north_body].shape.parameters.origin"
        }
      },
      {
        "id": "west-south-warehouse-center",
