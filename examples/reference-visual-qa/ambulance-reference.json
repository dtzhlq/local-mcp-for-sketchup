{
  "version": 1,
  "title": "Ambulance Reference Visual QA",
  "description": "Reference-facing visual QA for the ProductProfile + PartGraph ambulance sample. Coordinates are normalized inside each orthographic view frame and correction targets point back to PartGraph fields. This spec now uses the rescue-vehicle photo set as the visual anchor for side silhouette, cab height, windshield rake, side window, roof lightbar, stripe, and label size.",
  "rules": {
    "views": [
      {
        "name": "left",
        "title": "Left Reference Match",
        "axes": ["x", "z"],
        "depth_axis": "y",
        "frame": {
          "items": [
            "amb-cab-lower",
            "amb-cab-upper-shell",
            "amb-main-body",
            "wheel-left-front-tire",
            "wheel-left-rear-tire",
            "roof-red-lightbar",
            "roof-white-equipment",
            "rear-left-tail-light"
          ]
        }
      },
      {
        "name": "top",
        "title": "Top Reference Match",
        "axes": ["x", "y"],
        "depth_axis": "z",
        "frame": {
          "items": [
            "amb-main-body",
            "amb-cab-lower",
            "amb-cab-upper-shell",
            "roof-red-lightbar",
            "roof-white-equipment"
          ]
        }
      },
      {
        "name": "front",
        "title": "Front Reference Match",
        "axes": ["y", "z"],
        "depth_axis": "x",
        "frame": {
          "items": [
            "amb-cab-lower",
            "amb-cab-upper-shell",
            "amb-windshield",
            "amb-front-grille",
            "amb-left-headlight",
            "amb-right-headlight"
          ]
        }
      }
    ],
    "silhouettes": [
      {
        "id": "left-overall-silhouette-aspect",
        "view": "left",
        "items": [
          "amb-cab-lower",
          "amb-cab-upper-shell",
          "amb-main-body",
          "wheel-left-front-tire",
          "wheel-left-rear-tire",
          "roof-red-lightbar",
          "roof-white-equipment",
          "rear-left-tail-light"
        ],
        "aspect_ratio": 2.2,
        "tolerance": 0.06,
        "correction_target": {
          "part_id": "amb-main-body",
          "path": "parts[amb-main-body].shape.parameters.size"
        }
      },
      {
        "id": "top-overall-silhouette-aspect",
        "view": "top",
        "items": [
          "amb-main-body",
          "amb-cab-lower",
          "amb-cab-upper-shell",
          "roof-red-lightbar",
          "roof-white-equipment"
        ],
        "aspect_ratio": 2.67,
        "tolerance": 0.04,
        "correction_target": {
          "part_id": "amb-main-body",
          "path": "parts[amb-main-body].shape.parameters.size"
        }
      },
      {
        "id": "front-cab-silhouette-aspect",
        "view": "front",
        "items": [
          "amb-cab-lower",
          "amb-cab-upper-shell",
          "amb-windshield",
          "amb-front-grille",
          "amb-left-headlight",
          "amb-right-headlight"
        ],
        "aspect_ratio": 1.08,
        "tolerance": 0.05,
        "correction_target": {
          "part_id": "amb-cab-upper-shell",
          "path": "parts[amb-cab-upper-shell].shape.parameters"
        }
      }
    ],
    "keypoints": [
      {
        "id": "body-side-center",
        "view": "left",
        "item": "amb-main-body",
        "point": "center",
        "expected": [0.58, 0.54],
        "tolerance": 0.045,
        "correction_target": {
          "part_id": "amb-main-body",
          "path": "parts[amb-main-body].shape.parameters.origin"
        }
      },
      {
        "id": "cab-lower-side-center",
        "view": "left",
        "item": "amb-cab-lower",
        "point": "center",
        "expected": [0.13, 0.45],
        "tolerance": 0.045,
        "correction_target": {
          "part_id": "amb-cab-lower",
          "path": "parts[amb-cab-lower].shape.parameters.origin"
        }
