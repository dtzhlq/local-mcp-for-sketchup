{
  "version": 1,
  "title": "Building Group R7 Relation Candidate Reference Visual QA",
  "description": "Reference-facing QA for the VisualRelationGraph candidate promotion slice. Warehouse row checks aggregate the four promoted warehouse-unit parts, while parking and landscape candidates remain checked by footprint and relation QA.",
  "rules": {
    "views": [
      {
        "name": "site_top",
        "title": "Site Plan Reference",
        "axes": ["x", "y"],
        "depth_axis": "z",
        "frame": {
          "items": ["internal_roads"]
        }
      },
      {
        "name": "height_front",
        "title": "Height Tier Reference",
        "axes": ["x", "z"],
        "depth_axis": "y",
        "frame": {
          "items": [
            "primary_blue_roof_hall",
            "warehouse_west_north",
            "warehouse_west_south",
            "warehouse_inner_north",
            "warehouse_inner_south",
            "utility_building",
            "admin_office",
            "tank_farm",
            "tank_farm_silo_east"
          ]
        }
      }
    ],
    "silhouettes": [
      {
        "id": "road-network-top-aspect",
        "view": "site_top",
        "item": "internal_roads",
        "aspect_ratio": 1.405,
        "tolerance": 0.02,
        "correction_target": {
          "part_id": "internal_roads",
          "path": "parts[internal_roads].shape.parameters.size"
        }
      }
    ],
    "keypoints": [
      {
        "id": "primary-blue-hall-site-center",
        "view": "site_top",
        "item": "primary_blue_roof_hall",
        "point": "center",
        "expected": [0.581, 0.654],
        "tolerance": 0.025,
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.origin"
        }
      },
      {
        "id": "parking-lot-site-center",
        "view": "site_top",
        "item": "parking_lot",
        "point": "center",
        "expected": [0.798, 0.131],
        "tolerance": 0.03,
        "correction_target": {
          "part_id": "parking_lot",
          "path": "parts[parking_lot].shape.parameters.origin"
        }
      },
      {
        "id": "tank-farm-site-center",
        "view": "site_top",
        "items": ["tank_farm", "tank_farm_silo_east"],
        "point": "center",
        "expected": [0.91, 0.862],
        "tolerance": 0.03,
        "correction_target": {
          "part_id": "tank_farm",
          "path": "parts[tank_farm].shape.parameters.origin"
        }
      }
    ],
    "extent_ratios": [
      {
        "id": "primary-blue-hall-top-extent",
        "view": "site_top",
        "item": "primary_blue_roof_hall",
        "expected": [0.269, 0.634],
        "tolerance": [0.035, 0.045],
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.size"
        }
      },
      {
        "id": "west-warehouse-candidates-top-extent",
        "view": "site_top",
        "items": ["warehouse_west_north", "warehouse_west_south"],
        "expected": [0.105, 0.863],
        "tolerance": [0.035, 0.05],
        "correction_target": {
          "part_id": "warehouse_west_north",
          "path": "parts[warehouse_west_north].shape.parameters.size"
        }
      },
      {
        "id": "inner-warehouse-candidates-top-extent",
        "view": "site_top",
        "items": ["warehouse_inner_north", "warehouse_inner_south"],
        "expected": [0.11, 0.863],
        "tolerance": [0.03, 0.05],
        "correction_target": {
          "part_id": "warehouse_inner_north",
          "path": "parts[warehouse_inner_north].shape.parameters.size"
        }
      },
      {
        "id": "parking-lot-top-extent",
        "view": "site_top",
        "item": "parking_lot",
        "expected": [0.36, 0.237],
        "tolerance": [0.04, 0.035],
        "correction_target": {
          "part_id": "parking_lot",
          "path": "parts[parking_lot].shape.parameters.size"
        }
      },
      {
        "id": "road-network-top-extent",
        "view": "site_top",
        "item": "internal_roads",
        "expected": [1, 1],
        "tolerance": [0.045, 0.045],
        "correction_target": {
          "part_id": "internal_roads",
          "path": "parts[internal_roads].shape.parameters.size"
        }
      },
      {
        "id": "tank-pair-top-extent",
        "view": "site_top",
        "items": ["tank_farm", "tank_farm_silo_east"],
        "expected": [0.107, 0.071],
        "tolerance": [0.025, 0.02],
        "correction_target": {
          "part_id": "tank_farm",
          "path": "parts[tank_farm].shape.parameters.radius"
        }
      },
      {
        "id": "primary-blue-hall-height-tier",
        "view": "height_front",
        "item": "primary_blue_roof_hall",
        "expected": [0.326, 1],
        "tolerance": [0.04, 0.04],
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.size"
        }
      },
      {
        "id": "west-warehouse-candidates-height-tier",
        "view": "height_front",
        "items": ["warehouse_west_north", "warehouse_west_south"],
        "expected": [0.124, 0.576],
        "tolerance": [0.04, 0.04],
        "correction_target": {
          "part_id": "warehouse_west_north",
          "path": "parts[warehouse_west_north].shape.parameters.size"
        }
      },
      {
        "id": "tank-height-tier",
        "view": "height_front",
        "items": ["tank_farm", "tank_farm_silo_east"],
        "expected": [0.107, 0.848],
        "tolerance": [0.03, 0.045],
        "correction_target": {
          "part_id": "tank_farm",
          "path": "parts[tank_farm].shape.parameters.height"
        }
      }
    ],
    "area_ratios": [
      {
        "id": "primary-blue-hall-area-share",
        "view": "site_top",
        "item": "primary_blue_roof_hall",
        "expected": 0.17,
        "tolerance": 0.035,
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.size"
        }
      },
      {
        "id": "parking-lot-area-share",
        "view": "site_top",
        "item": "parking_lot",
        "expected": 0.085,
        "tolerance": 0.02,
        "correction_target": {
          "part_id": "parking_lot",
          "path": "parts[parking_lot].shape.parameters.size"
        }
      },
      {
        "id": "road-network-area-share",
        "view": "site_top",
        "item": "internal_roads",
        "expected": 1,
        "tolerance": 0.06,
        "correction_target": {
          "part_id": "internal_roads",
          "path": "parts[internal_roads].shape.parameters.size"
        }
      }
    ],
    "orientation": [
      {
        "id": "blue-hall-east-of-inner-warehouse-candidate",
        "view": "site_top",
        "item": "primary_blue_roof_hall",
        "anchor": "warehouse_inner_north",
        "direction": "right_of",
        "min_delta": 0.15,
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.origin"
        }
      },
      {
        "id": "inner-warehouse-east-of-west-warehouse-candidate",
        "view": "site_top",
        "item": "warehouse_inner_north",
        "anchor": "warehouse_west_north",
        "direction": "right_of",
        "min_delta": 0.08,
        "correction_target": {
          "part_id": "warehouse_inner_north",
          "path": "parts[warehouse_inner_north].shape.parameters.origin"
        }
      },
      {
        "id": "west-warehouse-north-above-south-candidate",
        "view": "site_top",
        "item": "warehouse_west_north",
        "anchor": "warehouse_west_south",
        "direction": "above",
        "min_delta": 0.2,
        "correction_target": {
          "part_id": "warehouse_west_north",
          "path": "parts[warehouse_west_north].shape.parameters.origin"
        }
      },
      {
        "id": "parking-south-of-blue-hall",
        "view": "site_top",
        "item": "parking_lot",
        "anchor": "primary_blue_roof_hall",
        "direction": "below",
        "min_delta": 0.25,
        "correction_target": {
          "part_id": "parking_lot",
          "path": "parts[parking_lot].shape.parameters.origin"
        }
      },
      {
        "id": "primary-hall-taller-than-west-warehouse-candidate",
        "view": "height_front",
        "item": "primary_blue_roof_hall",
        "anchor": "warehouse_west_north",
        "direction": "above",
        "min_delta": 0.15,
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.size"
        }
      }
    ]
  }
}
