{
  "version": 1,
  "title": "Building Group R7 Massing Reference Visual QA",
  "description": "Reference-facing QA for the review-gated industrial-campus massing sample. The top-view ratios are normalized against the site boundary estimated from parking, drive-aisle, and crosswalk anchors; height-view rules keep the coarse massing tiers stable without claiming final facade or roof reconstruction.",
  "rules": {
    "views": [
      {
        "name": "site_top",
        "title": "Site Plan Reference",
        "axes": ["x", "y"],
        "depth_axis": "z",
        "frame": {
          "items": ["internal_roads"]
        }
      },
      {
        "name": "height_front",
        "title": "Height Tier Reference",
        "axes": ["x", "z"],
        "depth_axis": "y",
        "frame": {
          "items": [
            "primary_blue_roof_hall",
            "warehouse_row_west",
            "warehouse_row_inner",
            "utility_building",
            "admin_office",
            "tank_farm",
            "tank_farm_silo_east"
          ]
        }
      }
    ],
    "silhouettes": [
      {
        "id": "road-network-top-aspect",
        "view": "site_top",
        "item": "internal_roads",
        "aspect_ratio": 1.405,
        "tolerance": 0.02,
        "correction_target": {
          "part_id": "internal_roads",
          "path": "parts[internal_roads].shape.parameters.size"
        }
      }
    ],
    "keypoints": [
      {
        "id": "primary-blue-hall-site-center",
        "view": "site_top",
        "item": "primary_blue_roof_hall",
        "point": "center",
        "expected": [0.612, 0.6],
        "tolerance": 0.025,
        "correction_target": {
          "part_id": "primary_blue_roof_hall",
          "path": "parts[primary_blue_roof_hall].shape.parameters.origin"
        }
      },
      {
        "id": "west-warehouse-site-center",
        "view": "site_top",
