{
  "version": 1,
  "title": "Building Group R7 Massing Layout QA",
  "description": "Review-gated layout QA for the R7 industrial-campus massing sample generated from GPT Image aerial inputs. Road, parking, and scale-anchor overlaps are explicit because this gate checks the current bbox-derived massing contract, not final architectural acceptance.",
  "rules": {
    "allowed_collisions": [
      {
        "item": "internal_roads",
        "with": [
          "primary_blue_roof_hall",
          "warehouse_row_west",
          "warehouse_row_inner",
          "utility_building",
          "admin_office",
          "parking_lot",
          "tank_farm",
          "tank_farm_silo_east"
        ]
      },
      {
        "item": "utility_building",
        "with": "scale_anchor_crosswalk_width"
      },
      {
        "item": "scale_anchor_parking_bay_width_span",
        "with": [
          "scale_anchor_parking_bay_single",
          "scale_anchor_parking_drive_aisle_width"
        ]
      },
      {
        "item": "scale_anchor_parking_bay_single",
        "with": "scale_anchor_parking_drive_aisle_width"
      }
    ],
    "inside": [
      {
        "match": "^(primary_blue_roof_hall|warehouse_row_west|warehouse_row_inner|utility_building|admin_office|parking_lot|internal_roads|tank_farm|tank_farm_silo_east|scale_anchor_.*)$",
        "parent": "site_boundary",
        "axes": ["x", "y"],
        "tolerance_mm": 10
      }
    ],
    "support": [
      {
        "match": "^(primary_blue_roof_hall|warehouse_row_west|warehouse_row_inner|utility_building|admin_office|parking_lot|internal_roads|tank_farm|tank_farm_silo_east)$",
        "parent": "site_boundary",
        "max_gap_mm": 5,
        "allow_penetration_mm": 1
      }
    ],
    "separation": [
      {
        "name": "blue hall separated from inner warehouse row",
        "items": ["primary_blue_roof_hall", "warehouse_row_inner"],
        "axes": ["x", "y"],
        "min_gap_mm": 1000
      },
      {
        "name": "blue hall separated from utility building",
        "items": ["primary_blue_roof_hall", "utility_building"],
        "axes": ["x", "y"],
        "min_gap_mm": 1000
      },
      {
        "name": "western warehouse rows stay distinct",
        "items": ["warehouse_row_west", "warehouse_row_inner"],
        "axes": ["x", "y"],
        "min_gap_mm": 900
      },
      {
        "name": "tank silos stay individually readable",
        "items": ["tank_farm", "tank_farm_silo_east"],
        "axes": ["x", "y"],
        "min_gap_mm": 500
      },
      {
        "name": "parking lot separated from admin office",
        "items": ["parking_lot", "admin_office"],
        "axes": ["x", "y"],
        "min_gap_mm": 1000
      }
    ],
    "views": [
      "top",
      {
        "name": "height",
        "title": "Height Massing",
        "axes": ["x", "z"],
        "depth_axis": "y"
      }
    ]
  }
}
