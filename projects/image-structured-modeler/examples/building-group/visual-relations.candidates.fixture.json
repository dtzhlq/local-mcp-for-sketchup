      "parking_lot": ["parking_lot"],
      "internal_roads": ["internal_roads"],
      "west_warehouse_north": ["warehouse_west_north"],
      "west_warehouse_south": ["warehouse_west_south"],
      "inner_warehouse_north": ["warehouse_inner_north"],
      "inner_warehouse_south": ["warehouse_inner_south"],
      "parking_stall_row_north": ["parking_stall_row_north"],
      "parking_stall_row_south": ["parking_stall_row_south"],
      "parking_drive_aisle": ["parking_drive_aisle_center"],
      "tree_row_south": ["tree_row_south"],
      "parking_bay_span": ["scale_anchor_parking_bay_width_span"],
      "parking_bay_single": ["scale_anchor_parking_bay_single"]
    }
  },
  "footprint_rules": [
