{
  "version": 1,
  "id": "switch-controller-visual-relations",
  "description": "Minimal VisualRelationGraph regression fixture that turns previous manual Switch visual checks into image-space relation and model-projection QA.",
  "model": {
    "axes": ["x", "y"],
    "frame_items": [
      "left-back-grip-lobe",
      "right-back-grip-lobe",
      "back-lower-bridge",
      "center-black-switch-grip",
      "left-warm-white-joy-con-shell",
      "right-warm-white-joy-con-shell",
      "center-front-flat-panel"
    ]
  },
  "geometry_fit": {
    "image_view": "front",
    "image_frame": "controller_frame"
  },
  "aliases": {
    "image": {
      "controller_frame": ["main_object"],
      "left_handle": ["left_joycon_shell"],
      "right_handle": ["right_joycon_shell"],
      "center_grip": ["center_grip_body"],
      "screen": ["center_front_panel"],
      "left_thumbstick": ["left_thumbstick"],
      "right_thumbstick": ["right_thumbstick"],
      "abxy": ["abxy_cluster"],
      "dpad": ["dpad_cluster", "left_button_cluster"]
    },
    "model": {
      "left_handle": ["left-warm-white-joy-con-shell"],
      "right_handle": ["right-warm-white-joy-con-shell"],
      "center_grip": ["center-black-switch-grip"],
      "screen": ["center-front-flat-panel"],
      "left_thumbstick": ["left-analog-stick-top-pad"],
      "right_thumbstick": ["right-analog-stick-top-pad"],
      "abxy": ["button-x-button"],
      "dpad": ["dpad-up-button"]
    }
  },
  "required_relations": [
    {
      "id": "handles-left-right-order",
      "type": "left_of",
      "item": "left_handle",
      "anchor": "right_handle",
      "image_view": "front",
      "min_confidence": 0.52,
      "min_model_delta": 0.25,
      "expected_model_delta": [0.64, 0],
      "spacing_tolerance": 0.18,
      "spacing_ratio_tolerance": 0.2,
      "mirror_negative": true
    },
    {
      "id": "thumbsticks-handedness",
      "type": "right_of",
      "item": "right_thumbstick",
      "anchor": "left_thumbstick",
      "image_view": "front",
      "min_confidence": 0.52,
      "min_model_delta": 0.25,
      "expected_model_delta": [0.676, 0.371],
      "spacing_tolerance": 0.23,
      "spacing_ratio_tolerance": 0.45,
      "mirror_negative": true
    },
    {
      "id": "face-buttons-right-of-dpad",
      "type": "right_of",
      "item": "abxy",
      "anchor": "dpad",
      "image_view": "front",
      "min_confidence": 0.52,
      "min_model_delta": 0.25,
      "expected_model_delta": [0.676, 0.306],
      "spacing_tolerance": 0.2,
      "spacing_ratio_tolerance": 0.2,
      "mirror_negative": true
    },
    {
      "id": "screen-inside-center-grip",
      "type": "inside",
      "item": "screen",
      "anchor": "center_grip",
      "image_view": "front",
      "min_confidence": 0.5,
      "spacing_ratio_tolerance": 0.2,
      "model_tolerance": 0.02
    },
    {
      "id": "screen-centered-on-center-grip",
      "type": "centered_on",
      "item": "screen",
      "anchor": "center_grip",
      "image_view": "front",
      "min_confidence": 0.5,
      "spacing_ratio_tolerance": 0.2,
      "model_tolerance": 0.08
    },
    {
      "id": "handle-shells-mirrored-pair",
      "type": "mirrored_pair",
      "item": "left_handle",
      "anchor": "right_handle",
      "image_view": "front",
      "min_confidence": 0.55,
      "spacing_ratio_tolerance": 0.2,
      "model_tolerance": 0.08
    }
  ],
  "footprint_rules": [
    {
      "id": "left-handle-footprint",
      "item": "left_handle",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_contour_segmentation",
      "center_tolerance": 0.04,
      "extent_tolerance": [0.13, 0.03],
      "area_tolerance": 0.45
    },
    {
      "id": "right-handle-footprint",
      "item": "right_handle",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_contour_segmentation",
      "center_tolerance": 0.04,
      "extent_tolerance": [0.13, 0.03],
      "area_tolerance": 0.45
    },
    {
      "id": "center-grip-footprint",
      "item": "center_grip",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_contour_segmentation",
      "center_tolerance": 0.08,
      "extent_tolerance": [0.14, 0.28],
      "area_tolerance": 1.1
    },
    {
      "id": "screen-footprint",
      "item": "screen",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_contour_segmentation",
      "center_tolerance": 0.08,
      "extent_tolerance": [0.18, 0.49],
      "area_tolerance": 5.0
    },
    {
      "id": "left-thumbstick-footprint",
      "item": "left_thumbstick",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_keypoint_segmentation",
      "center_tolerance": 0.12,
      "extent_tolerance": [0.04, 0.12],
      "area_tolerance": 2.2,
      "edge_direction_tolerance_deg": 90
    },
    {
      "id": "right-thumbstick-footprint",
      "item": "right_thumbstick",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_keypoint_segmentation",
      "center_tolerance": 0.12,
      "extent_tolerance": [0.04, 0.05],
      "area_tolerance": 0.35
    },
    {
      "id": "abxy-footprint",
      "item": "abxy",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_contour_segmentation",
      "center_tolerance": 0.12,
      "extent_tolerance": [0.16, 0.17],
      "area_tolerance": 1.0
    },
    {
      "id": "dpad-footprint",
      "item": "dpad",
      "image_view": "front",
      "image_frame": "controller_frame",
      "require_grounding": "edge_contour_segmentation",
      "center_tolerance": 0.08,
      "extent_tolerance": [0.14, 0.16],
      "area_tolerance": 0.95
    }
  ],
  "negative_cases": [
    {
      "id": "mirror-x-handedness-negative",
      "transform": "mirror_x",
      "rule_ids": [
        "handles-left-right-order",
        "thumbsticks-handedness",
        "face-buttons-right-of-dpad"
      ],
      "min_failed_rules": 2
    }
  ]
}
