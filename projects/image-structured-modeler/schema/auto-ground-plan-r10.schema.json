{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/auto-ground-plan-r10.schema.json",
  "title": "Auto GroundPlan R10",
  "type": "object",
  "required": [
    "kind",
    "version",
    "site_surface",
    "evidence_candidates",
    "resolved_evidence",
    "rejected_priors",
    "canonical_regions",
    "subdivision_cells",
    "gap_completion",
    "qa"
  ],
  "properties": {
    "kind": { "const": "auto_ground_plan_r10" },
    "version": { "const": 10 },
    "coordinate_convention": { "type": "string" },
    "source_image": { "type": ["string", "null"] },
    "site_surface": { "$ref": "#/$defs/site_surface" },
    "evidence_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_candidate" }
    },
    "resolved_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidence_candidate" }
    },
    "rejected_priors": {
      "type": "array",
      "items": { "$ref": "#/$defs/rejected_evidence" }
    },
    "rejected_evidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/rejected_evidence" }
    },
    "canonical_regions": {
      "type": "array",
      "items": { "$ref": "#/$defs/canonical_region" }
    },
    "subdivision_cells": {
      "type": "array",
      "items": { "$ref": "#/$defs/subdivision_cell" }
    },
    "gap_completion": { "$ref": "#/$defs/gap_completion" },
    "parking_grid": { "type": ["object", "null"] },
    "road_corridors": {
      "type": "array",
      "items": { "type": "object" }
    },
    "qa": { "$ref": "#/$defs/qa" }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number" }
    },
    "polygon": {
      "type": "array",
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number" }
      }
    },
    "site_surface": {
      "type": ["object", "null"],
      "required": ["id", "bbox_px", "polygon_px"],
      "properties": {
        "id": { "type": "string" },
        "observation_id": { "type": ["string", "null"] },
        "source_image": { "type": ["string", "null"] },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "polygon_px": { "$ref": "#/$defs/polygon" },
        "grounding_method": { "type": ["string", "null"] },
        "confidence": { "type": "number" },
        "review_required": { "type": "boolean" }
      }
    },
    "evidence_candidate": {
      "type": "object",
      "required": ["id", "class", "source_kind", "bbox_px", "area_px", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "observation_id": { "type": ["string", "null"] },
        "class": { "$ref": "#/$defs/region_class" },
        "source_kind": { "type": "string" },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "polygon_px": { "$ref": "#/$defs/polygon" },
        "canonical_polygon_px": { "$ref": "#/$defs/polygon" },
        "area_px": { "type": "number" },
        "area_ratio": { "type": "number" },
        "grounding_method": { "type": ["string", "null"] },
        "confidence": { "type": "number" },
        "review_required": { "type": "boolean" },
        "source_observation_ids": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "rejected_evidence": {
      "type": "object",
      "required": ["id", "class", "source_kind", "reason", "diagnostic_only"],
      "properties": {
        "id": { "type": "string" },
        "observation_id": { "type": ["string", "null"] },
        "class": { "$ref": "#/$defs/region_class" },
        "source_kind": { "type": "string" },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "source_observation_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "confidence": { "type": "number" },
        "reason": { "type": "string" },
        "metrics": { "type": "object" },
        "diagnostic_only": { "type": "boolean" }
      }
    },
    "canonical_region": {
      "type": "object",
      "required": ["id", "class", "source", "bbox_px", "polygon_px", "area_px", "grounding_decision"],
      "properties": {
        "id": { "type": "string" },
        "class": { "$ref": "#/$defs/region_class" },
        "source": { "type": "string" },
        "source_kind": { "type": "string" },
        "source_observation_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "polygon_px": { "$ref": "#/$defs/polygon" },
        "polygon_source": { "type": "string" },
        "area_px": { "type": "number" },
        "area_ratio": { "type": "number" },
        "confidence": { "type": "number" },
        "review_required": { "type": "boolean" },
        "grounding_decision": { "$ref": "#/$defs/grounding_decision" }
      }
    },
    "subdivision_cell": {
      "type": "object",
      "required": ["id", "class", "bbox_px", "polygon_px", "area_px", "grounding_decision"],
      "properties": {
        "id": { "type": "string" },
        "class": { "$ref": "#/$defs/region_class" },
        "region_id": { "type": ["string", "null"] },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "polygon_px": { "$ref": "#/$defs/polygon" },
        "area_px": { "type": "number" },
        "area_ratio": { "type": "number" },
        "gap_class": { "$ref": "#/$defs/gap_class" },
        "gap_connectivity_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "gap_grounding_decision": { "$ref": "#/$defs/grounding_decision" },
        "confidence": { "type": "number" },
        "review_required": { "type": "boolean" },
        "grounding_decision": { "$ref": "#/$defs/grounding_decision" }
      }
    },
    "gap_completion": {
      "type": "object",
      "required": [
        "completed_regions",
        "remaining_gap_cells",
        "gap_classification_summary",
        "connectivity_graph",
        "residuals",
        "review_required"
      ],
      "properties": {
        "kind": { "const": "gap_completion_solver" },
        "version": { "const": 1 },
        "classes": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap_class" }
        },
        "completed_regions": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap_completed_region" }
        },
        "remaining_gap_cells": {
          "type": "array",
          "items": { "$ref": "#/$defs/gap_cell" }
        },
        "gap_classification_summary": { "type": "object" },
        "connectivity_graph": { "type": "object" },
        "cell_classification_by_id": { "type": "object" },
        "residuals": { "$ref": "#/$defs/gap_residuals" },
        "review_required": { "type": "boolean" }
      }
    },
    "gap_completed_region": {
      "type": "object",
      "required": ["id", "class", "source_cell_ids", "bbox_px", "area_px", "grounding_decision"],
      "properties": {
        "id": { "type": "string" },
        "class": { "$ref": "#/$defs/gap_class" },
        "source": { "const": "gap_completion_solver" },
        "source_cell_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "source_evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "polygon_px": { "$ref": "#/$defs/polygon" },
        "area_px": { "type": "number" },
        "area_ratio": { "type": "number" },
        "connectivity_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_required": { "type": "boolean" },
        "grounding_decision": { "$ref": "#/$defs/grounding_decision" },
        "promotion_allowed": { "type": "boolean" },
        "downgrade_reason": { "type": "string" }
      }
    },
    "gap_cell": {
      "type": "object",
      "required": ["id", "gap_class", "bbox_px", "area_px", "review_required"],
      "properties": {
        "id": { "type": "string" },
        "gap_class": { "$ref": "#/$defs/gap_class" },
        "bbox_px": { "$ref": "#/$defs/bbox" },
        "polygon_px": { "$ref": "#/$defs/polygon" },
        "area_px": { "type": "number" },
        "area_ratio": { "type": "number" },
        "source_evidence_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "connectivity_reasons": {
          "type": "array",
          "items": { "type": "string" }
        },
        "review_required": { "type": "boolean" },
        "downgrade_reason": { "type": "string" }
      }
    },
    "gap_residuals": {
      "type": "object",
      "required": [
        "original_gap_ratio",
        "gap_completion_ratio",
        "remaining_unknown_gap_ratio",
        "gap_derived_road_overlap_ratio",
        "gap_derived_region_without_connectivity",
        "open_paved_area_ratio",
        "road_candidate_review_count"
      ],
      "properties": {
        "original_gap_ratio": { "type": "number" },
        "gap_completion_ratio": { "type": "number" },
        "remaining_gap_ratio": { "type": "number" },
        "remaining_unknown_gap_ratio": { "type": "number" },
        "gap_derived_road_overlap_ratio": { "type": "number" },
        "gap_derived_region_without_connectivity": { "type": "integer" },
        "open_paved_area_ratio": { "type": "number" },
        "road_candidate_review_count": { "type": "integer" }
      }
    },
    "qa": {
      "type": "object",
      "required": [
        "ok",
        "verdict",
        "road_building_overlap_ratio",
        "raw_contour_leakage",
        "canonical_region_overlap_ratio",
        "gap_ratio",
        "gap_completion_ratio",
        "remaining_unknown_gap_ratio"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "verdict": { "enum": ["pass", "review", "fail"] },
        "hard_fail": { "type": "boolean" },
        "review_required": { "type": "boolean" },
        "road_building_overlap_ratio": { "type": "number" },
        "parent_child_double_occupancy": { "type": "integer" },
        "raw_contour_leakage": { "type": "integer" },
        "layout_prior_conflict_count": { "type": "integer" },
        "canonical_region_overlap_ratio": { "type": "number" },
        "gap_ratio": { "type": "number" },
        "gap_completion_ratio": { "type": "number" },
        "remaining_unknown_gap_ratio": { "type": "number" },
        "gap_derived_road_overlap_ratio": { "type": "number" },
        "gap_derived_region_without_connectivity": { "type": "integer" },
        "open_paved_area_ratio": { "type": "number" },
        "road_candidate_review_count": { "type": "integer" },
        "region_without_evidence": { "type": "integer" },
        "reasons": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "region_class": {
      "enum": [
        "building_footprint",
        "road",
        "parking",
        "green",
        "walkway",
        "service_yard",
        "gap"
      ]
    },
    "gap_class": {
      "enum": [
        "open_paved_area",
        "road_candidate",
        "walkway_candidate",
        "service_yard_candidate",
        "vegetation_gap",
        "true_gap",
        "unknown_gap"
      ]
    },
    "grounding_decision": {
      "enum": ["promoted_geometry", "review_candidate", "helper_only", "rejected"]
    }
  }
}
