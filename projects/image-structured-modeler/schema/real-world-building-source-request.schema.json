{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/real-world-building-source-request.schema.json",
  "title": "RealWorldBuildingSourceRequest",
  "type": "object",
  "required": [
    "version",
    "kind",
    "status",
    "purpose",
    "accepted_asset_types",
    "blocked_until_satisfied",
    "semantic_evidence_quality",
    "source_asset_requirements",
    "view_requirements",
    "view_source_requirements",
    "scale_requirement",
    "semantic_requirements",
    "upload_package_requirements",
    "upload_manifest_recommendation"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "real_world_building_source_request" },
    "status": {
      "enum": [
        "needs_source_replacement",
        "needs_views_or_scale",
        "needs_semantic_confirmation",
        "input_ready_for_release_work",
        "release_ready"
      ]
    },
    "purpose": { "type": "string", "minLength": 1 },
    "accepted_asset_types": {
      "type": "array",
      "minItems": 1,
      "items": { "enum": ["image", "pdf", "cad"] }
    },
    "blocked_until_satisfied": {
      "type": "array",
      "items": {
        "enum": [
          "direct_sketchup_dsl",
          "promoted_part_graph_geometry",
          "formal_release_manifest"
        ]
      }
    },
    "semantic_evidence_quality": {
      "$ref": "#/$defs/semanticEvidenceQuality",
      "description": "Current semantic evidence quality gate inherited from the source-package assessment."
    },
    "source_asset_requirements": {
      "type": "object",
      "required": [
        "status",
        "needs_replacement_assets",
        "needs_supported_assets",
        "needs_distinct_assets",
        "requests"
      ],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "needs_replacement_assets": { "type": "boolean" },
        "needs_supported_assets": { "type": "boolean" },
        "needs_distinct_assets": { "type": "boolean" },
        "requests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "view_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["view", "required", "status", "request", "acceptable_sources"],
        "properties": {
          "view": { "enum": ["front", "rear", "left", "right", "top", "oblique"] },
          "required": { "type": "boolean" },
          "status": { "enum": ["present", "missing"] },
          "request": { "type": "string", "minLength": 1 },
          "acceptable_sources": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "view_source_requirements": {
      "type": "object",
      "required": [
        "distinct_source_images_required",
        "required_views",
        "source_image_field",
        "blocker",
        "rules"
      ],
      "properties": {
        "distinct_source_images_required": { "type": "boolean" },
        "required_views": {
          "type": "array",
          "items": { "enum": ["front", "rear", "left", "right", "top", "oblique"] }
        },
        "source_image_field": { "const": "views[].source_image" },
        "blocker": { "const": "view_sources_not_distinct" },
        "rules": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "scale_requirement": {
      "type": "object",
      "required": [
        "status",
        "current_confidence",
        "minimum_confidence",
        "blockers",
        "acceptable_evidence"
      ],
      "properties": {
        "status": { "enum": ["pass", "fail"] },
        "current_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "blockers": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptable_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "semantic_requirements": {
      "type": "object",
      "required": ["status", "missing_roles", "requests", "evidence_quality"],
      "properties": {
        "status": { "enum": ["pass", "fail", "review"] },
        "missing_roles": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "requests": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_quality": { "$ref": "#/$defs/semanticEvidenceQuality" }
      }
    },
    "upload_package_requirements": {
      "type": "object",
      "required": [
        "manifest_required",
        "manifest_file_names",
        "accepted_asset_types",
        "source_asset_policy",
        "required_view_slots",
        "missing_required_views",
        "view_source_policy",
        "scale_evidence",
        "semantic_evidence",
        "next_upload_response_check_ids",
        "forbidden_shortcuts"
      ],
      "properties": {
        "manifest_required": { "type": "boolean" },
        "manifest_file_names": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "accepted_asset_types": {
          "type": "array",
          "items": { "enum": ["image", "pdf", "cad"] }
        },
        "source_asset_policy": {
          "type": "object",
          "required": [
            "replacement_required",
            "supported_assets_required",
            "distinct_assets_required",
            "content_hash_distinct_required",
            "forbidden_source_kinds"
          ],
          "properties": {
            "replacement_required": { "type": "boolean" },
            "supported_assets_required": { "type": "boolean" },
            "distinct_assets_required": { "type": "boolean" },
            "content_hash_distinct_required": { "type": "boolean" },
            "forbidden_source_kinds": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "required_view_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "view",
              "status",
              "required",
              "source_image_required",
              "distinct_source_image_required",
              "source_image_field",
              "request",
              "acceptable_sources"
            ],
            "properties": {
              "view": { "enum": ["front", "rear", "left", "right", "top", "oblique"] },
              "status": { "enum": ["present", "missing"] },
              "required": { "type": "boolean" },
              "source_image_required": { "type": "boolean" },
              "distinct_source_image_required": { "type": "boolean" },
              "source_image_field": { "const": "views[].source_image" },
              "request": { "type": "string", "minLength": 1 },
              "acceptable_sources": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "missing_required_views": {
          "type": "array",
          "items": { "enum": ["front", "rear", "left", "right", "top", "oblique"] }
        },
        "view_source_policy": { "type": "object" },
        "scale_evidence": {
          "type": "object",
          "required": [
            "required",
            "status",
            "current_confidence",
            "minimum_confidence",
            "manifest_fields",
            "acceptable_evidence"
          ],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["pass", "fail"] },
            "current_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "minimum_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "manifest_fields": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "acceptable_evidence": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "semantic_evidence": {
          "type": "object",
          "required": ["required", "status", "evidence_quality", "missing_roles", "requests"],
          "properties": {
            "required": { "type": "boolean" },
            "status": { "enum": ["pass", "fail", "review"] },
            "evidence_quality": { "$ref": "#/$defs/semanticEvidenceQuality" },
            "missing_roles": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            },
            "requests": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 }
            }
          }
        },
        "next_upload_response_check_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "forbidden_shortcuts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "upload_manifest_recommendation": {
      "type": "object",
      "required": ["include_manifest", "template_kind", "recommended_fields", "note"],
      "properties": {
        "include_manifest": { "type": "boolean" },
        "template_kind": { "const": "real_world_building_upload_manifest" },
        "recommended_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "note": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "checkIdList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "semanticEvidenceQuality": {
      "type": "object",
      "required": [
        "status",
        "required_role_count",
        "covered_role_count",
        "missing_role_count",
        "weak_role_count",
        "review_required_role_count",
        "geometry_promotion_allowed",
        "weak_roles",
        "review_required_roles",
        "flags"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "missing",
            "weak_review_required",
            "review_required"
          ]
        },
        "required_role_count": { "type": "integer", "minimum": 0 },
        "covered_role_count": { "type": "integer", "minimum": 0 },
        "missing_role_count": { "type": "integer", "minimum": 0 },
        "weak_role_count": { "type": "integer", "minimum": 0 },
        "review_required_role_count": { "type": "integer", "minimum": 0 },
        "geometry_promotion_allowed": { "const": false },
        "weak_roles": { "$ref": "#/$defs/checkIdList" },
        "review_required_roles": { "$ref": "#/$defs/checkIdList" },
        "flags": { "$ref": "#/$defs/checkIdList" }
      }
    }
  }
}
