{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/axis-calibration-review-decision.schema.json",
  "title": "AxisCalibrationReviewDecision v1",
  "type": "object",
  "required": [
    "kind",
    "version",
    "source_axis_calibration_workbench",
    "reviewer",
    "status",
    "accepted_projection_model",
    "line_decisions",
    "promotion_allowed",
    "compile_allowed",
    "blockers",
    "notes"
  ],
  "properties": {
    "kind": { "const": "axis_calibration_review_decision_v1" },
    "version": { "const": 1 },
    "source_axis_calibration_workbench": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted_for_calibration"] },
    "accepted_projection_model": {
      "type": ["string", "null"],
      "enum": [
        "perspective_3vp",
        "two_point_vertical_parallel",
        "shifted_lens_off_axis",
        "post_rectified_unknown",
        "orthographic_or_near_orthographic",
        "bird_eye_site",
        null
      ]
    },
    "line_decisions": {
      "type": "array",
      "items": { "$ref": "#/$defs/line_decision" }
    },
    "origin_candidate_id": { "type": ["string", "null"] },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "line_decision": {
      "type": "object",
      "required": ["line_candidate_id", "decision", "assigned_axis", "reviewer_confidence"],
      "properties": {
        "line_candidate_id": { "type": "string" },
        "decision": { "enum": ["axis_unknown", "assign_axis", "reject"] },
        "assigned_axis": { "type": ["string", "null"], "enum": ["x_red", "y_green", "z_blue", null] },
        "reviewer_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "reason": { "type": "string" }
      }
    }
  }
}
