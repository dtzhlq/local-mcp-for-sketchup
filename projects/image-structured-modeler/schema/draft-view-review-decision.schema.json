{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/draft-view-review-decision.schema.json",
  "title": "DraftViewReviewDecision v1",
  "type": "object",
  "required": ["kind", "version", "source_draft_view_graph", "reviewer", "status", "promotion_allowed", "compile_allowed", "accepted_view_slot_ids", "rejected_view_slot_ids", "corrected_axes", "accepted_plane_hypothesis_ids", "blockers", "notes"],
  "properties": {
    "kind": { "const": "draft_view_review_decision_v1" },
    "version": { "const": 1 },
    "source_draft_view_graph": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted", "partial", "rejected"] },
    "promotion_allowed": { "type": "boolean" },
    "compile_allowed": { "const": false },
    "accepted_view_slot_ids": { "type": "array", "items": { "enum": ["front", "left_or_right_side", "top", "oblique_context"] } },
    "rejected_view_slot_ids": { "type": "array", "items": { "type": "string" } },
    "corrected_axes": { "type": "array", "items": { "type": "object" } },
    "accepted_plane_hypothesis_ids": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
