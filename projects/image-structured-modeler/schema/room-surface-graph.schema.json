{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/room-surface-graph.schema.json",
  "title": "RoomSurfaceGraph v1",
  "type": "object",
  "required": ["kind", "version", "profile_id", "coordinate_convention", "coordinate_reference", "source_calibration_review_result", "surfaces", "surface_local_detail_candidates", "review_policy", "summary"],
  "properties": {
    "kind": { "const": "room_surface_graph_v1" },
    "version": { "const": 1 },
    "profile_id": { "type": "string" },
    "coordinate_convention": { "const": "image_x_right_y_down_room_local_axes_reviewed" },
    "coordinate_reference": {
      "type": "object",
      "required": ["source_image", "width", "height"],
      "properties": {
        "source_image": { "type": "string" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "source_calibration_review_result": { "type": "string" },
    "surfaces": { "type": "array", "items": { "$ref": "#/$defs/surface" } },
    "surface_local_detail_candidates": { "type": "array", "items": { "$ref": "#/$defs/detail" } },
    "review_policy": {
      "type": "object",
      "required": ["status", "accepted_surface_review_required", "review_required", "promotion_allowed", "compile_allowed", "blockers"],
      "properties": {
        "status": { "enum": ["needs_surface_review", "blocked_no_accepted_calibration", "blocked_no_surface_seed"] },
        "accepted_surface_review_required": { "const": true },
        "review_required": { "const": true },
        "promotion_allowed": { "const": false },
        "compile_allowed": { "const": false },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["surface_count", "detail_candidate_count", "visible_surface_ids", "review_required", "promotion_allowed", "compile_allowed"],
      "properties": {
        "surface_count": { "type": "integer", "minimum": 0 },
        "detail_candidate_count": { "type": "integer", "minimum": 0 },
        "visible_surface_ids": { "type": "array", "items": { "type": "string" } },
        "review_required": { "const": true },
        "promotion_allowed": { "const": false },
        "compile_allowed": { "const": false }
      }
    }
  },
  "$defs": {
    "point": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
    "quad": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/point" } },
    "surface": {
      "type": "object",
      "required": ["id", "role", "source_image", "status", "visible_polygon_px", "rectification_quad_px", "visible_quad_px", "orientation_hint", "adjacency", "occlusion_order", "must_not_merge_with", "source", "review_required", "promotion_allowed"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "source_image": { "type": "string" },
        "status": { "enum": ["observed", "partial"] },
        "visible_polygon_px": { "type": "array", "minItems": 4, "items": { "$ref": "#/$defs/point" } },
        "rectification_quad_px": { "$ref": "#/$defs/quad" },
        "visible_quad_px": { "$ref": "#/$defs/quad" },
        "orientation_hint": {
          "type": "object",
          "required": ["kind", "orientation_axis", "normal_hint", "projection_model", "confidence", "review_required"],
          "properties": {
            "kind": { "const": "accepted_axis_calibrated_room_surface_candidate" },
            "orientation_axis": { "enum": ["room_depth_axis", "room_width_axis", "room_vertical_axis"] },
            "normal_hint": { "type": "string" },
            "projection_model": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "review_required": { "const": true }
          }
        },
        "adjacency": { "type": "array", "items": { "$ref": "#/$defs/adjacency" } },
        "occlusion_order": {
          "type": "object",
          "required": ["rank", "relation_to_camera", "evidence", "review_required"],
          "properties": {
            "rank": { "type": "integer", "minimum": 1 },
            "relation_to_camera": { "enum": ["bounds_view_volume", "far_terminating_surface", "partially_occluded"] },
            "evidence": { "type": "string" },
            "review_required": { "const": true }
          }
        },
        "must_not_merge_with": { "type": "array", "items": { "type": "string" } },
        "source": {
          "type": "object",
          "required": ["kind", "source_seed_id", "confidence", "derived_from"],
          "properties": {
            "kind": { "enum": ["manual_review_seed", "reviewed_detector_proposal"] },
            "source_seed_id": { "type": "string" },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "derived_from": { "type": "array", "items": { "type": "string" } }
          }
        },
        "review_required": { "const": true },
        "promotion_allowed": { "const": false }
      }
    },
    "adjacency": {
      "type": "object",
      "required": ["surface_id", "relation", "evidence", "review_required"],
      "properties": {
        "surface_id": { "type": "string" },
        "relation": { "const": "shares_reviewed_room_boundary" },
        "evidence": { "type": "string" },
        "review_required": { "const": true }
      }
    },
    "detail": {
      "type": "object",
      "required": ["id", "role", "source_image", "candidate_surface_ids", "visible_quad_px", "geometry_type", "source", "review_required", "promotion_allowed", "blockers"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "source_image": { "type": "string" },
        "candidate_surface_ids": { "type": "array", "items": { "type": "string" } },
        "visible_quad_px": { "$ref": "#/$defs/quad" },
        "geometry_type": { "enum": ["surface_panel", "surface_fixture", "recess_opening"] },
        "source": { "type": "object" },
        "review_required": { "const": true },
        "promotion_allowed": { "const": false },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
