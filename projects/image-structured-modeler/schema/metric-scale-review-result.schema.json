{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/metric-scale-review-result.schema.json",
  "title": "MetricScaleReviewResult v1",
  "type": "object",
  "required": ["kind", "version", "status", "accepted_anchor_ids", "units", "units_per_model_unit", "metric_scale_allowed", "source_relative_pose_edge_ids", "source_geometry_scope", "promotion_allowed", "compile_allowed", "false_promotion_count", "blockers"],
  "properties": {
    "kind": { "const": "metric_scale_review_result_v1" },
    "version": { "const": 1 },
    "status": { "enum": ["blocked_no_accepted_review", "blocked_invalid_review", "accepted_metric_scale"] },
    "accepted_anchor_ids": { "type": "array", "items": { "type": "string" } },
    "units": { "type": ["string", "null"] },
    "units_per_model_unit": { "type": ["number", "null"] },
    "metric_scale_allowed": { "type": "boolean" },
    "source_relative_pose_edge_ids": { "type": "array", "items": { "type": "string" } },
    "source_geometry_scope": { "enum": ["unresolved", "single_plane", "object_frame"] },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "false_promotion_count": { "const": 0 },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
