{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/multi-view-calibration-review-decision.schema.json",
  "title": "MultiViewCalibrationReviewDecision v1",
  "type": "object",
  "required": ["kind", "version", "source_multi_view_calibration_graph", "reviewer", "status", "accepted_view_ids", "accepted_correspondence_ids", "promotion_allowed", "compile_allowed", "notes"],
  "properties": {
    "kind": { "const": "multi_view_calibration_review_decision_v1" },
    "version": { "const": 1 },
    "source_multi_view_calibration_graph": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted_for_evidence_fusion"] },
    "accepted_view_ids": { "type": "array", "items": { "type": "string" } },
    "accepted_correspondence_ids": { "type": "array", "items": { "type": "string" } },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
