{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/image-set-observation.schema.json",
  "title": "Image Set Observation",
  "type": "object",
  "required": ["version", "object", "images", "views_detected", "missing_views", "quality_report"],
  "properties": {
    "version": { "const": 1 },
    "object": {
      "type": "object",
      "required": ["type", "name", "source_images"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "profile": { "enum": ["switch_controller", "compact_remote", "vehicle_ambulance", "building_group"] },
        "source_images": { "type": "array", "items": { "type": "string" } }
      }
    },
    "image_set_quality": { "enum": ["low", "medium", "high"] },
    "views_detected": {
      "type": "array",
      "items": { "enum": ["front", "rear", "left", "right", "top", "bottom", "oblique", "detail", "unknown"] }
    },
    "missing_views": { "type": "array", "items": { "type": "string" } },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image_observation" }
    },
    "scale_calibration": { "$ref": "#/$defs/scale_calibration" },
    "evidence_graph": { "$ref": "#/$defs/evidence_graph" },
    "quality_report": {
      "type": "object",
      "required": ["usable_for_modeling", "risks"],
      "properties": {
        "usable_for_modeling": { "type": "boolean" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "overlay_dir": { "type": ["string", "null"] },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "image_observation": {
      "type": "object",
      "required": ["version", "image", "detected_view", "observations"],
      "properties": {
        "version": { "const": 1 },
        "image": {
          "type": "object",
          "required": ["path", "width", "height"],
          "properties": {
            "path": { "type": "string" },
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "analysis_width": { "type": "integer" },
            "analysis_height": { "type": "integer" }
          }
        },
        "detected_view": {
          "type": "object",
          "required": ["kind", "confidence"],
          "properties": {
            "kind": { "enum": ["front", "rear", "left", "right", "top", "bottom", "oblique", "detail", "unknown"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "camera_hints": {
          "type": "object",
          "properties": {
            "perspective_strength": { "enum": ["low", "medium", "high", "unknown"] },
            "symmetry_axis": { "$ref": "#/$defs/line2" }
          }
        },
        "orientation_hints": { "$ref": "#/$defs/orientation_hints" },
        "metrics": {
          "type": "object",
          "properties": {
            "edge_count": { "type": "integer" },
            "edge_density": { "type": "number" },
            "object_bbox": { "$ref": "#/$defs/bbox" },
            "object_bbox_ratio": { "type": "number" },
            "symmetry_score": { "type": "number" }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["silhouette", "component_bbox", "center_point", "keypoint", "edge", "curve", "color_region", "text_or_logo", "uncertain"] },
              "component_hint": { "type": "string" },
              "bbox": { "$ref": "#/$defs/bbox" },
              "points": { "$ref": "#/$defs/polyline2" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "quality_report": {
          "type": "object",
          "properties": {
            "usable_for_modeling": { "type": "boolean" },
            "risks": { "type": "array", "items": { "type": "string" } },
            "missing_views": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "polyline2": {
      "type": "array",
      "items": { "$ref": "#/$defs/point2" }
    },
    "line2": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/point2" },
        "b": { "$ref": "#/$defs/point2" }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 4,
      "maxItems": 4
    },
    "orientation_hints": {
      "type": "object",
      "required": ["coordinate_convention", "mirror_risk", "semantic_anchors", "review_required"],
      "properties": {
        "coordinate_convention": { "const": "image_x_right_y_down" },
        "model_convention": { "type": "string" },
        "mirror_risk": {
          "type": "object",
          "required": ["status", "confidence", "reasons"],
          "properties": {
            "status": { "enum": ["low", "medium", "high", "unknown"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "reasons": { "type": "array", "items": { "type": "string" } }
          }
        },
        "semantic_anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "item", "anchor", "direction", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "item": { "type": "string" },
              "anchor": { "type": "string" },
              "direction": { "enum": ["left_of", "right_of", "above", "below"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "review_required": { "type": "boolean" }
      }
    },
    "evidence_status": {
      "enum": ["observed", "inferred", "template_prior", "manual_confirmed"]
    },
    "evidence_graph": {
      "type": "object",
      "required": ["version", "image_count", "parts", "open_questions"],
      "properties": {
        "version": { "const": 1 },
        "image_count": { "type": "integer" },
        "views_detected": { "type": "array", "items": { "type": "string" } },
        "missing_views": { "type": "array", "items": { "type": "string" } },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_graph_part" }
        },
        "part_matches": {
          "type": "array",
          "items": { "$ref": "#/$defs/part_match" }
        },
        "scale_calibration": { "$ref": "#/$defs/scale_calibration" },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_graph_part": {
      "type": "object",
      "required": ["part_id", "status", "required_views", "confirmed_views", "missing_views", "sources", "open_questions"],
      "properties": {
        "part_id": { "type": "string" },
        "status": { "$ref": "#/$defs/evidence_status" },
        "template_prior": { "type": "boolean" },
        "manual_confirmed": { "type": "boolean" },
        "required_views": { "type": "array", "items": { "type": "string" } },
        "confirmed_views": { "type": "array", "items": { "type": "string" } },
        "missing_views": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_graph_source" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_graph_conflict" }
        },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "part_match": {
      "type": "object",
      "required": ["part_id", "strategy", "matched_views", "missing_views", "source_count", "confidence"],
      "properties": {
        "part_id": { "type": "string" },
        "strategy": { "type": "string" },
        "matched_views": { "type": "array", "items": { "type": "string" } },
        "missing_views": { "type": "array", "items": { "type": "string" } },
        "source_count": { "type": "integer" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "scale_calibration": {
      "type": "object",
      "required": ["units", "strategy", "default_scale", "measurements", "confidence", "missing_views"],
      "properties": {
        "units": { "const": "mm" },
        "strategy": { "type": "string" },
        "default_scale": {
          "type": "object",
          "properties": {
            "width": { "type": "number" },
            "depth": { "type": "number" },
            "height": { "type": "number" }
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["view", "source_image", "object_bbox", "confidence"],
            "properties": {
              "view": { "type": "string" },
              "source_image": { "type": "string" },
              "observation_id": { "type": "string" },
              "anchor_type": { "type": "string" },
              "object_bbox": { "$ref": "#/$defs/bbox" },
              "physical_width_mm": { "type": "number" },
              "physical_height_mm": { "type": "number" },
              "pixels_per_mm_x": { "type": "number" },
              "pixels_per_mm_y": { "type": "number" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "basis": { "type": "array", "items": { "type": "string" } },
              "review_required": { "type": "boolean" },
              "note": { "type": "string" }
            }
          }
        },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "missing_views": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_graph_source": {
      "type": "object",
      "required": ["view", "kind", "status"],
      "properties": {
        "view": { "type": "string" },
        "view_kind": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "$ref": "#/$defs/evidence_status" },
        "source_image": { "type": "string" },
        "observation_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      }
    },
    "evidence_graph_conflict": {
      "type": "object",
      "required": ["type", "severity", "note"],
      "properties": {
        "type": { "type": "string" },
        "severity": { "enum": ["info", "warn", "error"] },
        "views": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    }
  }
}
