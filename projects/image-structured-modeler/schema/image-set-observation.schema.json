{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/image-set-observation.schema.json",
  "title": "Image Set Observation",
  "type": "object",
  "required": ["version", "object", "images", "views_detected", "missing_views", "quality_report"],
  "properties": {
    "version": { "const": 1 },
    "object": {
      "type": "object",
      "required": ["type", "name", "source_images"],
      "properties": {
        "type": { "type": "string" },
        "name": { "type": "string" },
        "profile": { "enum": ["switch_controller", "compact_remote"] },
        "source_images": { "type": "array", "items": { "type": "string" } }
      }
    },
    "image_set_quality": { "enum": ["low", "medium", "high"] },
    "views_detected": {
      "type": "array",
      "items": { "enum": ["front", "rear", "left", "right", "top", "bottom", "oblique", "detail", "unknown"] }
    },
    "missing_views": { "type": "array", "items": { "type": "string" } },
    "images": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/image_observation" }
    },
    "evidence_graph": { "$ref": "#/$defs/evidence_graph" },
    "quality_report": {
      "type": "object",
      "required": ["usable_for_modeling", "risks"],
      "properties": {
        "usable_for_modeling": { "type": "boolean" },
        "risks": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "overlay_dir": { "type": ["string", "null"] },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "image_observation": {
      "type": "object",
      "required": ["version", "image", "detected_view", "observations"],
      "properties": {
        "version": { "const": 1 },
        "image": {
          "type": "object",
          "required": ["path", "width", "height"],
          "properties": {
            "path": { "type": "string" },
            "width": { "type": "integer" },
            "height": { "type": "integer" },
            "analysis_width": { "type": "integer" },
            "analysis_height": { "type": "integer" }
          }
        },
        "detected_view": {
          "type": "object",
          "required": ["kind", "confidence"],
          "properties": {
            "kind": { "enum": ["front", "rear", "left", "right", "top", "bottom", "oblique", "detail", "unknown"] },
            "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
            "notes": { "type": "array", "items": { "type": "string" } }
          }
        },
        "camera_hints": {
          "type": "object",
          "properties": {
            "perspective_strength": { "enum": ["low", "medium", "high", "unknown"] },
            "symmetry_axis": { "$ref": "#/$defs/line2" }
          }
        },
        "metrics": {
          "type": "object",
          "properties": {
            "edge_count": { "type": "integer" },
            "edge_density": { "type": "number" },
            "object_bbox": { "$ref": "#/$defs/bbox" },
            "object_bbox_ratio": { "type": "number" },
            "symmetry_score": { "type": "number" }
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "kind", "confidence"],
            "properties": {
              "id": { "type": "string" },
              "kind": { "enum": ["silhouette", "component_bbox", "center_point", "edge", "curve", "color_region", "text_or_logo", "uncertain"] },
              "component_hint": { "type": "string" },
              "bbox": { "$ref": "#/$defs/bbox" },
              "points": { "$ref": "#/$defs/polyline2" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "note": { "type": "string" }
            }
          }
        },
        "quality_report": {
          "type": "object",
          "properties": {
            "usable_for_modeling": { "type": "boolean" },
            "risks": { "type": "array", "items": { "type": "string" } },
            "missing_views": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "polyline2": {
      "type": "array",
      "items": { "$ref": "#/$defs/point2" }
    },
    "line2": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/point2" },
        "b": { "$ref": "#/$defs/point2" }
      }
    },
    "bbox": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }, { "type": "number" }, { "type": "number" }],
      "minItems": 4,
      "maxItems": 4
    },
    "evidence_status": {
      "enum": ["observed", "inferred", "template_prior", "manual_confirmed"]
    },
    "evidence_graph": {
      "type": "object",
      "required": ["version", "image_count", "parts", "open_questions"],
      "properties": {
        "version": { "const": 1 },
        "image_count": { "type": "integer" },
        "views_detected": { "type": "array", "items": { "type": "string" } },
        "missing_views": { "type": "array", "items": { "type": "string" } },
        "parts": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_graph_part" }
        },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_graph_part": {
      "type": "object",
      "required": ["part_id", "status", "required_views", "confirmed_views", "missing_views", "sources", "open_questions"],
      "properties": {
        "part_id": { "type": "string" },
        "status": { "$ref": "#/$defs/evidence_status" },
        "template_prior": { "type": "boolean" },
        "manual_confirmed": { "type": "boolean" },
        "required_views": { "type": "array", "items": { "type": "string" } },
        "confirmed_views": { "type": "array", "items": { "type": "string" } },
        "missing_views": { "type": "array", "items": { "type": "string" } },
        "sources": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_graph_source" }
        },
        "conflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidence_graph_conflict" }
        },
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_graph_source": {
      "type": "object",
      "required": ["view", "kind", "status"],
      "properties": {
        "view": { "type": "string" },
        "view_kind": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "$ref": "#/$defs/evidence_status" },
        "source_image": { "type": "string" },
        "observation_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      }
    },
    "evidence_graph_conflict": {
      "type": "object",
      "required": ["type", "severity", "note"],
      "properties": {
        "type": { "type": "string" },
        "severity": { "enum": ["info", "warn", "error"] },
        "views": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string" }
      }
    }
  }
}
