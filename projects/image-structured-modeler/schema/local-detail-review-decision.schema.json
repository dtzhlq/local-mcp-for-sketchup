{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/local-detail-review-decision.schema.json",
  "title": "LocalDetailReviewDecision v1",
  "type": "object",
  "required": ["kind", "version", "reviewer", "status", "promotion_allowed", "compile_allowed", "accepted_surface_ids", "accepted_detail_ids", "detail_bindings", "blockers", "notes"],
  "properties": {
    "kind": { "const": "local_detail_review_decision_v1" },
    "version": { "const": 1 },
    "source_object_surface_graph": { "type": ["string", "null"] },
    "source_facade_plane_graph": { "type": ["string", "null"] },
    "source_room_surface_graph": { "type": ["string", "null"] },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted", "partial", "rejected"] },
    "promotion_allowed": { "type": "boolean" },
    "compile_allowed": { "const": false },
    "accepted_surface_ids": { "type": "array", "items": { "type": "string" } },
    "accepted_detail_ids": { "type": "array", "items": { "type": "string" } },
    "detail_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["detail_id", "status"],
        "properties": {
          "detail_id": { "type": "string" },
          "target_surface_id": { "type": ["string", "null"] },
          "target_plane_id": { "type": ["string", "null"] },
          "target_part_id": { "type": ["string", "null"] },
          "status": { "type": "string" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
