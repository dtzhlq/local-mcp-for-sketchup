    "kind": { "const": "object_surface_study_sample_v1" },
    "version": { "const": 1 },
    "sample_id": { "type": "string" },
    "domain": { "type": "string" },
    "observations": { "type": "string" },
    "seed_part_graph": { "type": "string" },
    "profile": { "type": "string" },
    "draft_view_review": { "type": "string" },
    "surface_review": { "type": "string" },
    "local_detail_review": { "type": "string" },
    "acceptance": { "type": "object" },
    "notes": { "type": "array", "items": { "type": "string" } }
