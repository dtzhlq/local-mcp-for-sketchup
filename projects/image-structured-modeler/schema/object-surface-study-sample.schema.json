{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/object-surface-study-sample.schema.json",
  "title": "ObjectSurfaceStudySample v1",
  "type": "object",
  "required": ["kind", "version", "sample_id", "domain", "observations", "seed_part_graph", "profile", "draft_view_review", "surface_review", "local_detail_review", "acceptance", "notes"],
