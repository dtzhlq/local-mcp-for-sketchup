{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/hidden-geometry-review-decision.schema.json",
  "title": "HiddenGeometryReviewDecision v1",
  "type": "object",
  "required": ["kind", "version", "source_multi_view_calibration_graph", "reviewer", "status", "required_hidden_roles", "accepted_hidden_surfaces", "promotion_allowed", "compile_allowed", "notes"],
  "properties": {
    "kind": { "const": "hidden_geometry_review_decision_v1" },
    "version": { "const": 1 },
    "source_multi_view_calibration_graph": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted_hidden_geometry"] },
    "required_hidden_roles": { "type": "array", "items": { "type": "string" } },
    "accepted_hidden_surfaces": { "type": "array", "items": { "$ref": "#/$defs/hidden_surface" } },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hidden_surface": {
      "type": "object",
      "required": ["id", "role", "evidence_kind", "source_view_ids", "source_evidence_ids", "geometry_descriptor", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "role": { "type": "string" },
        "evidence_kind": { "enum": ["cross_view_observed", "measured_document", "explicit_user_assumption"] },
        "source_view_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "source_evidence_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "geometry_descriptor": { "type": "object" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
