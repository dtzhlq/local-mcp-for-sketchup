{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/axis-calibration-workbench.schema.json",
  "title": "AxisCalibrationWorkbench v1",
  "type": "object",
  "required": [
    "kind",
    "version",
    "profile_id",
    "source_image",
    "source_structure_evidence_graph",
    "projection_model_candidates",
    "line_candidates",
    "quality_policy",
    "review_policy",
    "summary"
  ],
  "properties": {
    "kind": { "const": "axis_calibration_workbench_v1" },
    "version": { "const": 1 },
    "profile_id": { "type": "string" },
    "source_image": { "$ref": "#/$defs/source_image" },
    "source_structure_evidence_graph": { "type": "string" },
    "projection_model_candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "perspective_3vp",
          "two_point_vertical_parallel",
          "shifted_lens_off_axis",
          "post_rectified_unknown",
          "orthographic_or_near_orthographic",
          "bird_eye_site"
        ]
      }
    },
    "line_candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/line_candidate" }
    },
    "origin_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/origin_candidate" }
    },
    "quality_policy": {
      "type": "object",
      "required": ["min_lines_per_axis", "min_finite_axis_families", "vertical_parallel_allowed", "required_before_topology"],
      "properties": {
        "min_lines_per_axis": {
          "type": "object",
          "required": ["x_red", "y_green", "z_blue"],
          "properties": {
            "x_red": { "type": "integer", "minimum": 1 },
            "y_green": { "type": "integer", "minimum": 1 },
            "z_blue": { "type": "integer", "minimum": 1 }
          }
        },
        "min_finite_axis_families": { "type": "integer", "minimum": 0 },
        "vertical_parallel_allowed": { "type": "boolean" },
        "required_before_topology": { "const": true }
      }
    },
    "review_policy": {
      "type": "object",
      "required": ["status", "accepted_axis_review_required", "review_required", "derived_drafting_allowed", "promotion_allowed", "compile_allowed", "blockers"],
      "properties": {
        "status": { "enum": ["needs_axis_review", "blocked_no_line_candidates"] },
        "accepted_axis_review_required": { "const": true },
        "review_required": { "const": true },
        "derived_drafting_allowed": { "const": false },
        "promotion_allowed": { "const": false },
        "compile_allowed": { "const": false },
        "blockers": { "type": "array", "items": { "type": "string" } }
      }
    },
    "summary": {
      "type": "object",
      "required": ["line_candidate_count", "accepted_line_count", "review_required", "derived_drafting_allowed", "promotion_allowed", "compile_allowed"],
      "properties": {
        "line_candidate_count": { "type": "integer", "minimum": 0 },
        "accepted_line_count": { "const": 0 },
        "review_required": { "const": true },
        "derived_drafting_allowed": { "const": false },
        "promotion_allowed": { "const": false },
        "compile_allowed": { "const": false }
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "line": {
      "type": "object",
      "required": ["a", "b"],
      "properties": {
        "a": { "$ref": "#/$defs/point" },
        "b": { "$ref": "#/$defs/point" }
      }
    },
    "source_image": {
      "type": "object",
      "required": ["id", "source_image", "width", "height"],
      "properties": {
        "id": { "type": "string" },
        "source_image": { "type": "string" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "line_candidate": {
      "type": "object",
      "required": [
        "id",
        "source_image",
        "line_px",
        "axis_assignment",
        "allowed_axes",
        "source_kind",
        "confidence",
        "review_required",
        "promotion_allowed"
      ],
      "properties": {
        "id": { "type": "string" },
        "source_image": { "type": "string" },
        "line_px": { "$ref": "#/$defs/line" },
        "axis_assignment": { "const": "axis_unknown" },
        "allowed_axes": {
          "type": "array",
          "items": { "enum": ["x_red", "y_green", "z_blue", "reject"] }
        },
        "source_kind": { "type": "string" },
        "source_family_hint": { "type": ["string", "null"] },
        "source_evidence_ids": { "type": "array", "items": { "type": "string" } },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "review_required": { "const": true },
        "promotion_allowed": { "const": false },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "origin_candidate": {
      "type": "object",
      "required": ["id", "point_px", "review_required"],
      "properties": {
        "id": { "type": "string" },
        "point_px": { "$ref": "#/$defs/point" },
        "review_required": { "const": true },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
