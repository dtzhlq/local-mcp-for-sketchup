{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/external-benchmark-sample-package.schema.json",
  "title": "ExternalBenchmarkSamplePackage v1",
  "type": "object",
  "required": ["kind", "version", "sample_id", "dataset", "domain", "adapter", "source_url", "license_note", "created_at", "files", "promotion_allowed", "compile_allowed"],
  "properties": {
    "kind": { "const": "external_benchmark_sample_package_v1" },
    "version": { "const": 1 },
    "sample_id": { "type": "string" },
    "dataset": { "type": "string" },
    "domain": { "type": "string" },
    "adapter": { "enum": ["objectnet3d_pose_cad_adapter", "pix3d_image_cad_adapter", "cmp_facade_segmentation_adapter"] },
    "source_url": { "type": "string" },
    "license_note": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "files": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/file" } },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false }
  },
  "$defs": {
    "file": {
      "type": "object",
      "required": ["role", "relative_path", "media_type", "byte_size", "sha256"],
      "properties": {
        "role": { "enum": ["source_image", "pose_annotation", "image_annotation", "facade_label_map", "cad_model"] },
        "relative_path": { "type": "string" },
        "media_type": { "enum": ["image", "annotation", "cad_model", "binary"] },
        "byte_size": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "minLength": 64 }
      }
    }
  }
}
