{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/manual-corrections.schema.json",
  "title": "Image Structured Modeler Manual Corrections",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": { "const": 1 },
    "object_profile": { "enum": ["switch_controller", "game_controller", "compact_remote", "remote_control", "media_remote"] },
    "notes": { "type": "array", "items": { "type": "string" } },
    "scale": {
      "type": "object",
      "properties": {
        "known_width": { "type": "number", "exclusiveMinimum": 0 },
        "known_height": { "type": "number", "exclusiveMinimum": 0 },
        "known_depth": { "type": "number", "exclusiveMinimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "parts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "action"],
        "properties": {
          "id": { "type": "string" },
          "action": { "enum": ["add", "update", "remove"] },
          "type": {
            "enum": [
              "rounded_box",
              "beveled_panel",
              "lofted_shell",
              "button_on_panel",
              "analog_stick",
              "trigger",
              "grip_handle",
              "slot",
              "screw_hole",
              "logo_emboss",
              "text_engrave",
              "mesh_reference"
            ]
          },
          "parent": { "type": "string" },
          "material": { "type": "string" },
          "parameters": { "type": "object" },
          "evidence_status": { "$ref": "#/$defs/evidence_status" },
          "evidence_sources": {
            "type": "array",
            "items": { "$ref": "#/$defs/evidence_source" }
          },
          "template_prior": { "type": "boolean" },
          "manual_confirmed": { "type": "boolean" },
          "feature_semantics": {
            "type": "array",
            "items": { "$ref": "#/$defs/feature_semantic" }
          },
          "feature_mapping": {
            "type": "object",
            "properties": {
              "operation": { "type": "string" },
              "fallback": { "enum": ["none", "visual_marker", "manual_required", "runtime_unsupported"] },
              "note": { "type": "string" }
            }
          },
          "uncertainty": { "type": "array", "items": { "type": "string" } },
          "evidence_note": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "open_questions": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "evidence_status": {
      "enum": ["observed", "inferred", "template_prior", "manual_confirmed"]
    },
    "feature_semantic": {
      "enum": ["concave", "convex", "flush", "decal_printed", "through_hole", "blind_recess"]
    },
    "evidence_source": {
      "type": "object",
      "required": ["view", "kind", "status"],
      "properties": {
        "view": { "type": "string" },
        "view_kind": { "type": "string" },
        "kind": { "type": "string" },
        "status": { "$ref": "#/$defs/evidence_status" },
        "source_image": { "type": "string" },
        "observation_id": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "note": { "type": "string" }
      }
    }
  }
}
