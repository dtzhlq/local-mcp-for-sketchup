{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/calibrated-view-review-decision.schema.json",
  "title": "CalibratedViewReviewDecision v1",
  "type": "object",
  "required": [
    "kind",
    "version",
    "source_calibrated_view_graph",
    "reviewer",
    "status",
    "accepted_axis_family_ids",
    "rejected_axis_family_ids",
    "corrected_axes",
    "accepted_projection_model",
    "promotion_allowed",
    "compile_allowed",
    "blockers",
    "notes"
  ],
  "properties": {
    "kind": { "const": "calibrated_view_review_decision_v1" },
    "version": { "const": 1 },
    "source_calibrated_view_graph": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted_for_derived_drafting"] },
    "accepted_axis_family_ids": { "type": "array", "items": { "type": "string" } },
    "rejected_axis_family_ids": { "type": "array", "items": { "type": "string" } },
    "corrected_axes": { "type": "array", "items": { "type": "object" } },
    "accepted_projection_model": { "type": ["string", "null"] },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
