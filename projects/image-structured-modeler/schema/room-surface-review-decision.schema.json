{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/room-surface-review-decision.schema.json",
  "title": "RoomSurfaceReviewDecision v1",
  "type": "object",
  "required": ["kind", "version", "source_room_surface_graph", "reviewer", "status", "accepted_surface_ids", "rejected_surface_ids", "promotion_allowed", "compile_allowed", "blockers", "notes"],
  "properties": {
    "kind": { "const": "room_surface_review_decision_v1" },
    "version": { "const": 1 },
    "source_room_surface_graph": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted_for_derived_drafting"] },
    "accepted_surface_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "rejected_surface_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "notes": { "type": "array", "items": { "type": "string" } }
  }
}
