            "source_request": { "type": ["object", "null"] },
            "source_status": { "type": ["string", "null"] },
            "view_status": { "type": ["string", "null"] },
            "scale_status": { "type": ["string", "null"] },
            "semantic_status": { "type": ["string", "null"] },
