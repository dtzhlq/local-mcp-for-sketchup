        }
      }
    },
    "next_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "checkIdList": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "viewEvidenceSummary": {
      "type": "object",
      "required": [
        "previous_missing_views",
        "current_required_views",
        "current_present_views",
        "current_missing_views",
        "requested_views",
        "satisfied_views",
        "unsatisfied_views",
        "view_source_diversity_status",
        "view_evidence",
        "requested_view_evidence"
      ],
      "properties": {
        "previous_missing_views": { "$ref": "#/$defs/checkIdList" },
        "current_required_views": { "$ref": "#/$defs/checkIdList" },
        "current_present_views": { "$ref": "#/$defs/checkIdList" },
        "current_missing_views": { "$ref": "#/$defs/checkIdList" },
        "requested_views": { "$ref": "#/$defs/checkIdList" },
        "satisfied_views": { "$ref": "#/$defs/checkIdList" },
        "unsatisfied_views": { "$ref": "#/$defs/checkIdList" },
        "view_source_diversity_status": { "type": "string", "minLength": 1 },
        "view_evidence": { "$ref": "#/$defs/viewEvidenceList" },
        "requested_view_evidence": { "$ref": "#/$defs/viewEvidenceList" }
      }
    },
    "viewEvidenceList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "view",
          "required",
          "status",
          "asset_count",
          "asset_ids",
          "source_images",
          "media_types",
          "content_sha256"
        ],
        "properties": {
          "view": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["present", "missing"] },
          "asset_count": { "type": "integer", "minimum": 0 },
          "asset_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_images": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "media_types": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "content_sha256": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "semanticEvidenceSummary": {
      "type": "object",
      "required": [
        "previous_missing_roles",
        "current_required_roles",
        "current_covered_roles",
        "current_missing_roles",
        "requested_roles",
        "satisfied_roles",
        "unsatisfied_roles",
        "evidence_quality",
        "role_evidence",
        "requested_role_evidence"
      ],
      "properties": {
        "previous_missing_roles": { "$ref": "#/$defs/checkIdList" },
        "current_required_roles": { "$ref": "#/$defs/checkIdList" },
        "current_covered_roles": { "$ref": "#/$defs/checkIdList" },
        "current_missing_roles": { "$ref": "#/$defs/checkIdList" },
        "requested_roles": { "$ref": "#/$defs/checkIdList" },
        "satisfied_roles": { "$ref": "#/$defs/checkIdList" },
        "unsatisfied_roles": { "$ref": "#/$defs/checkIdList" },
        "evidence_quality": { "$ref": "#/$defs/semanticEvidenceQuality" },
        "role_evidence": { "$ref": "#/$defs/semanticRoleEvidenceList" },
        "requested_role_evidence": { "$ref": "#/$defs/semanticRoleEvidenceList" }
      }
    },
    "visionEvidenceHandoff": {
      "type": "object",
      "required": [
        "available",
        "review_required",
        "verdict",
        "semantic_review_roles",
        "default_heavy_model_required",
        "review_patch_artifact",
        "semantic_evidence_instances",
        "modeling_handoff"
      ],
      "properties": {
        "available": { "type": "boolean" },
        "review_required": { "type": "boolean" },
        "verdict": { "type": ["string", "null"] },
        "semantic_review_roles": { "$ref": "#/$defs/checkIdList" },
        "default_heavy_model_required": { "type": "boolean" },
        "review_patch_artifact": { "type": ["string", "null"] },
        "semantic_evidence_instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/semanticEvidenceInstance" }
        },
        "modeling_handoff": {
          "type": "array",
          "items": { "$ref": "#/$defs/visionEvidenceModelingHandoff" }
        }
      }
    },
    "semanticEvidenceInstance": {
      "type": "object",
      "required": [
        "role",
        "evidence_id",
        "source_id",
        "source_image",
        "view",
        "class",
        "kind",
        "bbox_px",
        "confidence",
        "backend",
        "source_stage",
        "review_required"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "evidence_id": { "type": "string", "minLength": 1 },
        "source_id": { "type": "string" },
        "source_image": { "type": "string" },
        "view": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "bbox_px": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "number" }
        },
        "confidence": { "type": "number", "minimum": 0 },
        "backend": { "type": "string" },
        "source_stage": { "type": "string" },
        "review_required": { "type": "boolean" }
      }
    },
    "visionEvidenceModelingHandoff": {
      "type": "object",
      "required": [
        "role",
        "instance_count",
        "primary_instance",
        "evidence_tokens",
        "geometry_interpretation",
        "modeling_decision",
        "allowed_semantics",
        "blocked_interpretations",
        "required_confirmations",
        "handoff_text",
        "review_required",
        "geometry_promotion_allowed"
      ],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "instance_count": { "type": "integer", "minimum": 0 },
        "primary_instance": {
          "type": ["object", "null"],
          "required": [
            "evidence_id",
            "source_id",
            "source_image",
            "view",
            "bbox_px",
            "confidence"
          ],
          "properties": {
            "evidence_id": { "type": "string", "minLength": 1 },
            "source_id": { "type": "string" },
            "source_image": { "type": "string" },
            "view": { "type": "string", "minLength": 1 },
            "bbox_px": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": { "type": "number" }
            },
            "confidence": { "type": "number", "minimum": 0 }
          }
        },
        "evidence_tokens": { "$ref": "#/$defs/checkIdList" },
        "geometry_interpretation": { "type": "string", "minLength": 1 },
        "modeling_decision": { "type": "string", "minLength": 1 },
        "allowed_semantics": { "$ref": "#/$defs/checkIdList" },
        "blocked_interpretations": { "$ref": "#/$defs/checkIdList" },
        "required_confirmations": { "$ref": "#/$defs/checkIdList" },
        "handoff_text": { "type": "string", "minLength": 1 },
        "review_required": { "const": true },
        "geometry_promotion_allowed": { "const": false }
      }
    },
    "semanticEvidenceQuality": {
      "type": "object",
      "required": [
        "status",
        "required_role_count",
        "covered_role_count",
        "missing_role_count",
        "weak_role_count",
        "review_required_role_count",
        "geometry_promotion_allowed",
        "weak_roles",
        "review_required_roles",
        "flags"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_applicable",
            "missing",
            "weak_review_required",
            "review_required"
          ]
        },
        "required_role_count": { "type": "integer", "minimum": 0 },
        "covered_role_count": { "type": "integer", "minimum": 0 },
        "missing_role_count": { "type": "integer", "minimum": 0 },
        "weak_role_count": { "type": "integer", "minimum": 0 },
        "review_required_role_count": { "type": "integer", "minimum": 0 },
        "geometry_promotion_allowed": { "const": false },
        "weak_roles": { "$ref": "#/$defs/checkIdList" },
        "review_required_roles": { "$ref": "#/$defs/checkIdList" },
        "flags": { "$ref": "#/$defs/checkIdList" }
      }
    },
    "semanticRoleEvidenceList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "required",
          "status",
          "candidate_count",
          "candidate_ids",
          "views",
          "source_images",
          "confidence_min",
          "confidence_max",
          "view_count",
          "source_image_count",
          "evidence_quality_status",
          "requires_human_review",
          "geometry_promotion_allowed",
          "quality_flags"
        ],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "status": { "enum": ["covered", "missing"] },
          "candidate_count": { "type": "integer", "minimum": 0 },
          "candidate_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "views": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "source_images": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "confidence_min": { "type": "number", "minimum": 0 },
          "confidence_max": { "type": "number", "minimum": 0 },
          "view_count": { "type": "integer", "minimum": 0 },
          "source_image_count": { "type": "integer", "minimum": 0 },
          "evidence_quality_status": {
            "enum": [
              "missing",
              "weak_candidate",
              "review_candidate",
              "multi_view_review_candidate"
            ]
          },
          "requires_human_review": { "type": "boolean" },
          "geometry_promotion_allowed": { "const": false },
          "quality_flags": { "$ref": "#/$defs/checkIdList" }
        }
      }
    },
    "unsatisfiedCheckDetailList": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "current_status", "detail"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "current_status": { "type": "string", "minLength": 1 },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
