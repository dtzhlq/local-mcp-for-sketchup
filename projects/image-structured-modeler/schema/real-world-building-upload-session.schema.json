        "can_start_structured_intake",
        "release_source_candidate",
        "failed_requirements",
        "blockers",
        "warnings",
        "metadata_files",
        "view_source_diversity"
      ],
      "properties": {
        "ok": { "type": "boolean" },
        "status": { "type": "string", "minLength": 1 },
