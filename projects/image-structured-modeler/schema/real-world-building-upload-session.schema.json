              "path": { "type": "string", "minLength": 1 },
              "source": { "enum": ["view_hints_file", "upload_manifest"] },
              "status": { "enum": ["parsed", "invalid_json", "invalid_contract"] },
              "kind": { "type": "string" },
              "error": { "type": "string" },
              "errors": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "view_source_diversity": {
          "type": ["object", "null"],
          "properties": {
            "status": { "enum": ["pass", "fail", "review"] },
            "distinct_source_paths_for_required_views": { "type": "integer", "minimum": 0 },
