{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/image-structured-modeler/multi-view-relative-pose-review-decision.schema.json",
  "title": "MultiViewRelativePoseReviewDecision v1",
  "type": "object",
  "required": ["kind", "version", "source_multi_view_calibration_graph", "source_evidence_fusion_review_result", "reviewer", "status", "reference_view_id", "pose_edges", "promotion_allowed", "compile_allowed", "notes"],
  "properties": {
    "kind": { "const": "multi_view_relative_pose_review_decision_v1" },
    "version": { "const": 1 },
    "source_multi_view_calibration_graph": { "type": "string" },
    "source_evidence_fusion_review_result": { "type": "string" },
    "reviewer": { "type": "string" },
    "status": { "enum": ["not_accepted", "accepted_for_geometry_fusion"] },
    "reference_view_id": { "type": ["string", "null"] },
    "pose_edges": { "type": "array", "items": { "$ref": "#/$defs/pose_edge" } },
    "promotion_allowed": { "const": false },
    "compile_allowed": { "const": false },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "matrix_row": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "type": "number" } },
    "pose_edge": {
      "type": "object",
      "required": ["id", "source_view_id", "target_view_id", "model", "accepted_correspondence_ids", "transform_matrix", "confidence"],
      "properties": {
        "id": { "type": "string" },
        "source_view_id": { "type": "string" },
        "target_view_id": { "type": "string" },
        "model": { "enum": ["homography_2d", "rigid_transform_3d"] },
        "accepted_correspondence_ids": { "type": "array", "minItems": 3, "items": { "type": "string" } },
        "transform_matrix": { "type": "array", "minItems": 3, "maxItems": 4, "items": { "$ref": "#/$defs/matrix_row" } },
        "max_reprojection_residual_px": { "type": "number", "minimum": 0 },
        "max_alignment_residual_model_units": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
