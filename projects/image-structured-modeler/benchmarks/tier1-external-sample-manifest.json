{
  "kind": "image_structured_external_benchmark_manifest",
  "version": 1,
  "policy": "adapter_only_no_dataset_download",
  "samples": [
    {
      "id": "wikimedia_london_corner_facade_study",
      "dataset": "Wikimedia Commons single-image facade study",
      "domain": "building_single",
      "adapter": "facade_drafting_study_adapter",
      "sample_config": "projects/image-structured-modeler/examples/building-single-london-corner/sample.json",
      "dataset_url": "https://commons.wikimedia.org/wiki/File:Corner_building.jpg",
      "local_path": "external-datasets/wikimedia-commons/london-corner-building/london-corner-building.jpg",
      "license_note": "CC BY 2.0; Corner building, London, by R/DV/RS via Wikimedia Commons. Source raster remains external and ignored by git.",
      "expected_view_slots": [
        "front",
        "left_or_right_side",
        "top",
        "oblique_context"
      ]
    },
    {
      "id": "objectnet3d_car_pose_subset",
      "dataset": "ObjectNet3D",
      "domain": "vehicle",
      "adapter": "objectnet3d_pose_cad_adapter",
