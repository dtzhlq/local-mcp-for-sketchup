{
  "version": "real-model-reliability-corpus.v1",
  "kind": "real_model_reliability_corpus",
  "description": "Small adversarial reliability corpus. Deterministic fixtures are mock evidence only; independently sourced SketchUp artifacts remain an explicit live prerequisite.",
  "default_runtime": "mock",
  "repository_live_artifacts": {
    "tracked_skp_count": 0,
    "status": "external_live_required",
    "generated_output_artifacts_are_evidence": false
  },
  "live_policy": {
    "required_flags": ["--runtime queue", "--queue-required"],
    "fresh_handshake_per_guarded_operation": true,
    "modifies_and_reopens_active_model": true,
    "disposable_copy_required": true,
    "preflight_all_artifacts_before_queue": true,
    "interrupt_cleanup_required": true
  },
  "cases": [
    {
      "id": "architecture-golden",
      "domain": "architecture",
      "mock": {
        "evidence_class": "deterministic_mock_fixture",
        "source_kind": "repository_json_fixture",
        "source": "examples/golden-architecture.json",
        "runner": "repository_document"
      },
      "live": {
        "status": "external_live_required",
        "artifact": "architecture-building.skp",
        "contract": "architecture-building.reliability.json",
        "repository_tracked": false,
        "disposable_copy_required": true
      },
      "tasks": ["material_preservation", "scene_visibility_preservation", "save_reopen_identity"]
    },
    {
      "id": "interior-expression",
      "domain": "interior",
      "mock": {
        "evidence_class": "deterministic_mock_fixture",
