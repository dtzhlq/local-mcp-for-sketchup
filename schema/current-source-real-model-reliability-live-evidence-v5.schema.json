{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/schemas/current-source-real-model-reliability-live-evidence-v5.schema.json",
  "title": "Current Source Real Model Reliability Live Evidence v5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "captured_at",
    "branch",
    "result",
    "evidence_scope",
    "runtime",
    "execution_authorization",
    "lineage",
    "corpus",
    "case_summaries",
    "aggregate_metrics",
    "performance_boundary",
    "locked_target_guard",
    "appearance_preservation",
    "architecture_preservation",
    "dirty_topology_recovery",
    "source_sha256",
    "acceptance",
    "boundaries"
  ],
  "properties": {
    "version": { "const": "current-source-real-model-reliability-live-evidence.v5" },
    "kind": { "const": "current_source_real_model_reliability_live_evidence" },
    "captured_at": { "type": "string", "format": "date-time" },
    "branch": { "const": "codex/agent-contract-v1" },
    "result": { "const": "partial_pass" },
    "evidence_scope": {
      "const": "six_hash_bound_real_model_cases_with_two_guarded_geometry_mutations_and_controlled_overlay_boundaries"
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "execution_authorization": { "$ref": "#/$defs/executionAuthorization" },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prior_five_case_evidence", "dirty_topology_case_report"],
      "properties": {
        "prior_five_case_evidence": { "$ref": "#/$defs/artifact" },
        "dirty_topology_case_report": { "$ref": "#/$defs/artifact" }
      }
    },
    "corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_path",
        "manifest_sha256",
        "formal_cases_total",
        "formal_cases_passed",
        "formal_corpus_complete",
        "passed_case_ids",
        "remaining_case_ids"
      ],
      "properties": {
        "manifest_path": { "const": "test/reliability-corpus/manifest.json" },
        "manifest_sha256": { "$ref": "#/$defs/prefixedSha256" },
        "formal_cases_total": { "const": 7 },
        "formal_cases_passed": { "const": 6 },
        "formal_corpus_complete": { "const": false },
        "passed_case_ids": {
          "const": [
            "appearance-scenes-hidden",
            "architecture-golden",
            "deep-shared-components",
            "imported-dirty-topology",
            "interior-expression",
            "scaled-mirrored-locked"
          ]
        },
        "remaining_case_ids": { "const": ["product-boolean-manifold"] }
      }
    },
    "case_summaries": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/caseSummary" }
    },
    "aggregate_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks_total",
        "tasks_passed",
        "task_success_rate",
        "geometry_mutation_cases_passed",
        "controlled_fixture_overlay_cases_passed",
        "wrong_object_modification_count",
        "silent_geometry_corruption_count",
        "recovery_attempts",
        "recoveries",
        "recovery_rate",
        "aggregate_duration_ms",
        "queue_clean_after_each_case"
      ],
      "properties": {
        "tasks_total": { "const": 20 },
        "tasks_passed": { "const": 20 },
        "task_success_rate": { "const": 1 },
        "geometry_mutation_cases_passed": { "const": 2 },
        "controlled_fixture_overlay_cases_passed": { "const": 4 },
        "wrong_object_modification_count": { "const": 0 },
        "silent_geometry_corruption_count": { "const": 0 },
        "recovery_attempts": { "const": 2 },
        "recoveries": { "const": 2 },
        "recovery_rate": { "const": 1 },
        "aggregate_duration_ms": { "type": "integer", "minimum": 1 },
        "queue_clean_after_each_case": { "const": true }
      }
    },
    "performance_boundary": { "type": "object", "minProperties": 1 },
    "locked_target_guard": { "type": "object", "minProperties": 1 },
    "appearance_preservation": { "type": "object", "minProperties": 1 },
    "architecture_preservation": { "type": "object", "minProperties": 1 },
    "dirty_topology_recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "derivation_class",
        "controlled_overlay_target_only",
        "imported_context_retained",
        "arbitrary_imported_cad_repair_proven",
        "formal_case_geometry_mutation_executed",
        "abnormal_topology_detected",
        "expected_issue_codes",
        "repair_strategy",
        "before",
        "after",
        "exact_target_changed",
        "non_target_top_level_entities_unchanged",
        "source_artifact_bytes_unchanged",
        "save_reopen_identity_exact",
        "model_revision_exact_match",
        "recursive_entries_before",
        "recursive_entries_after",
        "recursive_total_before",
        "recursive_total_after",
        "recursive_payload_bounded",
        "queue_clean",
        "source_sha256",
        "verified_model_sha256",
        "verified_model_bytes"
      ],
      "properties": {
        "case_id": { "const": "imported-dirty-topology" },
        "derivation_class": {
          "const": "controlled_loose_edge_overlay_on_user_authorized_imported_model_copy"
        },
        "controlled_overlay_target_only": { "const": true },
        "imported_context_retained": { "const": true },
        "arbitrary_imported_cad_repair_proven": { "const": false },
        "formal_case_geometry_mutation_executed": { "const": true },
        "abnormal_topology_detected": { "const": true },
        "expected_issue_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "boundary_edges" },
          "items": { "type": "string", "minLength": 1 }
        },
        "repair_strategy": { "const": "cleanup" },
        "before": {
          "allOf": [
            { "$ref": "#/$defs/manifoldReport" },
            { "properties": { "is_manifold": { "const": false } } }
          ]
        },
        "after": {
          "allOf": [
            { "$ref": "#/$defs/manifoldReport" },
            {
              "properties": {
                "is_manifold": { "const": true },
                "issues": { "maxItems": 0 }
              }
            }
          ]
        },
        "exact_target_changed": { "const": true },
        "non_target_top_level_entities_unchanged": { "const": true },
        "source_artifact_bytes_unchanged": { "const": true },
        "save_reopen_identity_exact": { "const": true },
        "model_revision_exact_match": { "const": true },
        "recursive_entries_before": { "const": 100000 },
        "recursive_entries_after": { "const": 100000 },
        "recursive_total_before": { "const": 1903696 },
        "recursive_total_after": { "const": 1903696 },
        "recursive_payload_bounded": { "const": true },
        "queue_clean": { "const": true },
        "source_sha256": { "$ref": "#/$defs/prefixedSha256" },
        "verified_model_sha256": { "$ref": "#/$defs/prefixedSha256" },
        "verified_model_bytes": { "const": 15788286 }
      }
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "test/reliability-corpus/manifest.json",
        "scripts/aggregate-current-source-real-model-reliability-live-v5.mjs",
        "scripts/prepare-imported-dirty-topology-live-fixture.mjs",
        "scripts/run-real-model-reliability-harness.mjs",
        "scripts/run-real-model-reliability-live-case.mjs",
        "schema/current-source-real-model-reliability-live-evidence-v5.schema.json",
        "schema/controlled-dirty-topology-live-fixture-v1.schema.json",
        "schema/real-model-reliability-live-case-report-v1.schema.json",
        "schema/real-model-reliability-live-case-v1.schema.json",
        "src/bridge.mjs",
        "src/queue-runtime.mjs",
        "sketchup_plugin/local_mcp_for_sketchup/boolean_operations.rb",
        "sketchup_plugin/local_mcp_for_sketchup/model_revision.rb",
        "sketchup_plugin/local_mcp_for_sketchup/runtime_source_manifest.rb"
      ],
      "properties": {
        "test/reliability-corpus/manifest.json": { "$ref": "#/$defs/sha256" },
        "scripts/aggregate-current-source-real-model-reliability-live-v5.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/prepare-imported-dirty-topology-live-fixture.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/run-real-model-reliability-harness.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/run-real-model-reliability-live-case.mjs": { "$ref": "#/$defs/sha256" },
        "schema/current-source-real-model-reliability-live-evidence-v5.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/controlled-dirty-topology-live-fixture-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/real-model-reliability-live-case-report-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/real-model-reliability-live-case-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "src/bridge.mjs": { "$ref": "#/$defs/sha256" },
        "src/queue-runtime.mjs": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/boolean_operations.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/model_revision.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/runtime_source_manifest.rb": { "$ref": "#/$defs/sha256" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "six_case_live_reliability",
        "full_recursive_save_reopen",
        "bounded_large_model_save_reopen",
        "shared_definition_scope",
        "material_and_scene_preservation",
        "appearance_uv_hidden_preservation",
        "architecture_case",
        "mutation_cases_passed",
        "locked_transform_rollback",
        "native_lock_guard_enforced",
        "boolean_manifold",
        "dirty_topology_recovery",
        "arbitrary_imported_cad_repair",
        "formal_corpus_cases_passed",
        "formal_corpus_cases_total",
        "formal_corpus_complete",
        "agent_gateway_default_profile_qualified",
        "cross_version",
        "release_acceptance"
      ],
      "properties": {
        "six_case_live_reliability": { "const": true },
        "full_recursive_save_reopen": { "const": true },
        "bounded_large_model_save_reopen": { "const": true },
        "shared_definition_scope": { "const": true },
        "material_and_scene_preservation": { "const": true },
        "appearance_uv_hidden_preservation": { "const": true },
        "architecture_case": { "const": true },
        "mutation_cases_passed": { "const": 2 },
        "locked_transform_rollback": { "const": true },
        "native_lock_guard_enforced": { "const": true },
        "boolean_manifold": { "const": false },
        "dirty_topology_recovery": { "const": true },
        "arbitrary_imported_cad_repair": { "const": false },
        "formal_corpus_cases_passed": { "const": 6 },
        "formal_corpus_cases_total": { "const": 7 },
        "formal_corpus_complete": { "const": false },
        "agent_gateway_default_profile_qualified": { "const": false },
        "cross_version": { "const": "deferred_by_user" },
        "release_acceptance": { "const": false }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "type": "string", "minLength": 40 }
    }
  },
  "allOf": [
    {
      "properties": {
        "case_summaries": {
          "contains": {
            "type": "object",
            "required": [
              "case_id",
              "tasks_total",
              "tasks_passed",
              "geometry_mutation_executed"
            ],
            "properties": {
              "case_id": { "const": "imported-dirty-topology" },
              "tasks_total": { "const": 3 },
              "tasks_passed": { "const": 3 },
              "geometry_mutation_executed": { "const": true }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    },
    {
      "properties": {
        "case_summaries": {
          "contains": {
            "type": "object",
            "required": ["case_id", "geometry_mutation_executed"],
            "properties": {
              "case_id": { "const": "scaled-mirrored-locked" },
              "geometry_mutation_executed": { "const": true }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|file://|~/)" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "server_version",
        "plugin_version",
        "sketchup_version",
        "ruby_version",
        "capability_version",
        "manifest_version",
        "dsl_version",
        "occurrence_contract",
        "revision_strategy",
        "revision_source_sha256",
        "compatibility_ok"
      ],
      "properties": {
        "name": { "const": "queue" },
        "server_version": { "const": "0.1.0-rc.2" },
        "plugin_version": { "const": "0.1.0-rc.2" },
        "sketchup_version": { "const": "26.2.242" },
        "ruby_version": { "const": "3.2.2" },
        "capability_version": { "const": "0.1.0-rc.2-capabilities.7" },
        "manifest_version": { "const": "2026-07-agent-contract-v1.4" },
        "dsl_version": { "const": 1 },
        "occurrence_contract": { "const": "canonical-occurrence-path.v1" },
        "revision_strategy": { "const": "definition-merkle.v2" },
        "revision_source_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_ok": { "const": true }
      }
    },
    "executionAuthorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "user_authorized_disposable_copies",
        "queue_required",
        "allowed_runtimes_explicit",
        "queue_mutation_explicit",
        "direct_expert_mutation_explicit",
        "policy_persisted",
        "default_policy_unchanged",
        "agent_self_authorization_allowed"
      ],
      "properties": {
        "mode": { "const": "local_operator_ephemeral_process_policy" },
        "user_authorized_disposable_copies": { "const": true },
        "queue_required": { "const": true },
        "allowed_runtimes_explicit": { "const": true },
        "queue_mutation_explicit": { "const": true },
        "direct_expert_mutation_explicit": { "const": true },
        "policy_persisted": { "const": false },
        "default_policy_unchanged": { "const": true },
        "agent_self_authorization_allowed": { "const": false }
      }
    },
    "caseSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "tasks_total",
        "tasks_passed",
        "duration_ms",
        "geometry_mutation_executed",
        "save_reopen_exact",
        "wrong_object_modification_count",
        "silent_geometry_corruption_count",
        "queue_clean"
      ],
      "properties": {
        "case_id": {
          "enum": [
            "appearance-scenes-hidden",
            "architecture-golden",
            "deep-shared-components",
            "imported-dirty-topology",
            "interior-expression",
            "scaled-mirrored-locked"
          ]
        },
        "tasks_total": { "type": "integer", "minimum": 1 },
        "tasks_passed": { "type": "integer", "minimum": 1 },
        "duration_ms": { "type": "integer", "minimum": 1 },
        "geometry_mutation_executed": { "type": "boolean" },
        "save_reopen_exact": { "const": true },
        "wrong_object_modification_count": { "const": 0 },
        "silent_geometry_corruption_count": { "const": 0 },
        "queue_clean": { "const": true }
      }
    },
    "manifoldReport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_manifold", "method", "faces", "edges", "vertices", "issues"],
      "properties": {
        "is_manifold": { "type": "boolean" },
        "method": { "const": "sketchup_manifold_api" },
        "faces": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "vertices": { "type": "integer", "minimum": 0 },
        "issues": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
