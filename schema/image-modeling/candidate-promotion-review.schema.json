{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/schema/image-modeling/candidate-promotion-review.schema.json",
  "title": "CandidatePromotionReview",
  "type": "object",
  "required": [
    "version",
    "kind",
    "asset_set_id",
    "profile_id",
    "source_candidate_graph",
    "reviewer",
    "verdict",
    "compile_allowed",
    "promotion_allowed",
    "missing_inputs",
    "blockers",
    "profile_confirmation",
    "scale_confirmation",
    "draft_view_review",
    "local_detail_review",
    "accepted_candidates",
    "held_candidates"
  ],
  "properties": {
    "version": { "const": 1 },
    "kind": { "const": "candidate_promotion_review" },
    "asset_set_id": { "type": "string" },
    "profile_id": { "type": "string" },
    "source_candidate_graph": { "type": "string" },
    "content_signature": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
    "artifact_bindings": {
      "type": "object",
      "required": ["asset_set", "observations", "candidate_graph"],
      "properties": {
        "asset_set": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "observations": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "candidate_graph": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "reviewer": { "type": "string" },
    "verdict": { "enum": ["blocked", "needs_review", "accepted_subset", "rejected"] },
    "compile_allowed": { "type": "boolean" },
    "promotion_allowed": { "type": "boolean" },
    "missing_inputs": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "resolved_blockers": { "type": "array", "items": { "type": "string" } },
    "profile_confirmation": {
      "type": "object",
      "required": ["selected_profile", "status"],
      "properties": {
        "selected_profile": { "type": "string" },
        "status": { "enum": ["needs_profile", "routed_unconfirmed", "confirmed"] },
        "note": { "type": "string" }
      }
    },
    "scale_confirmation": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "enum": ["needs_scale_confirmation", "profile_default_unconfirmed", "confirmed"] },
        "known_width": { "type": "number" },
        "known_depth": { "type": "number" },
        "known_height": { "type": "number" },
        "units": { "const": "mm" },
        "confirmation_scope": { "enum": ["metric_truth", "test_runtime_profile_default"] },
        "metric_accuracy_claimed": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "calibration_review": {
      "type": ["object", "null"],
      "required": [
        "source_perspective_calibration_review_result",
        "status",
        "accepted_axis_family_ids",
        "rectification_allowed",
        "promotion_allowed",
        "blockers"
      ],
      "properties": {
        "source_perspective_calibration_review_result": { "type": "string" },
        "status": { "enum": ["blocked_no_accepted_review", "blocked_invalid_review", "accepted_for_rectification"] },
        "accepted_axis_family_ids": { "type": "array", "items": { "type": "string" } },
        "rectification_allowed": { "type": "boolean" },
        "topology_inference_allowed": { "type": "boolean" },
        "promotion_allowed": { "const": false },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "topology_review": {
      "type": ["object", "null"],
      "required": [
        "source_corner_chain_topology_review",
        "status",
        "accepted_topology_ids",
        "derived_drafting_allowed",
        "promotion_allowed",
        "blockers"
      ],
      "properties": {
        "source_corner_chain_topology_review": { "type": "string" },
        "status": { "enum": ["blocked_no_accepted_topology_review", "blocked_invalid_topology_review", "accepted_for_derived_drafting"] },
        "accepted_topology_ids": { "type": "array", "items": { "type": "string" } },
        "derived_drafting_allowed": { "type": "boolean" },
        "promotion_allowed": { "const": false },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "facade_plane_review": {
      "type": ["object", "null"],
      "required": [
        "source_facade_plane_graph",
        "status",
        "accepted_plane_ids",
        "promotion_allowed",
        "blockers"
      ],
      "properties": {
        "source_facade_plane_graph": { "type": "string" },
        "status": { "enum": ["not_accepted", "accepted", "rejected"] },
        "accepted_plane_ids": { "type": "array", "items": { "type": "string" } },
        "promotion_allowed": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "draft_view_review": {
      "type": ["object", "null"],
      "required": [
        "source_draft_view_graph",
        "status",
        "accepted_view_slot_ids",
        "promotion_allowed",
        "blockers"
      ],
      "properties": {
        "source_draft_view_graph": { "type": "string" },
        "status": { "enum": ["not_accepted", "accepted", "partial", "rejected"] },
        "accepted_view_slot_ids": { "type": "array", "items": { "type": "string" } },
        "accepted_plane_hypothesis_ids": { "type": "array", "items": { "type": "string" } },
        "promotion_allowed": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "local_detail_review": {
      "type": ["object", "null"],
      "required": [
        "status",
        "accepted_surface_ids",
        "accepted_detail_ids",
        "promotion_allowed",
        "blockers"
      ],
      "properties": {
        "source_object_surface_graph": { "type": ["string", "null"] },
        "source_facade_plane_graph": { "type": ["string", "null"] },
        "status": { "enum": ["not_accepted", "accepted", "partial", "rejected"] },
        "accepted_surface_ids": { "type": "array", "items": { "type": "string" } },
        "accepted_detail_ids": { "type": "array", "items": { "type": "string" } },
        "promotion_allowed": { "type": "boolean" },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "negative_evidence_review": {
      "type": ["object", "null"],
      "required": ["status", "semantic_contract_allowed", "confirmed_observations", "blockers"],
      "properties": {
        "status": { "enum": ["not_accepted", "accepted", "partial", "rejected"] },
        "semantic_contract_allowed": { "type": "boolean" },
        "confirmed_observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/negative_evidence_review_item" }
        },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "accepted_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate_review_item" }
    },
    "held_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/candidate_review_item" }
    },
    "notes": { "type": "string" },
    "instructions": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "required": ["artifact_bindings"] },
      "then": {
        "required": ["content_signature"],
        "properties": {
          "accepted_candidates": {
            "items": {
              "required": ["source_image", "source_observation_id"],
              "properties": {
                "promotion_status": { "const": "accepted_for_part_graph" },
                "blockers": { "maxItems": 0 }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate_review_item": {
      "type": "object",
      "required": ["candidate_id", "role", "view", "promotion_status", "blockers"],
      "properties": {
        "candidate_id": { "type": "string" },
        "role": { "type": "string" },
        "view": { "type": "string" },
        "source_image": { "type": "string" },
        "source_observation_id": { "type": "string" },
        "confidence": { "type": "number" },
        "promotion_status": { "type": "string" },
        "accepted_draft_view_slot_id": { "type": "string" },
        "accepted_plane_id": { "type": "string" },
        "accepted_surface_id": { "type": "string" },
        "accepted_detail_id": { "type": "string" },
        "resolved_blockers": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "supporting_observations": {
          "type": "array",
          "items": { "$ref": "#/$defs/supporting_observation" }
        },
        "blockers": { "type": "array", "items": { "type": "string" } },
        "reviewer_note": { "type": "string" }
      }
    },
    "supporting_observation": {
      "type": "object",
      "required": ["source_image", "source_observation_id", "view", "status"],
      "properties": {
        "source_image": { "type": "string" },
        "source_observation_id": { "type": "string" },
        "view": { "type": "string" },
        "status": { "const": "confirmed_support" },
        "reviewer_note": { "type": "string" }
      }
    },
    "negative_evidence_review_item": {
      "type": "object",
      "required": ["source_image", "source_observation_id", "view", "absent_role", "status", "blockers"],
      "properties": {
        "source_image": { "type": "string" },
        "source_observation_id": { "type": "string" },
        "view": { "enum": ["front", "rear", "left", "right", "oblique"] },
        "absent_role": { "enum": ["balustrade", "side_stair", "rear_stair"] },
        "status": { "const": "confirmed_absent" },
        "blockers": { "type": "array", "items": { "type": "string" }, "maxItems": 0 },
        "reviewer_note": { "type": "string" }
      }
    }
  }
}
