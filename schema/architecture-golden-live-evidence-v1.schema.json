{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/schemas/architecture-golden-live-evidence-v1.schema.json",
  "title": "Architecture Golden Live Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "captured_at",
    "branch",
    "result",
    "evidence_scope",
    "case_id",
    "runtime",
    "source_fixture",
    "preservation_contract",
    "live_verification",
    "artifacts",
    "source_sha256",
    "acceptance",
    "boundaries"
  ],
  "properties": {
    "version": { "const": "architecture-golden-live-evidence.v1" },
    "kind": { "const": "architecture_golden_live_evidence" },
    "captured_at": { "type": "string", "format": "date-time" },
    "branch": { "const": "codex/agent-contract-v1" },
    "result": { "const": "live_verified" },
    "evidence_scope": { "const": "single_hash_bound_architecture_metadata_overlay_and_save_reopen_case" },
    "case_id": { "const": "architecture-golden" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "source_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_class",
        "original_input_sha256",
        "original_bytes_unchanged",
        "source_artifact_sha256",
        "metadata_operations",
        "geometry_mutation_performed",
        "top_level_entities_before",
        "top_level_entities_after",
        "recursive_total_before",
        "recursive_total_after",
        "recursive_truncated"
      ],
      "properties": {
        "derivation_class": { "const": "controlled_metadata_overlay_on_user_authorized_real_model_copy" },
        "original_input_sha256": { "$ref": "#/$defs/sha256" },
        "original_bytes_unchanged": { "const": true },
        "source_artifact_sha256": { "$ref": "#/$defs/prefixedSha256" },
        "metadata_operations": { "const": ["material", "scene"] },
        "geometry_mutation_performed": { "const": false },
        "top_level_entities_before": { "const": 1 },
        "top_level_entities_after": { "const": 1 },
        "recursive_total_before": { "const": 5859 },
        "recursive_total_after": { "const": 5859 },
        "recursive_truncated": { "const": false }
      }
    },
    "preservation_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_name_untrusted",
        "material_persisted",
        "scene_name_untrusted",
        "scene_persisted",
        "existing_material_assignments_in_signature",
        "top_level_visibility_in_signature",
        "nested_hidden_occurrence_attestation"
      ],
      "properties": {
        "material_name_untrusted": { "const": "LOCAL_MCP_FOR_SKETCHUP_Reliability_Architecture_Material" },
        "material_persisted": { "const": true },
        "scene_name_untrusted": { "const": "LOCAL_MCP_FOR_SKETCHUP_Reliability_Architecture_Scene" },
        "scene_persisted": { "const": true },
        "existing_material_assignments_in_signature": { "const": true },
        "top_level_visibility_in_signature": { "const": true },
        "nested_hidden_occurrence_attestation": { "const": false }
      }
    },
    "live_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks_total",
        "tasks_passed",
        "material_signature",
        "material_signature_preserved",
        "scene_visibility_signature",
        "scene_visibility_signature_preserved",
        "scenes",
        "hidden_top_level_entities",
        "save_reopen_exact_identity",
        "recursive_entries_before",
        "recursive_entries_after",
        "model_revision_exact_match",
        "snapshot_error_diffs",
        "wrong_object_modification_count",
        "silent_geometry_corruption_count",
        "recovery_attempts",
        "recoveries",
        "recovery_rate",
        "queue_clean"
      ],
      "properties": {
        "tasks_total": { "const": 3 },
        "tasks_passed": { "const": 3 },
        "material_signature": { "$ref": "#/$defs/prefixedSha256" },
        "material_signature_preserved": { "const": true },
        "scene_visibility_signature": { "$ref": "#/$defs/prefixedSha256" },
        "scene_visibility_signature_preserved": { "const": true },
        "scenes": { "const": 1 },
        "hidden_top_level_entities": { "const": 0 },
        "save_reopen_exact_identity": { "const": true },
        "recursive_entries_before": { "const": 5859 },
        "recursive_entries_after": { "const": 5859 },
        "model_revision_exact_match": { "const": true },
        "snapshot_error_diffs": { "const": 0 },
        "wrong_object_modification_count": { "const": 0 },
        "silent_geometry_corruption_count": { "const": 0 },
        "recovery_attempts": { "const": 0 },
        "recoveries": { "const": 0 },
        "recovery_rate": { "const": 1 },
        "queue_clean": { "const": true }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_input",
        "finalization_report",
        "source_model",
        "source_contract",
        "success_report",
        "success_diagnostic",
        "verified_model"
      ],
      "properties": {
        "original_input": { "$ref": "#/$defs/artifact" },
        "finalization_report": { "$ref": "#/$defs/artifact" },
        "source_model": { "$ref": "#/$defs/artifact" },
        "source_contract": { "$ref": "#/$defs/artifact" },
        "success_report": { "$ref": "#/$defs/artifact" },
        "success_diagnostic": { "$ref": "#/$defs/artifact" },
        "verified_model": { "$ref": "#/$defs/artifact" }
      }
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scripts/build-architecture-golden-live-evidence.mjs",
        "scripts/prepare-architecture-golden-live-fixture.mjs",
        "scripts/run-real-model-reliability-harness.mjs",
        "scripts/run-real-model-reliability-live-case.mjs",
        "schema/architecture-golden-live-evidence-v1.schema.json",
        "schema/controlled-architecture-live-fixture-v1.schema.json",
        "schema/real-model-reliability-live-case-report-v1.schema.json",
        "schema/real-model-reliability-live-case-v1.schema.json",
        "sketchup_plugin/local_mcp_for_sketchup/materials.rb",
        "sketchup_plugin/local_mcp_for_sketchup/model_revision.rb",
        "sketchup_plugin/local_mcp_for_sketchup/snapshot.rb",
        "sketchup_plugin/local_mcp_for_sketchup/view_operations.rb"
      ],
      "properties": {
        "scripts/build-architecture-golden-live-evidence.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/prepare-architecture-golden-live-fixture.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/run-real-model-reliability-harness.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/run-real-model-reliability-live-case.mjs": { "$ref": "#/$defs/sha256" },
        "schema/architecture-golden-live-evidence-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/controlled-architecture-live-fixture-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/real-model-reliability-live-case-report-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/real-model-reliability-live-case-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/materials.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/model_revision.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/snapshot.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/local_mcp_for_sketchup/view_operations.rb": { "$ref": "#/$defs/sha256" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_case_passed",
        "architecture_material_scene_preservation",
        "formal_corpus_cases_passed",
        "formal_corpus_cases_total",
        "formal_corpus_complete",
        "cross_version",
        "release_acceptance"
      ],
      "properties": {
        "selected_case_passed": { "const": true },
        "architecture_material_scene_preservation": { "const": true },
        "formal_corpus_cases_passed": { "const": 1 },
        "formal_corpus_cases_total": { "const": 7 },
        "formal_corpus_complete": { "const": false },
        "cross_version": { "const": "deferred_by_user" },
        "release_acceptance": { "const": false }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 40 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|file://|~/)" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "server_version",
        "plugin_version",
        "sketchup_version",
        "ruby_version",
        "capability_version",
        "manifest_version",
        "dsl_version",
        "occurrence_contract",
        "revision_strategy",
        "revision_source_sha256",
        "compatibility_ok"
      ],
      "properties": {
        "name": { "const": "queue" },
        "server_version": { "const": "0.1.0-rc.2" },
        "plugin_version": { "const": "0.1.0-rc.2" },
        "sketchup_version": { "const": "26.2.242" },
        "ruby_version": { "const": "3.2.2" },
        "capability_version": { "const": "0.1.0-rc.2-capabilities.7" },
        "manifest_version": { "const": "2026-07-agent-contract-v1.4" },
        "dsl_version": { "const": 1 },
        "occurrence_contract": { "const": "canonical-occurrence-path.v1" },
        "revision_strategy": { "const": "definition-merkle.v2" },
        "revision_source_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_ok": { "const": true }
      }
    }
  }
}
