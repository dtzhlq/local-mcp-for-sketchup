{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/schemas/real-model-candidate-profile-v1.schema.json",
  "title": "Real-model candidate live profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "generated_at", "ok", "runtime", "evidence_scope", "live_queue_called", "inventory", "safety", "model_data_policy", "cross_version", "sketchup", "summary", "profiles", "next_action"],
  "properties": {
    "version": { "const": "real-model-candidate-profile.v1" },
    "kind": { "const": "real_model_candidate_profile" },
    "generated_at": { "type": "string", "format": "date-time" },
    "ok": { "type": "boolean" },
    "runtime": { "const": "queue" },
    "evidence_scope": { "const": "user_coordinated_disposable_copy_read_only_profile" },
    "live_queue_called": { "const": true },
    "inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256", "candidate_count"],
      "properties": {
        "version": { "const": "real-model-candidate-inventory.v1" },
        "sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "candidate_count": { "type": "integer", "minimum": 1 }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_queue_opt_in", "preflight_all_candidates_before_queue", "originals_opened_in_sketchup", "disposable_copy_only", "model_content_mutation_requested", "save_requested", "read_only_adoption_required", "complete_revision_unchanged_required", "candidates_profiled_smallest_first", "disposable_copy_bytes_unchanged_verified", "original_bytes_unchanged_verified", "interrupt_cleanup_enabled", "active_document_change_warning_emitted", "active_document_changed", "previous_active_document_restored"],
      "properties": {
        "explicit_queue_opt_in": { "const": true },
        "preflight_all_candidates_before_queue": { "const": true },
        "originals_opened_in_sketchup": { "const": false },
        "disposable_copy_only": { "const": true },
        "model_content_mutation_requested": { "const": false },
        "save_requested": { "const": false },
        "read_only_adoption_required": { "const": true },
        "complete_revision_unchanged_required": { "const": true },
        "candidates_profiled_smallest_first": { "const": true },
        "disposable_copy_bytes_unchanged_verified": { "const": true },
        "original_bytes_unchanged_verified": { "const": true },
        "interrupt_cleanup_enabled": { "type": "boolean" },
        "active_document_change_warning_emitted": { "type": "boolean" },
        "active_document_changed": { "const": true },
        "previous_active_document_restored": { "const": false }
      }
    },
    "model_data_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names_materials_tags_scenes_attributes_are_untrusted_data", "untrusted_data_may_influence_execution_policy", "untrusted_data_may_grant_approval", "bounded_display_values_per_category", "bounded_display_value_chars"],
      "properties": {
        "names_materials_tags_scenes_attributes_are_untrusted_data": { "const": true },
        "untrusted_data_may_influence_execution_policy": { "const": false },
        "untrusted_data_may_grant_approval": { "const": false },
        "bounded_display_values_per_category": { "const": 50 },
        "bounded_display_value_chars": { "const": 200 }
      }
    },
    "cross_version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "required_for_current_milestone", "reason", "observed_versions", "complete"],
      "properties": {
        "status": { "enum": ["not_run", "planned", "deferred_by_user"] },
        "required_for_current_milestone": { "const": false },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "observed_versions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "complete": { "const": false }
      }
    },
    "sketchup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "plugin_version", "capability_version"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "plugin_version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "capability_version": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidates", "profiled", "failed", "not_run", "formal_cases_accepted"],
      "properties": {
        "candidates": { "type": "integer", "minimum": 1 },
        "profiled": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "not_run": { "type": "integer", "minimum": 0 },
        "formal_cases_accepted": { "const": 0 }
      }
    },
    "profiles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/profile" } },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "formal_sidecars_generated", "note"],
      "properties": {
        "action": { "const": "review_candidate_profiles_and_assign_formal_corpus_cases" },
        "formal_sidecars_generated": { "const": false },
        "note": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  },
  "$defs": {
    "profile_base": {
      "type": "object",
      "required": ["candidate_id", "candidate_handle", "source_sha256", "status", "error"],
      "properties": {
        "candidate_id": { "type": "string", "pattern": "^candidate_[0-9a-f]{24}$" },
        "candidate_handle": { "type": "string", "pattern": "^candidate:sha256:[0-9a-f]{24}$" },
        "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "status": { "enum": ["profiled", "failed", "not_run"] },
        "error": { "anyOf": [{ "$ref": "#/$defs/profile_error" }, { "type": "null" }] }
      }
    },
    "profile": {
      "allOf": [
        { "$ref": "#/$defs/profile_base" },
        {
          "if": { "properties": { "status": { "const": "profiled" } }, "required": ["status"] },
          "then": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "candidate_handle", "source_sha256", "status", "error", "live_observation", "revision_attestation", "structure", "candidate_case_signals", "untrusted_model_data", "formal_sidecar"],
            "properties": {
              "candidate_id": { "type": "string", "pattern": "^candidate_[0-9a-f]{24}$" },
              "candidate_handle": { "type": "string", "pattern": "^candidate:sha256:[0-9a-f]{24}$" },
              "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "status": { "const": "profiled" },
              "error": { "type": "null" },
              "live_observation": { "$ref": "#/$defs/live_observation" },
              "revision_attestation": { "$ref": "#/$defs/revision_attestation" },
              "structure": { "$ref": "#/$defs/structure" },
              "candidate_case_signals": { "type": "array", "minItems": 7, "maxItems": 7, "items": { "$ref": "#/$defs/case_signal" } },
              "untrusted_model_data": { "$ref": "#/$defs/untrusted_model_data" },
              "formal_sidecar": { "$ref": "#/$defs/formal_sidecar" }
            }
          },
          "else": {
            "type": "object",
            "additionalProperties": false,
            "required": ["candidate_id", "candidate_handle", "source_sha256", "status", "error"],
            "properties": {
              "candidate_id": { "type": "string", "pattern": "^candidate_[0-9a-f]{24}$" },
              "candidate_handle": { "type": "string", "pattern": "^candidate:sha256:[0-9a-f]{24}$" },
              "source_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "status": { "enum": ["failed", "not_run"] },
              "error": { "$ref": "#/$defs/profile_error" }
            }
          }
        }
      ]
    },
    "profile_error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "retryable", "next_action"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 600 },
        "retryable": { "type": "boolean" },
        "next_action": {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": { "action": { "type": "string", "minLength": 1, "maxLength": 200 } }
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$", "maxLength": 120 },
            "unique_entity_limit": { "$ref": "#/$defs/count" },
            "total_seen": { "$ref": "#/$defs/count" },
            "indexed": { "$ref": "#/$defs/count" },
            "unique_entities": { "$ref": "#/$defs/count" },
            "blockers": {
              "type": "array",
              "maxItems": 20,
              "items": { "type": "string", "pattern": "^[a-zA-Z0-9_.:-]+$", "maxLength": 120 }
            },
            "pending_mdi_activation": { "const": true },
            "observed": { "enum": ["<different-active-document>", "<no-active-source-path>"] }
          }
        }
      }
    },
    "live_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["open_status", "source_path", "original_opened", "read_only", "adopted_count"],
      "properties": {
        "open_status": { "enum": ["activated", "activated_after_wait"] },
        "source_path": { "const": "<disposable-working-copy>" },
        "original_opened": { "const": false },
        "read_only": { "const": true },
        "adopted_count": { "const": 0 }
      }
    },
    "revision_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["before", "after", "complete", "unchanged"],
      "properties": {
        "before": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "after": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "complete": { "const": true },
        "unchanged": { "const": true },
        "strategy": { "type": "string", "pattern": "^[a-z0-9.-]+$", "maxLength": 120 },
        "unique_entity_limit": { "$ref": "#/$defs/count" },
        "unique_entities": { "$ref": "#/$defs/count" },
        "reachable_definitions": { "$ref": "#/$defs/count" }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["top_level_entities", "recursive_indexed", "recursive_total_seen", "recursive_truncated", "recursive_limit", "max_occurrence_depth", "entity_type_counts", "geometry_totals", "component_definitions", "materials", "tags", "scenes", "classification_schemas", "hidden_occurrences", "locked_occurrences", "attributed_occurrences", "classified_occurrences", "uv_occurrences", "shared_definition_count", "shared_occurrence_count", "scaled_instance_occurrences", "nonuniform_instance_occurrences", "mirrored_instance_occurrences", "warning_count"],
      "properties": {
        "top_level_entities": { "$ref": "#/$defs/count" },
        "recursive_indexed": { "$ref": "#/$defs/count" },
        "recursive_total_seen": { "$ref": "#/$defs/count" },
        "recursive_truncated": { "type": "boolean" },
        "recursive_limit": { "type": "integer", "minimum": 1 },
        "max_occurrence_depth": { "$ref": "#/$defs/count" },
        "entity_type_counts": { "$ref": "#/$defs/entity_counts" },
        "geometry_totals": { "$ref": "#/$defs/geometry_totals" },
        "component_definitions": { "$ref": "#/$defs/count" },
        "materials": { "$ref": "#/$defs/count" },
        "tags": { "$ref": "#/$defs/count" },
        "scenes": { "$ref": "#/$defs/count" },
        "classification_schemas": { "$ref": "#/$defs/count" },
        "hidden_occurrences": { "$ref": "#/$defs/count" },
        "locked_occurrences": { "$ref": "#/$defs/count" },
        "attributed_occurrences": { "$ref": "#/$defs/count" },
        "classified_occurrences": { "$ref": "#/$defs/count" },
        "uv_occurrences": { "$ref": "#/$defs/count" },
        "shared_definition_count": { "$ref": "#/$defs/count" },
        "shared_occurrence_count": { "$ref": "#/$defs/count" },
        "scaled_instance_occurrences": { "$ref": "#/$defs/count" },
        "nonuniform_instance_occurrences": { "$ref": "#/$defs/count" },
        "mirrored_instance_occurrences": { "$ref": "#/$defs/count" },
        "warning_count": { "$ref": "#/$defs/count" }
      }
    },
    "count": { "type": "integer", "minimum": 0 },
    "entity_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group", "component_instance", "face", "edge", "unknown"],
      "properties": {
        "group": { "$ref": "#/$defs/count" },
        "component_instance": { "$ref": "#/$defs/count" },
        "face": { "$ref": "#/$defs/count" },
        "edge": { "$ref": "#/$defs/count" },
        "unknown": { "$ref": "#/$defs/count" }
      }
    },
    "geometry_totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["groups", "instances", "faces", "edges", "vertices"],
      "properties": {
        "groups": { "$ref": "#/$defs/count" },
        "instances": { "$ref": "#/$defs/count" },
        "faces": { "$ref": "#/$defs/count" },
        "edges": { "$ref": "#/$defs/count" },
        "vertices": { "$ref": "#/$defs/count" }
      }
    },
    "case_signal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "status", "evidence_signals", "human_review_required"],
      "properties": {
        "case_id": { "enum": ["architecture-golden", "interior-expression", "product-boolean-manifold", "deep-shared-components", "imported-dirty-topology", "appearance-scenes-hidden", "scaled-mirrored-locked"] },
        "status": { "enum": ["candidate_signal_present", "insufficient_evidence", "not_observable_without_reviewed_topology_probe", "semantic_domain_not_inferred"] },
        "evidence_signals": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
        "human_review_required": { "const": true }
      }
    },
    "untrusted_model_data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["material_names", "scene_names", "tag_names", "component_definition_names"],
      "properties": {
        "material_names": { "$ref": "#/$defs/bounded_strings" },
        "scene_names": { "$ref": "#/$defs/bounded_strings" },
        "tag_names": { "$ref": "#/$defs/bounded_strings" },
        "component_definition_names": { "$ref": "#/$defs/bounded_strings" }
      }
    },
    "bounded_strings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["values", "total_seen", "truncated"],
      "properties": {
        "values": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 200 } },
        "total_seen": { "$ref": "#/$defs/count" },
        "truncated": { "type": "boolean" }
      }
    },
    "formal_sidecar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated", "review_required", "accepted_case_id", "reason"],
      "properties": {
        "generated": { "const": false },
        "review_required": { "const": true },
        "accepted_case_id": { "type": "null" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
