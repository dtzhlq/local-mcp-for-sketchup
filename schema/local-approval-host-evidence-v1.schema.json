{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/local-mcp-for-sketchup/local-approval-host-evidence-v1.schema.json",
  "title": "Local Approval Host v1 Mock Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "created_on",
    "branch",
    "baseline_commit",
    "evidence_scope",
    "browser_verification",
    "security_gates",
    "boundaries",
    "fixture_sha256",
    "commands",
    "boundary"
  ],
  "properties": {
    "version": { "const": "local-approval-host-evidence.v1" },
    "kind": { "const": "local_approval_host_v1_mock_evidence" },
    "created_on": { "type": "string", "pattern": "^20[0-9]{2}-[0-9]{2}-[0-9]{2}$" },
    "branch": { "type": "string", "minLength": 1 },
    "baseline_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "evidence_scope": { "const": "isolated_mock_browser_only" },
    "browser_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "browser_surface",
        "isolated_state",
        "setup_completed",
        "challenge_rendered",
        "untrusted_target_displayed",
        "script_element_count",
        "script_dialog_open",
        "decision_recorded",
        "public_decision_status",
        "credential_file_mode",
        "opaque_origin_handling"
      ],
      "properties": {
        "browser_surface": { "const": "controlled_chrome" },
        "isolated_state": { "const": true },
        "setup_completed": { "const": true },
        "challenge_rendered": { "const": true },
        "untrusted_target_displayed": { "const": true },
        "script_element_count": { "const": 0 },
        "script_dialog_open": { "const": false },
        "decision_recorded": { "const": true },
        "public_decision_status": { "const": "approved_pending_execution" },
        "credential_file_mode": { "const": "0600" },
        "opaque_origin_handling": { "const": "accepted_only_when_sec_fetch_site_same-origin" }
      }
    },
    "security_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loopback_only",
        "exact_host_required",
        "cross_site_origin_rejected",
        "csrf_required",
        "same_site_strict_cookie",
        "http_only_cookie",
        "per_decision_reauthentication",
        "authentication_throttled",
        "request_body_limited",
        "untrusted_html_escaped",
        "approval_token_server_private",
        "secret_echo_absent"
      ],
      "properties": {
        "loopback_only": { "const": true },
        "exact_host_required": { "const": true },
        "cross_site_origin_rejected": { "const": true },
        "csrf_required": { "const": true },
        "same_site_strict_cookie": { "const": true },
        "http_only_cookie": { "const": true },
        "per_decision_reauthentication": { "const": true },
        "authentication_throttled": { "const": true },
        "request_body_limited": { "const": true },
        "untrusted_html_escaped": { "const": true },
        "approval_token_server_private": { "const": true },
        "secret_echo_absent": { "const": true }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_user_approval",
        "live_queue_called",
        "sketchup_model_mutated",
        "reference_image_supplied",
        "release_acceptance"
      ],
      "properties": {
        "real_user_approval": { "const": false },
        "live_queue_called": { "const": false },
        "sketchup_model_mutated": { "const": false },
        "reference_image_supplied": { "const": false },
        "release_acceptance": { "const": false }
      }
    },
    "fixture_sha256": {
      "type": "object",
      "minProperties": 6,
      "propertyNames": { "pattern": "/" },
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "commands": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "live_queue_called"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "status": { "const": "passed" },
          "live_queue_called": { "const": false }
        }
      }
    },
    "boundary": { "type": "string", "minLength": 40 }
  }
}
