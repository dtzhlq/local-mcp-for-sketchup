{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/sketchup-mcp-replica/reference-visual-qa.schema.json",
  "title": "ReferenceVisualQA",
  "type": "object",
  "required": ["version", "title", "rules"],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "rules": {
      "type": "object",
      "properties": {
        "views": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/view" }
        },
        "silhouettes": {
          "type": "array",
          "items": { "$ref": "#/$defs/silhouette_rule" }
        },
        "keypoints": {
          "type": "array",
          "items": { "$ref": "#/$defs/keypoint_rule" }
        },
        "extent_ratios": {
          "type": "array",
          "items": { "$ref": "#/$defs/extent_ratio_rule" }
        },
        "area_ratios": {
          "type": "array",
          "items": { "$ref": "#/$defs/area_ratio_rule" }
        },
        "relative_positions": {
          "type": "array",
          "items": { "$ref": "#/$defs/relative_position_rule" }
        },
        "orientation": {
          "type": "array",
          "items": { "$ref": "#/$defs/orientation_rule" }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "view": {
      "type": "object",
      "required": ["name", "axes", "frame"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "axes": {
          "type": "array",
          "prefixItems": [{ "$ref": "#/$defs/axis" }, { "$ref": "#/$defs/axis" }],
          "minItems": 2,
          "maxItems": 2
        },
        "depth_axis": { "$ref": "#/$defs/axis" },
        "frame": { "$ref": "#/$defs/item_selector" }
      },
      "additionalProperties": false
    },
    "silhouette_rule": {
      "allOf": [
        { "$ref": "#/$defs/base_rule" },
        {
          "type": "object",
          "required": ["aspect_ratio"],
          "properties": {
            "aspect_ratio": { "type": "number", "exclusiveMinimum": 0 },
            "tolerance": { "type": "number", "minimum": 0 },
            "items": { "$ref": "#/$defs/ref_array" },
            "item": { "type": "string" },
            "match": { "type": "string" }
          }
        }
      ]
    },
    "keypoint_rule": {
      "allOf": [
        { "$ref": "#/$defs/base_rule" },
        {
          "type": "object",
          "required": ["item", "expected"],
          "properties": {
            "item": { "type": "string", "minLength": 1 },
            "point": { "enum": ["center", "min", "max", "top_left", "top_right", "bottom_left", "bottom_right"] },
            "expected": { "$ref": "#/$defs/point2" },
            "tolerance": { "type": "number", "minimum": 0 },
            "frame": { "$ref": "#/$defs/item_selector" }
          }
        }
      ]
    },
    "area_ratio_rule": {
      "allOf": [
        { "$ref": "#/$defs/base_rule" },
        {
          "type": "object",
          "required": ["expected"],
          "anyOf": [
            { "required": ["item"] },
            { "required": ["items"] }
          ],
          "properties": {
            "item": { "type": "string", "minLength": 1 },
            "items": { "$ref": "#/$defs/ref_array" },
            "expected": { "type": "number", "minimum": 0 },
            "tolerance": { "type": "number", "minimum": 0 },
            "frame": { "$ref": "#/$defs/item_selector" }
          }
        }
      ]
    },
    "extent_ratio_rule": {
      "allOf": [
        { "$ref": "#/$defs/base_rule" },
        {
          "type": "object",
          "required": ["expected"],
          "anyOf": [
            { "required": ["item"] },
            { "required": ["items"] }
          ],
          "properties": {
            "item": { "type": "string", "minLength": 1 },
            "items": { "$ref": "#/$defs/ref_array" },
            "expected": { "$ref": "#/$defs/point2" },
            "tolerance": {
              "oneOf": [
                { "type": "number", "minimum": 0 },
                { "$ref": "#/$defs/point2" }
              ]
            },
            "width_tolerance": { "type": "number", "minimum": 0 },
            "height_tolerance": { "type": "number", "minimum": 0 },
            "frame": { "$ref": "#/$defs/item_selector" }
          }
        }
      ]
    },
    "relative_position_rule": {
      "allOf": [
        { "$ref": "#/$defs/base_rule" },
        {
          "type": "object",
          "required": ["item", "anchor", "expected"],
          "properties": {
            "item": { "type": "string", "minLength": 1 },
            "anchor": { "type": "string", "minLength": 1 },
            "expected": { "$ref": "#/$defs/point2" },
            "tolerance": { "type": "number", "minimum": 0 },
            "frame": { "$ref": "#/$defs/item_selector" }
          }
        }
      ]
    },
    "orientation_rule": {
      "allOf": [
        { "$ref": "#/$defs/base_rule" },
        {
          "type": "object",
          "required": ["item", "anchor", "direction"],
          "properties": {
            "item": { "type": "string", "minLength": 1 },
            "anchor": { "type": "string", "minLength": 1 },
            "direction": { "enum": ["left_of", "right_of", "above", "below"] },
            "min_delta": { "type": "number", "minimum": 0 },
            "frame": { "$ref": "#/$defs/item_selector" }
          }
        }
      ]
    },
    "base_rule": {
      "type": "object",
      "required": ["id", "view", "correction_target"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "view": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warn", "error"] },
        "reason": { "type": "string" },
        "correction_target": {
          "type": "object",
          "required": ["path"],
          "properties": {
            "part_id": { "type": "string" },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "item_selector": {
      "type": "object",
      "properties": {
        "item": { "type": "string" },
        "items": { "$ref": "#/$defs/ref_array" },
        "match": { "type": "string" },
        "part_id": { "type": "string" }
      },
      "additionalProperties": false
    },
    "ref_array": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "point2": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "minItems": 2,
      "maxItems": 2
    },
    "axis": { "enum": ["x", "y", "z"] }
  }
}
