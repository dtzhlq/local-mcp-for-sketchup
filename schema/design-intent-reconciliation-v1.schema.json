{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/sketchup-mcp-replica/design-intent-reconciliation-v1.schema.json",
  "title": "Design Intent Reconciliation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "model_key", "design_graph_id", "previous_model_revision", "current_model_revision", "aligned", "expected_changes", "unexpected_divergence", "review_required", "silent_overwrite_allowed", "proposed_decisions", "reconciliation_id", "next_action"],
  "properties": {
    "version": { "const": "design-intent-reconciliation.v1" },
    "kind": { "const": "design_intent_reconciliation" },
    "model_key": { "type": "string", "pattern": "^model_[0-9a-f]{32}$" },
    "reconciliation_id": { "type": "string", "pattern": "^reconciliation-[0-9a-f]{24}$" },
    "design_graph_id": { "type": "string", "pattern": "^design-graph-[0-9a-f]{24}$" },
    "previous_model_revision": { "$ref": "#/$defs/hash" },
    "current_model_revision": { "$ref": "#/$defs/hash" },
    "aligned": { "type": "boolean" },
    "expected_changes": { "type": "array", "items": { "$ref": "#/$defs/divergence" } },
    "unexpected_divergence": { "type": "array", "items": { "$ref": "#/$defs/divergence" } },
    "review_required": { "type": "boolean" },
    "silent_overwrite_allowed": { "const": false },
    "proposed_decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
    "next_action": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["action"],
          "properties": { "action": { "const": "request_user_reconciliation_review" } }
        }
      ]
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "persistent_ref": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["target_id", "edit_scope"],
          "properties": { "target_id": { "type": "string", "minLength": 1 }, "edit_scope": { "const": "top_level" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity_path", "edit_scope", "instance_policy"],
          "properties": {
            "entity_path": { "type": "string", "minLength": 1 },
            "edit_scope": { "enum": ["top_level", "instance_path", "definition"] },
            "instance_policy": { "enum": ["definition_wide", "make_unique"] },
            "instance_id": { "type": "string", "minLength": 1 }
          },
          "allOf": [{ "if": { "properties": { "instance_policy": { "const": "make_unique" } } }, "then": { "required": ["instance_id"] } }]
        }
      ]
    },
    "divergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "persistent_ref", "expected_fingerprint", "current_fingerprint", "status", "candidate_count"],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "persistent_ref": { "$ref": "#/$defs/persistent_ref" },
        "expected_fingerprint": { "$ref": "#/$defs/hash" },
        "current_fingerprint": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/hash" }] },
        "status": { "enum": ["changed", "missing", "ambiguous"] },
        "candidate_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "binding_ids"],
      "properties": {
        "decision": { "enum": ["accept_reviewed_parameter_change", "adopt_manual_edit", "restore_design_intent"] },
        "binding_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
