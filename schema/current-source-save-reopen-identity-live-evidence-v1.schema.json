{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/sketchup-mcp-replica/current-source-save-reopen-identity-live-evidence-v1.schema.json",
  "title": "Current-source save/reopen identity live evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "captured_at",
    "branch",
    "result",
    "evidence_scope",
    "runtime",
    "execution_authorization",
    "report",
    "source_sha256",
    "artifact_sha256",
    "artifact_sizes",
    "acceptance",
    "boundaries"
  ],
  "properties": {
    "version": { "const": "current-source-save-reopen-identity-live-evidence.v1" },
    "kind": { "const": "current_source_save_reopen_identity_live_evidence" },
    "captured_at": { "type": "string", "format": "date-time" },
    "branch": { "const": "codex/agent-contract-v1" },
    "result": { "const": "pass" },
    "evidence_scope": { "const": "current_source_queue_distinct_path_save_reopen" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "server_version",
        "plugin_version",
        "sketchup_version",
        "ruby_version",
        "capability_version",
        "manifest_version",
        "dsl_version",
        "revision_strategy",
        "revision_source_sha256",
        "compatibility_ok"
      ],
      "properties": {
        "name": { "const": "queue" },
        "server_version": { "const": "0.1.0-rc.2" },
        "plugin_version": { "const": "0.1.0-rc.2" },
        "sketchup_version": { "const": "26.2.242" },
        "ruby_version": { "const": "3.2.2" },
        "capability_version": { "const": "0.1.0-rc.2-capabilities.7" },
        "manifest_version": { "const": "2026-07-agent-contract-v1.4" },
        "dsl_version": { "const": 1 },
        "revision_strategy": { "const": "definition-merkle.v2" },
        "revision_source_sha256": { "const": "b5c4c64c346c5abe1258be32c8027d542a4ccc28e2afc70c48debf3fcb886134" },
        "compatibility_ok": { "const": true }
      }
    },
    "execution_authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "user_authorized_disposable_copies",
        "queue_required",
        "allowed_runtimes_explicit",
        "queue_mutation_explicit",
        "direct_expert_mutation_explicit",
        "policy_persisted",
        "default_policy_unchanged"
      ],
      "properties": {
        "mode": { "const": "local_operator_ephemeral_process_policy" },
        "user_authorized_disposable_copies": { "const": true },
        "queue_required": { "const": true },
        "allowed_runtimes_explicit": { "const": true },
        "queue_mutation_explicit": { "const": true },
        "direct_expert_mutation_explicit": { "const": true },
        "policy_persisted": { "const": false },
        "default_policy_unchanged": { "const": true }
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "contract_version",
        "live_proof",
        "destructive_opt_in_observed",
        "model_revision_before",
        "model_revision_after",
        "revision_exact_match",
        "source_exact_match",
        "after_reopen_clean",
        "path_switch_verified",
        "active_source_path_verified",
        "entries_before",
        "entries_after",
        "identity_exact_match",
        "shared_leaf_occurrences",
        "face_edge_entries",
        "snapshot_diff_count",
        "snapshot_verdict",
        "queue_clean"
      ],
      "properties": {
        "path": { "const": "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-identity-report.json" },
        "contract_version": { "const": "save-reopen-identity-report.v2" },
