        "destructive_opt_in_observed": { "const": true },
        "model_revision_before": { "$ref": "#/$defs/modelRevision" },
        "model_revision_after": { "$ref": "#/$defs/modelRevision" },
        "revision_exact_match": { "const": true },
        "source_exact_match": { "const": true },
        "after_reopen_clean": { "const": true },
        "path_switch_verified": { "const": true },
        "active_source_path_verified": { "const": true },
        "entries_before": { "const": 42 },
        "entries_after": { "const": 42 },
        "identity_exact_match": { "const": true },
        "shared_leaf_occurrences": { "const": 2 },
        "face_edge_entries": { "const": 36 },
        "snapshot_diff_count": { "const": 0 },
        "snapshot_verdict": { "const": "pass" },
        "queue_clean": { "$ref": "#/$defs/cleanQueue" }
      }
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scripts/validate-save-reopen-identity.mjs",
        "schema/save-reopen-identity-report-v2.schema.json",
        "src/bridge.mjs",
        "sketchup_plugin/alma_sketchup_mcp/model_revision.rb"
      ],
      "properties": {
        "scripts/validate-save-reopen-identity.mjs": { "$ref": "#/$defs/sha256" },
        "schema/save-reopen-identity-report-v2.schema.json": { "$ref": "#/$defs/sha256" },
        "src/bridge.mjs": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/alma_sketchup_mcp/model_revision.rb": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-identity-report.json",
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/target.skp",
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/intermediary.skp",
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-snapshot-diff.json",
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-checkpoint.json"
      ],
      "properties": {
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-identity-report.json": { "$ref": "#/$defs/sha256" },
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/target.skp": { "$ref": "#/$defs/sha256" },
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/intermediary.skp": { "$ref": "#/$defs/sha256" },
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-snapshot-diff.json": { "$ref": "#/$defs/sha256" },
        "output/live-validation/save-reopen-identity/current-source-2026-07-22-v1/save-reopen-checkpoint.json": { "$ref": "#/$defs/sha256" }
      }
    },
    "artifact_sizes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_skp_bytes", "intermediary_skp_bytes", "checkpoint_bytes"],
      "properties": {
        "target_skp_bytes": { "const": 19990 },
        "intermediary_skp_bytes": { "const": 17381 },
        "checkpoint_bytes": { "const": 396507 }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_source_live_save_reopen",
        "persistent_occurrence_identity",
        "model_revision_stability",
        "zero_tolerance_snapshot",
        "feature_history_lineage",
        "manual_divergence_reconciliation",
        "multi_model_native_corpus",
        "cross_version",
        "release_acceptance"
      ],
      "properties": {
        "current_source_live_save_reopen": { "const": true },
        "persistent_occurrence_identity": { "const": true },
        "model_revision_stability": { "const": true },
        "zero_tolerance_snapshot": { "const": true },
        "feature_history_lineage": { "const": false },
        "manual_divergence_reconciliation": { "const": false },
        "multi_model_native_corpus": { "const": false },
        "cross_version": { "const": "deferred_by_user" },
        "release_acceptance": { "const": false }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 4,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "modelRevision": { "const": "sha256:406f4db9bb35be1d783110f94bd5eefb021552ea6790c9780ef36690e459acb8" },
    "cleanQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue", "processing", "responses", "lock"],
      "properties": {
        "queue": { "const": 0 },
        "processing": { "const": 0 },
        "responses": { "const": 0 },
        "lock": { "const": false }
      }
    }
  }
}
