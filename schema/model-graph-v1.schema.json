{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/local-mcp-for-sketchup/model-graph-v1.schema.json",
  "title": "ModelGraph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "model_revision", "runtime", "source_adoption_version", "source_adoption_hash", "completeness", "nodes", "relationships", "catalogs", "lineage", "untrusted_data_fields", "graph_id", "stats"],
  "properties": {
    "version": { "const": "model-graph.v1" },
    "kind": { "const": "model_graph" },
    "graph_id": { "type": "string", "pattern": "^model-graph-[0-9a-f]{24}$" },
    "model_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "runtime": { "enum": ["mock", "queue"] },
    "source_adoption_version": { "type": "string", "minLength": 1 },
    "source_adoption_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recursive_requested", "recursive_truncated", "recursive_total_seen", "recursive_indexed", "occurrence_contract", "complete", "blockers"],
      "properties": {
        "recursive_requested": { "type": "boolean" },
        "recursive_truncated": { "type": "boolean" },
        "recursive_total_seen": { "type": "integer", "minimum": 0 },
        "recursive_indexed": { "type": "integer", "minimum": 0 },
        "occurrence_contract": { "enum": ["canonical-occurrence-path.v1", "unsupported"] },
        "complete": { "type": "boolean" },
        "blockers": { "type": "array", "uniqueItems": true, "items": { "enum": ["recursive_index_not_requested", "recursive_index_truncated", "occurrence_contract_mismatch", "recursive_count_mismatch", "missing_entity_path", "duplicate_entity_path", "occurrence_path_not_closed"] } }
      }
    },
    "projections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structural_groups"],
      "properties": {
        "structural_groups": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version", "complete", "total_seen", "total_seen_exact", "indexed", "truncated", "limit",
            "eligible_entity_types", "leaf_entities_materialized", "coordinate_space", "proposal_only", "execution_allowed"
          ],
          "properties": {
            "version": { "const": "structural-groups.v1" },
            "complete": { "type": "boolean" },
            "total_seen": { "type": "integer", "minimum": 0 },
            "total_seen_exact": { "type": "boolean" },
            "indexed": { "type": "integer", "minimum": 0 },
            "truncated": { "type": "boolean" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 5000 },
            "eligible_entity_types": {
              "type": "array",
              "const": ["group"]
            },
            "leaf_entities_materialized": { "const": false },
            "coordinate_space": { "const": "model_world" },
            "proposal_only": { "const": true },
            "execution_allowed": { "const": false }
          }
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "node_type", "trust", "source"],
        "properties": {
          "node_id": { "type": "string", "pattern": "^node_[0-9a-f]{24}$" },
          "node_type": { "enum": ["model", "occurrence", "definition", "feature", "artifact"] },
          "model_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "entity_path": { "type": ["string", "null"] },
          "parent_entity_path": { "type": ["string", "null"] },
          "path_segments": { "type": "array", "items": { "$ref": "#/$defs/path_segment" } },
          "parent_id": { "type": ["string", "null"] },
          "reference": { "type": ["string", "number", "null"] },
          "persistent_id": { "type": ["string", "number", "null"] },
          "entity_type": { "type": "string" },
          "name": { "type": ["string", "null"] },
          "kind": { "type": ["string", "null"] },
          "definition_name": { "type": ["string", "null"] },
          "definition_persistent_id": { "type": ["string", "number", "null"] },
          "entity_definition_name": { "type": ["string", "null"] },
          "entity_definition_persistent_id": { "type": ["string", "number", "null"] },
          "material": { "type": ["string", "null"] },
          "back_material": { "type": ["string", "null"] },
          "tag": { "type": ["string", "null"] },
          "classification": {},
          "native_classification": { "anyOf": [{ "$ref": "#/$defs/native_classification_summary" }, { "type": "null" }] },
          "attributes": {},
          "texture_transform": {},
          "face_uvs": {},
          "transform": {},
          "transformation": {},
          "world_transform": {},
          "geometry_summary": { "anyOf": [{ "$ref": "#/$defs/geometry_summary" }, { "type": "null" }] },
          "visible": { "type": "boolean" },
          "locked": { "type": "boolean" },
          "effective_locked": { "type": "boolean" },
          "locked_ancestor_path": { "type": ["string", "null"] },
          "soft": { "type": "boolean" },
          "smooth": { "type": "boolean" },
          "reversed": { "type": "boolean" },
          "editable": { "type": "boolean" },
          "edit_scope": { "type": "string" },
          "allowed_operations": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "bounding_box": { "anyOf": [{ "$ref": "#/$defs/bounding_box" }, { "type": "null" }] },
          "spatial_summary": { "anyOf": [{ "$ref": "#/$defs/spatial_summary" }, { "type": "null" }] },
          "topology_summary": { "$ref": "#/$defs/topology_summary" },
          "features": { "type": "array" },
          "shared_definition": { "type": "boolean" },
          "affected_instance_count": { "type": "integer", "minimum": 0 },
          "instance_policy_required": { "type": "boolean" },
          "warning": { "type": ["string", "null"] },
          "synthetic": { "type": "boolean" },
          "proposal_eligible": { "type": "boolean" },
          "projection_source": { "const": "structural-groups.v1" },
          "occurrence_count": { "type": "integer", "minimum": 0 },
          "feature_type": { "type": "string" },
          "feature_id": { "type": ["string", "number", "null"] },
          "summary": {},
          "artifact_kind": { "enum": ["part_graph", "parametric_recipe", "feature_mapping_plan", "evidence", "design_intent_graph", "generic_json", "binary"] },
          "artifact_handle": { "type": "string", "pattern": "^artifact:task_[0-9a-f-]+:[0-9a-f-]+$" },
          "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "source_task_id": { "type": "string", "pattern": "^task_[0-9a-f-]+$" },
          "label": { "type": "string" },
          "media_type": { "type": "string" },
          "provenance_trust": { "const": "server_artifact_handle" },
          "policy_effect": { "const": "none" },
          "trust": { "enum": ["untrusted_data", "server_derived"] },
          "source": { "enum": ["sketchup_model", "model_revision", "agent_task_artifact"] }
        },
        "allOf": [
          {
            "if": { "properties": { "node_type": { "const": "model" } }, "required": ["node_type"] },
            "then": { "required": ["model_revision"] }
          },
          {
            "if": { "properties": { "node_type": { "const": "occurrence" } }, "required": ["node_type"] },
            "then": {
              "required": [
                "entity_path", "parent_entity_path", "path_segments", "parent_id", "reference", "persistent_id", "entity_type",
                "name", "kind", "definition_name", "definition_persistent_id", "entity_definition_name", "entity_definition_persistent_id",
                "material", "back_material", "tag", "classification", "attributes", "texture_transform", "face_uvs", "transform",
                "transformation", "world_transform", "geometry_summary", "visible", "locked", "effective_locked", "locked_ancestor_path", "soft", "smooth", "reversed", "editable",
                "edit_scope", "allowed_operations", "bounding_box", "spatial_summary", "topology_summary", "features", "shared_definition",
                "affected_instance_count", "instance_policy_required", "warning", "synthetic"
              ]
            }
          },
          {
            "if": { "properties": { "node_type": { "const": "definition" } }, "required": ["node_type"] },
            "then": { "required": ["name", "persistent_id", "occurrence_count"] }
          },
          {
            "if": { "properties": { "node_type": { "const": "feature" } }, "required": ["node_type"] },
            "then": { "required": ["feature_type", "feature_id", "summary"] }
          },
          {
            "if": { "properties": { "node_type": { "const": "artifact" } }, "required": ["node_type"] },
            "then": { "required": ["artifact_kind", "artifact_handle", "content_sha256", "source_task_id", "label", "media_type", "provenance_trust", "policy_effect"] }
          }
        ]
      }
    },
    "relationships": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hierarchy", "definition_membership", "topology", "spatial", "lineage"],
      "properties": {
        "hierarchy": { "$ref": "#/$defs/relationships" },
        "definition_membership": { "$ref": "#/$defs/relationships" },
        "topology": { "$ref": "#/$defs/relationships" },
        "spatial": { "$ref": "#/$defs/relationships" },
        "lineage": { "$ref": "#/$defs/relationships" }
      }
    },
    "catalogs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["materials", "tags", "scenes", "classifications", "classification_schemas", "native_classification_summaries"],
      "properties": {
        "materials": { "type": "array" },
        "tags": { "type": "array" },
        "scenes": { "type": "array" },
        "classifications": { "type": "array" },
        "classification_schemas": { "type": "array", "items": { "$ref": "#/$defs/classification_schema" } },
        "native_classification_summaries": { "type": "array", "items": { "$ref": "#/$defs/native_classification_summary" } }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["part_graph", "parametric_recipe", "feature_mapping_plan", "evidence", "trusted_artifacts", "untrusted_claims"],
      "properties": {
        "part_graph": { "type": ["string", "null"] },
        "parametric_recipe": { "type": ["string", "null"] },
        "feature_mapping_plan": { "type": ["string", "null"] },
        "evidence": { "type": "array", "items": { "type": "string", "pattern": "^artifact:" } },
        "trusted_artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["handle", "artifact_kind", "content_sha256", "source_task_id", "label", "media_type", "provenance_trust", "content_trust", "policy_effect"],
            "properties": {
              "handle": { "type": "string", "pattern": "^artifact:task_[0-9a-f-]+:[0-9a-f-]+$" },
              "artifact_kind": { "enum": ["part_graph", "parametric_recipe", "feature_mapping_plan", "evidence", "design_intent_graph", "generic_json", "binary"] },
              "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
              "source_task_id": { "type": "string", "pattern": "^task_[0-9a-f-]+$" },
              "label": { "type": "string" },
              "media_type": { "type": "string" },
              "provenance_trust": { "const": "server_artifact_handle" },
              "content_trust": { "const": "untrusted_data" },
              "policy_effect": { "const": "none" }
            }
          }
        },
        "untrusted_claims": { "$ref": "#/$defs/untrusted" }
      }
    },
    "untrusted_data_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "stats": {
      "type": "object",
      "required": ["nodes", "occurrences", "definitions", "faces", "edges", "shared_occurrences", "hierarchy_relationships", "spatial_relationships", "topology_relationships", "lineage_relationships"],
      "additionalProperties": false,
      "properties": {
        "nodes": { "type": "integer", "minimum": 0 },
        "occurrences": { "type": "integer", "minimum": 0 },
        "definitions": { "type": "integer", "minimum": 0 },
        "faces": { "type": "integer", "minimum": 0 },
        "edges": { "type": "integer", "minimum": 0 },
        "shared_occurrences": { "type": "integer", "minimum": 0 },
        "hierarchy_relationships": { "type": "integer", "minimum": 0 },
        "spatial_relationships": { "type": "integer", "minimum": 0 },
        "topology_relationships": { "type": "integer", "minimum": 0 },
        "lineage_relationships": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "untrusted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "source", "value", "policy_effect"],
      "properties": {
        "trust": { "const": "untrusted_data" },
        "source": { "const": "agent_lineage_claims" },
        "value": { "type": "object" },
        "policy_effect": { "const": "none" }
      }
    },
    "classification_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "namespace"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "namespace": { "type": ["string", "null"] }
      }
    },
    "native_classification_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version", "source", "trust", "policy_effect", "loaded_schema_names", "value_lookup_supported",
        "assignment_enumeration", "assignment_presence", "assigned_type_count", "definition_attribute_fingerprint",
        "fingerprint_coverage", "attribute_dictionary_count", "attribute_key_count", "values_exposed", "complete", "blockers"
      ],
      "properties": {
        "version": { "const": "sketchup-native-classification-summary.v1" },
        "source": { "const": "sketchup_component_definition" },
        "trust": { "const": "untrusted_data" },
        "policy_effect": { "const": "none" },
        "loaded_schema_names": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "value_lookup_supported": { "type": "boolean" },
        "assignment_enumeration": { "const": "unsupported_by_sketchup_ruby_api" },
        "assignment_presence": { "const": "unknown" },
        "assigned_type_count": { "type": "null" },
        "definition_attribute_fingerprint": { "anyOf": [{ "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }, { "type": "null" }] },
        "fingerprint_coverage": { "const": "all_definition_attribute_dictionaries" },
        "attribute_dictionary_count": { "type": "integer", "minimum": 0 },
        "attribute_key_count": { "type": "integer", "minimum": 0 },
        "values_exposed": { "const": false },
        "complete": { "const": false },
        "blockers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "assigned_schema_types_not_enumerable" },
          "items": { "enum": ["assigned_schema_types_not_enumerable", "classification_value_lookup_unavailable", "definition_attribute_fingerprint_unavailable"] }
        }
      }
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" }
    },
    "path_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_type", "persistent_id", "reference"],
      "properties": {
        "entity_type": { "enum": ["group", "component_instance", "face", "edge", "unknown"] },
        "persistent_id": { "type": ["string", "number", "null"] },
        "reference": { "type": ["string", "number", "null"] }
      }
    },
    "bounding_box": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max", "w", "d", "h"],
      "properties": {
        "min": { "$ref": "#/$defs/vector3" },
        "max": { "$ref": "#/$defs/vector3" },
        "w": { "type": "number" },
        "d": { "type": "number" },
        "h": { "type": "number" }
      }
    },
    "spatial_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "size", "volume", "coordinate_space"],
      "properties": {
        "center": { "$ref": "#/$defs/vector3" },
        "size": { "$ref": "#/$defs/vector3" },
        "volume": { "type": "number", "minimum": 0 },
        "coordinate_space": { "enum": ["parent_scope", "model_world"] }
      }
    },
    "topology_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["faces", "edges", "vertices"],
      "properties": {
        "faces": { "type": "number", "minimum": 0 },
        "edges": { "type": "number", "minimum": 0 },
        "vertices": { "type": "number", "minimum": 0 }
      }
    },
    "geometry_summary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "normal", "area_mm2", "outer_loop", "holes", "loop_count", "edge_count", "vertex_count"],
          "properties": {
            "type": { "const": "face" },
            "normal": { "$ref": "#/$defs/vector3" },
            "area_mm2": { "type": "number", "minimum": 0 },
            "outer_loop": { "type": "array", "items": { "$ref": "#/$defs/vector3" } },
            "holes": { "type": "array", "items": { "type": "array", "items": { "$ref": "#/$defs/vector3" } } },
            "loop_count": { "type": "integer", "minimum": 0 },
            "edge_count": { "type": "integer", "minimum": 0 },
            "vertex_count": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "length_mm", "endpoints", "adjacent_face_count", "soft", "smooth"],
          "properties": {
            "type": { "const": "edge" },
            "length_mm": { "type": "number", "minimum": 0 },
            "endpoints": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/vector3" } },
            "adjacent_face_count": { "type": "integer", "minimum": 0 },
            "soft": { "type": "boolean" },
            "smooth": { "type": "boolean" }
          }
        }
      ]
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "from", "to"],
        "properties": {
          "type": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  }
}
