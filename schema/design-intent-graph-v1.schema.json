{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/local-mcp-for-sketchup/design-intent-graph-v1.schema.json",
  "title": "DesignIntentGraph v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "model_key", "source_model_graph_id", "model_revision", "artifacts", "parameters", "bindings", "relationships", "bidirectional", "correction_history", "divergence_policy", "untrusted_data_fields", "design_graph_id", "stats"],
  "properties": {
    "version": { "const": "design-intent-graph.v1" },
    "kind": { "const": "design_intent_graph" },
    "model_key": { "$ref": "#/$defs/model_key" },
    "design_graph_id": { "$ref": "#/$defs/design_graph_id" },
    "source_model_graph_id": { "$ref": "#/$defs/model_graph_id" },
    "model_revision": { "$ref": "#/$defs/hash" },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parametric_recipe", "feature_mapping_plan", "part_graph"],
      "properties": {
        "parametric_recipe": { "$ref": "#/$defs/artifact_ref_or_null" },
        "feature_mapping_plan": { "$ref": "#/$defs/artifact_ref_or_null" },
        "part_graph": { "$ref": "#/$defs/artifact_ref_or_null" }
      }
    },
    "parameters": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/parameter" } },
    "bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/binding" } },
    "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
    "bidirectional": { "$ref": "#/$defs/bidirectional" },
    "correction_history": { "type": "array", "items": { "$ref": "#/$defs/correction_event" } },
    "divergence_policy": { "const": "review_required_no_silent_overwrite" },
    "untrusted_data_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameters", "bindings", "mapped_entities", "correction_events"],
      "properties": {
        "parameters": { "type": "integer", "minimum": 1 },
        "bindings": { "type": "integer", "minimum": 1 },
        "mapped_entities": { "type": "integer", "minimum": 1 },
        "correction_events": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "model_key": { "type": "string", "pattern": "^model_[0-9a-f]{32}$" },
    "design_graph_id": { "type": "string", "pattern": "^design-graph-[0-9a-f]{24}$" },
    "model_graph_id": { "type": "string", "pattern": "^model-graph-[0-9a-f]{24}$" },
    "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "json_value": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/json_value" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/json_value" } }
      ]
    },
    "artifact_ref_or_null": {
      "oneOf": [
        { "type": "null" },
        { "$ref": "#/$defs/artifact_ref" }
      ]
    },
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": ["string", "null"] },
        "version": { "type": ["string", "number", "null"] },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "value", "type", "unit", "minimum", "maximum", "enum", "description"],
      "properties": {
        "parameter_id": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/json_value" },
        "type": { "type": "string", "minLength": 1 },
        "unit": { "type": ["string", "null"] },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "enum": { "oneOf": [{ "type": "null" }, { "type": "array", "items": { "$ref": "#/$defs/json_value" } }] },
        "description": { "type": ["string", "null"] }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["binding_id", "part_id", "feature_id", "entity_node_id", "persistent_ref", "baseline_fingerprint", "resolved_entities", "parameter_bindings", "associated_binding_ids", "existing_targets", "erase_before_rebuild", "rebuild_template", "repeat", "lineage"],
      "properties": {
        "binding_id": { "type": "string", "minLength": 1 },
        "part_id": { "type": ["string", "null"] },
        "feature_id": { "type": ["string", "null"] },
        "entity_node_id": { "$ref": "#/$defs/node_id" },
        "persistent_ref": { "$ref": "#/$defs/persistent_ref" },
        "baseline_fingerprint": { "$ref": "#/$defs/hash" },
        "resolved_entities": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/resolved_entity" } },
        "parameter_bindings": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/parameter_binding" } },
        "associated_binding_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "existing_targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/persistent_ref" } },
        "erase_before_rebuild": { "type": "boolean" },
        "rebuild_template": { "type": "array", "items": { "$ref": "#/$defs/dsl_operation" } },
        "repeat": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/repeat" }] },
        "lineage": { "type": "object", "additionalProperties": { "$ref": "#/$defs/json_value" } }
      }
    },
    "parameter_binding": {
      "type": "object",
      "required": ["parameter_id"],
      "properties": { "parameter_id": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "$ref": "#/$defs/json_value" }
    },
    "resolved_entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_node_id", "persistent_ref", "baseline_fingerprint"],
      "properties": {
        "entity_node_id": { "$ref": "#/$defs/node_id" },
        "persistent_ref": { "$ref": "#/$defs/persistent_ref" },
        "baseline_fingerprint": { "$ref": "#/$defs/hash" }
      }
    },
    "node_id": { "type": "string", "pattern": "^node_[0-9a-f]{24}$" },
    "persistent_ref": {
      "oneOf": [
        { "$ref": "#/$defs/top_level_ref" },
        { "$ref": "#/$defs/occurrence_ref" }
      ]
    },
    "top_level_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_id", "edit_scope"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "edit_scope": { "const": "top_level" }
      }
    },
    "occurrence_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_path", "edit_scope", "instance_policy"],
      "properties": {
        "entity_path": { "type": "string", "minLength": 1 },
        "edit_scope": { "enum": ["top_level", "instance_path", "definition"] },
        "instance_policy": { "enum": ["definition_wide", "make_unique"] },
        "instance_id": { "type": "string", "minLength": 1 }
      },
      "allOf": [{ "if": { "properties": { "instance_policy": { "const": "make_unique" } } }, "then": { "required": ["instance_id"] } }]
    },
    "repeat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count_parameter"],
      "properties": {
        "count_parameter": { "type": "string", "minLength": 1 },
        "index_base": { "type": "integer" }
      }
    },
    "dsl_operation": {
      "type": "object",
      "required": ["op"],
      "properties": { "op": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "$ref": "#/$defs/json_value" }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "from", "to"],
      "properties": {
        "type": { "enum": ["parameter_controls_entity", "part_maps_to_entity", "feature_maps_to_entity", "associated_rebuild"] },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 }
      }
    },
    "bidirectional": {
      "type": "object",
      "additionalProperties": false,
      "required": ["design_to_entities", "entity_to_design"],
      "properties": {
        "design_to_entities": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } },
        "entity_to_design": { "type": "object", "additionalProperties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } } }
      }
    },
    "correction_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "at", "decision", "reconciliation_id", "change_plan_id", "previous_model_revision", "current_model_revision"],
      "properties": {
        "event_id": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["accept_reviewed_parameter_change", "adopt_manual_edit", "restore_design_intent"] },
        "reconciliation_id": { "type": "string", "pattern": "^reconciliation-[0-9a-f]{24}$" },
        "change_plan_id": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^design-change-[0-9a-f]{24}$" }] },
        "previous_model_revision": { "$ref": "#/$defs/hash" },
        "current_model_revision": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
