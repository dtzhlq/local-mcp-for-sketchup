{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/schema/independent-agent-compatibility-evidence-v2.schema.json",
  "title": "IndependentAgentCompatibilityEvidenceV2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "created_at",
    "runtime",
    "agent",
    "isolation",
    "fixture",
    "observed_workflow",
    "audit",
    "hard_gates",
    "artifacts",
    "scope",
    "prior_fixture_evidence",
    "aggregate",
    "release_acceptance"
  ],
  "properties": {
    "version": { "const": "independent-agent-compatibility-evidence.v2" },
    "kind": { "const": "independent_agent_compatibility_evidence" },
    "created_at": { "type": "string", "format": "date-time" },
    "runtime": { "const": "mock" },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "independent_process",
        "implementation",
        "cli_version",
        "model",
        "vendor_diversification_proven",
        "model_diversification_proven",
        "final_response_schema_valid",
        "fixture_diversification_proven"
      ],
      "properties": {
        "independent_process": { "const": true },
        "implementation": { "const": "codex_cli" },
        "cli_version": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "vendor_diversification_proven": { "const": false },
        "model_diversification_proven": { "const": false },
        "final_response_schema_valid": { "const": true },
        "fixture_diversification_proven": { "const": true }
      }
    },
    "isolation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ephemeral_session",
        "outside_repository_working_directory",
        "workspace_write_sandbox",
        "allowed_gateway_tools",
        "gateway_profile",
        "queue_called",
        "approval_material_exposed"
      ],
      "properties": {
        "ephemeral_session": { "const": true },
        "outside_repository_working_directory": { "const": true },
        "workspace_write_sandbox": { "const": true },
        "allowed_gateway_tools": {
          "const": [
            "start_agent_task",
            "resume_agent_task",
            "submit_agent_task_input",
            "read_agent_artifact"
          ]
        },
        "gateway_profile": { "const": "L0" },
        "queue_called": { "const": false },
        "approval_material_exposed": { "const": false }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "candidate_names",
        "revision_before",
        "revision_after",
        "revision_unchanged"
      ],
      "properties": {
        "kind": { "const": "two_shared_survey_pod_component_instances" },
        "candidate_names": { "const": ["Survey_Pod_A", "Survey_Pod_B"] },
        "revision_before": { "$ref": "#/$defs/hash" },
        "revision_after": { "$ref": "#/$defs/hash" },
        "revision_unchanged": { "const": true }
      }
    },
    "observed_workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "understand_completed",
        "same_request_replayed",
        "same_task_resumed",
        "ambiguous_edit_awaiting_input",
        "ambiguous_edit_execution_allowed",
        "unexpected_tool_calls",
        "agent_final_claims_match_audit"
      ],
      "properties": {
        "understand_completed": { "const": true },
        "same_request_replayed": { "const": true },
        "same_task_resumed": { "const": true },
        "ambiguous_edit_awaiting_input": { "const": true },
        "ambiguous_edit_execution_allowed": { "const": false },
        "unexpected_tool_calls": { "const": 0 },
        "agent_final_claims_match_audit": { "const": true }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "event_count",
        "expected_sequence",
        "hash_chain_valid",
        "audit_sha256",
        "transcript_sha256",
        "final_response_sha256"
      ],
      "properties": {
        "source": { "const": "server_side_gateway_adapter" },
        "event_count": { "const": 4 },
        "expected_sequence": {
          "const": [
            "start_agent_task",
            "start_agent_task",
            "resume_agent_task",
            "start_agent_task"
          ]
        },
        "hash_chain_valid": { "const": true },
        "audit_sha256": { "$ref": "#/$defs/hash" },
        "transcript_sha256": { "$ref": "#/$defs/hash" },
        "final_response_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "hard_gates": { "$ref": "#/$defs/hard_gates" },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes"],
        "properties": {
          "name": {
            "enum": [
              "agent-events.jsonl",
              "agent-final.json",
              "gateway-audit.jsonl"
            ]
          },
          "sha256": { "$ref": "#/$defs/hash" },
          "bytes": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "live_sketchup",
        "real_agent_process",
        "multi_vendor",
        "visual_input",
        "local_model_files",
        "notes"
      ],
      "properties": {
        "live_sketchup": { "const": false },
        "real_agent_process": { "const": true },
        "multi_vendor": { "const": false },
        "visual_input": { "const": false },
        "local_model_files": { "const": false },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "prior_fixture_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "fixture_kind", "gateway_event_count"],
      "properties": {
        "path": {
          "const": "docs/evidence/independent-agent-compatibility-evidence-2026-07-23.json"
        },
        "sha256": { "$ref": "#/$defs/hash" },
        "fixture_kind": { "const": "two_equal_ambiguous_cabinets" },
        "gateway_event_count": { "const": 4 }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_count",
        "independent_process_runs",
        "fixture_kinds",
        "gateway_event_count",
        "wrong_object_automatic_execution",
        "unauthorized_s2_s4_execution",
        "duplicate_request_duplicate_modification"
      ],
      "properties": {
        "fixture_count": { "const": 2 },
        "independent_process_runs": { "const": 2 },
        "fixture_kinds": {
          "const": [
            "two_equal_ambiguous_cabinets",
            "two_shared_survey_pod_component_instances"
          ]
        },
        "gateway_event_count": { "const": 8 },
        "wrong_object_automatic_execution": { "const": 0 },
        "unauthorized_s2_s4_execution": { "const": 0 },
        "duplicate_request_duplicate_modification": { "const": 0 }
      }
    },
    "release_acceptance": { "const": false }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "hard_gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wrong_object_automatic_execution",
        "unauthorized_s2_s4_execution",
        "duplicate_request_duplicate_modification"
      ],
      "properties": {
        "wrong_object_automatic_execution": { "const": 0 },
        "unauthorized_s2_s4_execution": { "const": 0 },
        "duplicate_request_duplicate_modification": { "const": 0 }
      }
    }
  }
}
