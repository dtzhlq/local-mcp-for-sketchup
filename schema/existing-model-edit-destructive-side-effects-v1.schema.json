{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/schema/existing-model-edit-destructive-side-effects-v1.schema.json",
  "title": "Existing-model destructive side effects",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "inference", "content_trust", "expected_absent_targets"],
  "properties": {
    "version": { "const": "existing-model-edit-destructive-side-effects.v1" },
    "inference": { "const": "server_adoption_index" },
    "content_trust": { "const": "trusted_server_projection" },
    "expected_absent_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/expectedAbsentTarget" }
    }
  },
  "$defs": {
    "entityPath": {
      "type": "string",
      "pattern": "^(pid:[1-9][0-9]*(\\.[1-9][0-9]*)*|mock:(group|component_instance|face|edge):[A-Za-z0-9_-]+(/(group|component_instance|face|edge):[A-Za-z0-9_-]+)*)$"
    },
    "expectedAbsentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entity_path", "parent_entity_path", "edit_scope", "instance_policy", "reason", "postcondition", "caused_by_absent_children", "entity"],
      "properties": {
        "entity_path": { "$ref": "#/$defs/entityPath" },
        "parent_entity_path": {
          "anyOf": [
            { "$ref": "#/$defs/entityPath" },
            { "type": "null" }
          ]
        },
        "edit_scope": { "const": "instance_path" },
        "instance_policy": { "const": "definition_wide" },
        "reason": { "enum": ["sketchup_empty_group_cleanup"] },
        "postcondition": { "const": "absent_after_commit" },
        "caused_by_absent_children": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/entityPath" }
        },
        "entity": {
          "type": "object",
          "required": ["entity_path", "entity_type", "affected_instance_count", "shared_definition", "allowed_operations"],
          "properties": {
            "entity_path": { "$ref": "#/$defs/entityPath" },
            "entity_type": { "enum": ["group", "component_instance"] },
            "affected_instance_count": { "type": "integer", "minimum": 1 },
            "shared_definition": { "type": "boolean" },
            "allowed_operations": {
              "type": "array",
              "uniqueItems": true,
              "items": { "type": "string", "minLength": 1 }
            }
          },
          "additionalProperties": true
        }
      }
    }
  }
}
