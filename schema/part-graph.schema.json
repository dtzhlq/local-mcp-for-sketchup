{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/local-mcp-for-sketchup/part-graph.schema.json",
  "title": "PartGraph",
  "type": "object",
  "required": [
    "version",
    "id",
    "profile_id",
    "product",
    "units",
    "parts"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "dsl_version": {
      "type": "integer",
      "minimum": 1
    },
    "units": {
      "const": "mm"
    },
    "product": {
      "type": "object",
      "required": [
        "type",
        "name"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        }
      }
    },
    "scale": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calibration": {
          "type": "object"
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        }
      }
    },
    "evidence_graph": {
      "type": "object",
      "properties": {
        "version": {
          "const": 1
        },
        "source_images": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "views_detected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scale_calibration": {
          "type": "object"
        },
        "ground_plan": {
          "type": "object"
        },
        "grounding_v3": {
          "type": "object"
        },
        "part_matches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/part_match"
          }
        },
        "visual_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visual_relation"
          }
        },
        "parts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_graph_part"
          }
        }
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/part"
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/graph_operation"
      }
    },
    "physical_relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/physical_relation"
      }
    },
    "review": {
      "type": "object",
      "properties": {
        "fallback_summary": {
          "type": "object"
        },
        "parameter_proposal_summary": {
          "type": "object"
        },
        "parameter_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_proposal"
          }
        },
        "part_candidate_proposal_summary": {
          "type": "object"
        },
        "part_candidate_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_proposal"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "correction_targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/correction_target"
          }
        }
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": [
        "id",
        "name",
        "type",
        "role",
        "evidence_status",
        "fallback_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "parent": {
          "type": "string"
        },
        "material": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "shape": {
          "$ref": "#/$defs/shape"
        },
        "candidate_shape": {
          "$ref": "#/$defs/shape"
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relationship"
          }
        },
        "physical_relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/physical_relation"
          }
        },
        "evidence_status": {
          "$ref": "#/$defs/evidence_status"
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "grounding_status": {
          "$ref": "#/$defs/grounding_status"
        },
        "grounding_method": {
          "type": ["string", "null"]
        },
        "source_observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grounding_decision": {
          "$ref": "#/$defs/grounding_decision"
        },
        "grounding_region_id": {
          "type": "string"
        },
        "projection_residuals": {
          "type": ["object", "null"]
        },
        "review_required": {
          "type": "boolean"
        },
        "helper_allowed": {
          "type": "boolean"
        },
        "photo_grade_eligible": {
          "type": "boolean"
        },
        "fallback_state": {
          "$ref": "#/$defs/fallback_state"
        },
        "parameter_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_proposal"
          }
        },
        "feature_intents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature_intent"
          }
        },
        "qa": {
          "type": "object"
        },
        "compile": {
          "type": "object"
        }
      }
    },
    "shape": {
      "type": "object",
      "required": [
        "primitive",
        "parameters"
      ],
      "properties": {
        "primitive": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "relationship": {
      "type": "object",
      "required": [
        "type",
        "target"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "physical_relation": {
      "type": "object",
      "required": [
        "type",
        "subject"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "contact",
            "contacts",
            "attached_to",
            "mounted_on",
            "supported_by",
            "rests_on",
            "must_not_intersect",
            "grounded",
            "left_of",
            "right_of",
            "above",
            "below",
            "inside",
            "aligned_with",
            "touching",
            "same_row",
            "mirrored_pair",
            "centered_on"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "subject_face": {
          "$ref": "#/$defs/box_face"
        },
        "target_face": {
          "$ref": "#/$defs/box_face"
        },
        "overlap_axes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/axis"
          }
        },
        "min_overlap_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tolerance_mm": {
          "type": "number",
          "minimum": 0
        },
        "allowed_penetration_mm": {
          "type": "number",
          "minimum": 0
        },
        "min_delta_mm": {
          "type": "number",
          "minimum": 0
        },
        "ground_z": {
          "type": "number"
        },
        "source": {
          "type": "string"
        },
        "coordinate_space": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_required": {
          "type": "boolean"
        },
        "visual_axis": {
          "type": ["string", "null"]
        },
        "evidence": {
          "type": ["object", "null"]
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "error"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "visual_relation": {
      "type": "object",
      "required": [
        "id",
        "type",
        "subject",
        "target"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "left_of",
            "right_of",
            "above",
            "below",
            "inside",
            "aligned_with",
            "touching",
            "same_row",
            "mirrored_pair",
            "centered_on"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "review_required": {
          "type": "boolean"
        },
        "evidence": {
          "type": "object"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "box_face": {
      "enum": [
        "left",
        "right",
        "front",
        "back",
        "bottom",
        "top"
      ]
    },
    "axis": {
      "enum": [
        "x",
        "y",
        "z"
      ]
    },
    "feature_intent": {
      "type": "object",
      "required": [
        "id",
        "operation",
        "face",
        "parameters",
        "fallback_state"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "enum": [
            "cut_hole",
            "cut_slot",
            "cut_recess",
            "add_boss",
            "add_raised_rib"
          ]
        },
        "face": {
          "enum": [
            "top",
            "bottom",
            "front",
            "back",
            "left",
            "right"
          ]
        },
        "parameters": {
          "type": "object"
        },
        "semantic": {
          "type": "string"
        },
        "fallback_state": {
          "$ref": "#/$defs/fallback_state"
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "grounding_status": {
          "$ref": "#/$defs/grounding_status"
        },
        "grounding_method": {
          "type": ["string", "null"]
        },
        "source_observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projection_residuals": {
          "type": ["object", "null"]
        },
        "review_required": {
          "type": "boolean"
        },
        "helper_allowed": {
          "type": "boolean"
        },
        "photo_grade_eligible": {
          "type": "boolean"
        }
      }
    },
    "graph_operation": {
      "type": "object",
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "minLength": 1
        },
        "target_part_id": {
          "type": "string"
        },
        "tool_part_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "result_part_id": {
          "type": "string"
        },
        "part_id": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence_source": {
      "type": "object",
      "required": [
        "kind",
        "status"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "type": "string"
        },
        "source_image": {
          "type": "string"
        },
        "observation_id": {
          "type": "string"
        },
        "source_observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "grounding": {
          "type": "object"
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence_graph_part": {
      "type": "object",
      "required": [
        "part_id",
        "status",
        "required_views",
        "confirmed_views",
        "missing_views",
        "sources",
        "confidence"
      ],
      "properties": {
        "part_id": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/evidence_status"
        },
        "required_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmed_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        },
        "parameter_proposals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/parameter_proposal_ref"
          }
        },
        "grounding_status": {
          "$ref": "#/$defs/grounding_status"
        },
        "grounding_method": {
          "type": ["string", "null"]
        },
        "source_observation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "review_required": {
          "type": "boolean"
        },
        "photo_grade_eligible": {
          "type": "boolean"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "part_match": {
      "type": "object",
      "required": [
        "part_id",
        "strategy",
        "matched_views",
        "missing_views",
        "source_count",
        "confidence"
      ],
      "properties": {
        "part_id": {
          "type": "string"
        },
        "strategy": {
          "type": "string"
        },
        "matched_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_count": {
          "type": "integer"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "correction_target": {
      "type": "object",
      "required": [
        "path",
        "reason"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "part_id": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warn",
            "error"
          ]
        }
      }
    },
    "parameter_proposal": {
      "type": "object",
      "required": [
        "part_id",
        "parameter",
        "path",
        "proposed_value",
        "confidence",
        "status",
        "review_required"
      ],
      "properties": {
        "part_id": {
          "type": "string",
          "minLength": 1
        },
        "proposal_kind": {
          "type": "string"
        },
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string"
        },
        "current_value": {},
        "proposed_value": {},
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "ready_for_correction_patch",
            "needs_review"
          ]
        },
        "review_required": {
          "type": "boolean"
        },
        "basis": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_count": {
          "type": "integer"
        },
        "source_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confirmed_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing_views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "image_measurements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/image_measurement"
          }
        },
        "evidence_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence_source"
          }
        }
      }
    },
    "parameter_proposal_ref": {
      "type": "object",
      "required": [
        "parameter",
        "path",
        "confidence",
        "status",
        "review_required"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "ready_for_correction_patch",
            "needs_review"
          ]
        },
        "review_required": {
          "type": "boolean"
        }
      }
    },
    "image_measurement": {
      "type": "object",
      "required": [
        "view",
        "source_image",
        "observation_id",
        "kind"
      ],
      "properties": {
        "view": {
          "type": "string"
        },
        "source_image": {
          "type": "string"
        },
        "observation_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox_px": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "width_mm": {
          "type": "number"
        },
        "height_mm": {
          "type": "number"
        },
        "point_count": {
          "type": "integer"
        },
        "calibration_view": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "evidence_status": {
      "enum": [
        "observed",
        "inferred",
        "profile_default",
        "manual_confirmed",
        "needs_review"
      ]
    },
    "grounding_status": {
      "enum": [
        "image_grounded",
        "review_confirmed",
        "helper_only",
        "profile_prior",
        "rejected"
      ]
    },
    "grounding_decision": {
      "enum": [
        "promoted_geometry",
        "review_candidate",
        "helper_only",
        "rejected"
      ]
    },
    "fallback_state": {
      "enum": [
        "real_feature_op",
        "structured_primitive",
        "visual_helper",
        "box_approximation",
        "profile_default",
        "reference_only",
        "needs_review"
      ]
    }
  }
}
