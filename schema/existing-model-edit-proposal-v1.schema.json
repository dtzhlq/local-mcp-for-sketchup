{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/sketchup-mcp-replica/existing-model-edit-proposal-v1.schema.json",
  "title": "Existing Model Edit Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "graph_id", "model_revision", "instruction", "target_query", "requested_action", "candidates", "exclusions", "selected_targets", "operation_proposal", "shared_definition_policy", "risk_level", "confidence", "requires_clarification", "ambiguity_reasons", "execution_allowed", "execution_route", "proposal_id", "clarification", "next_action"],
  "properties": {
    "version": { "const": "existing-model-edit-proposal.v1" },
    "kind": { "const": "existing_model_edit_proposal" },
    "proposal_id": { "type": "string", "pattern": "^edit-proposal-[0-9a-f]{24}$" },
    "graph_id": { "type": "string", "pattern": "^model-graph-[0-9a-f]{24}$" },
    "model_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "instruction": { "$ref": "#/$defs/untrusted" },
    "target_query": { "$ref": "#/$defs/untrusted" },
    "requested_action": { "type": ["string", "null"] },
    "candidates": { "type": "array", "items": { "$ref": "#/$defs/candidate" } },
    "exclusions": { "type": "array", "items": { "type": "object" } },
    "selected_targets": { "type": "array", "items": { "type": "object" } },
    "operation_proposal": { "type": "array", "items": { "type": "object" } },
    "shared_definition_policy": { "type": "object" },
    "risk_level": { "type": ["string", "null"], "enum": ["S1", "S2", "S3", "S4", null] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "requires_clarification": { "type": "boolean" },
    "ambiguity_reasons": { "type": "array", "items": { "type": "string" } },
    "execution_allowed": { "const": false },
    "execution_route": { "const": "trusted_reviewed_existing_model_edit_only" },
    "clarification": { "type": ["object", "null"] },
    "next_action": { "type": "object" }
  },
  "$defs": {
    "untrusted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trust", "source", "value", "policy_effect"],
      "properties": {
        "trust": { "const": "untrusted_data" },
        "source": { "type": "string" },
        "value": {},
        "policy_effect": { "const": "none" }
      }
    },
    "candidate": {
      "type": "object",
      "required": ["node_id", "persistent_ref", "entity_path", "entity_type", "confidence", "allowed_for_operation", "evidence", "shared_definition", "affected_instance_count", "summary"],
      "properties": {
        "node_id": { "type": "string" },
        "persistent_ref": { "type": "object", "minProperties": 1 },
        "entity_path": { "type": ["string", "null"] },
        "entity_type": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "allowed_for_operation": { "type": "boolean" },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "shared_definition": { "type": "boolean" },
        "affected_instance_count": { "type": "integer", "minimum": 0 },
        "summary": { "$ref": "#/$defs/untrusted" }
      },
      "additionalProperties": false
    }
  }
}
