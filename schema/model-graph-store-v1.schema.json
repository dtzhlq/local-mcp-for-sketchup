{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/sketchup-mcp-replica/model-graph-store-v1.schema.json",
  "title": "ModelGraph Store Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "kind", "model_key", "identity", "current_graph_id", "current_model_revision", "version_count", "versions", "created_at", "updated_at"],
  "properties": {
    "version": { "const": "model-graph-store.v1" },
    "kind": { "const": "model_graph_manifest" },
    "model_key": { "type": "string", "pattern": "^model_[0-9a-f]{32}$" },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "stability", "runtime", "fingerprint", "sensitive_values_persisted"],
      "properties": {
        "basis": { "enum": ["model_guid", "source_path", "document_id", "runtime_object_id"] },
        "stability": { "enum": ["persistent", "session", "version"] },
        "runtime": { "enum": ["mock", "queue"] },
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "sensitive_values_persisted": { "const": false }
      }
    },
    "current_graph_id": { "type": "string", "pattern": "^model-graph-[0-9a-f]{24}$" },
    "current_model_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "version_count": { "type": "integer", "minimum": 1 },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/version_entry" }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "updated_at": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "version_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "graph_id", "model_revision", "content_sha256", "artifact_path", "source_task_id", "created_at", "delta_from_previous"],
      "properties": {
        "sequence": { "type": "integer", "minimum": 1 },
        "graph_id": { "type": "string", "pattern": "^model-graph-[0-9a-f]{24}$" },
        "model_revision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "content_sha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "artifact_path": { "type": "string", "pattern": "^graphs/model-graph-[0-9a-f]{24}\\.json$" },
        "source_task_id": { "type": ["string", "null"], "pattern": "^task_[0-9a-f-]+$" },
        "created_at": { "type": "string", "minLength": 1 },
        "delta_from_previous": {
          "type": "object",
          "additionalProperties": false,
          "required": ["previous_graph_id", "added_nodes", "removed_nodes", "changed_nodes", "added_relationships", "removed_relationships"],
          "properties": {
            "previous_graph_id": { "type": ["string", "null"], "pattern": "^model-graph-[0-9a-f]{24}$" },
            "added_nodes": { "type": "integer", "minimum": 0 },
            "removed_nodes": { "type": "integer", "minimum": 0 },
            "changed_nodes": { "type": "integer", "minimum": 0 },
            "added_relationships": { "type": "integer", "minimum": 0 },
            "removed_relationships": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
