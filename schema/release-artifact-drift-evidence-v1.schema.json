{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-mcp-for-sketchup.invalid/local-mcp-for-sketchup/release-artifact-drift-evidence-v1.schema.json",
  "title": "Historical signed RC artifact drift evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "observed_on",
    "verification",
    "observed_artifacts",
    "historical_signed_rc_declaration",
    "comparison",
    "integrity_decision",
    "release_acceptance",
    "boundary"
  ],
  "properties": {
    "version": { "const": "release-artifact-drift-evidence.v1" },
    "kind": { "const": "historical_signed_rc_artifact_drift_evidence" },
    "observed_on": { "const": "2026-07-21" },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "local_release_artifacts_read", "artifact_bytes_modified", "queue_requested", "queue_files_read"],
      "properties": {
        "mode": { "const": "explicit_read_only_local_release_artifact_integrity" },
        "local_release_artifacts_read": { "const": 3 },
        "artifact_bytes_modified": { "const": false },
        "queue_requested": { "const": false },
        "queue_files_read": { "const": false }
      }
    },
    "observed_artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "sidecar", "rbz"],
      "properties": {
        "manifest": {
          "allOf": [
            { "$ref": "#/$defs/observedArtifact" },
            {
              "type": "object",
              "properties": {
                "path": { "const": "out/releases/release-manifest-0.1.0-rc.2.json" },
                "size_bytes": { "const": 1000 },
                "sha256": { "const": "sha256:8d19bb41f3df12353365be2ab6c1f6c7e27cb0ccf0a2a9ed4095e48e4a78296a" },
                "mtime_observed": { "const": "2026-07-15T05:06:16.827Z" }
              }
            }
          ]
        },
        "sidecar": {
          "allOf": [
            { "$ref": "#/$defs/observedArtifact" },
            {
              "type": "object",
              "properties": {
                "path": { "const": "out/releases/local-mcp-sketchup-mcp-0.1.0-rc.2.sha256" },
                "size_bytes": { "const": 99 },
                "sha256": { "const": "sha256:45c39d3e28e705b046700a13f0b525b68634fe28ee1bbf83ee0282d57ec0aac7" },
                "mtime_observed": { "const": "2026-07-15T05:06:16.826Z" }
              }
            }
          ]
        },
        "rbz": {
          "allOf": [
            { "$ref": "#/$defs/observedArtifact" },
            {
              "type": "object",
              "properties": {
                "path": { "const": "out/releases/local-mcp-sketchup-mcp-0.1.0-rc.2.rbz" },
                "size_bytes": { "const": 90432 },
                "sha256": { "const": "sha256:01a95525bd73d48d40e1e50e2fee61d967b72f58752396e01bfdc3897dced34d" },
                "mtime_observed": { "const": "2026-07-21T05:31:39.099Z" }
              }
            }
          ]
        }
      }
    },
    "historical_signed_rc_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product_version", "release_status", "rc_signed", "source_path", "git", "expected_rbz", "sidecar"],
      "properties": {
        "product_version": { "const": "0.1.0-rc.2" },
        "release_status": { "const": "rc_candidate_verified" },
        "rc_signed": { "const": true },
        "source_path": { "const": "out/releases/release-manifest-0.1.0-rc.2.json" },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["branch", "head", "semantics"],
          "properties": {
            "branch": { "const": "codex/two-week-release-critical" },
            "head": { "const": "b4470f4c5de5992b30411a9a1c3b82ba1aabfdfd" },
            "semantics": { "const": "historical_manifest_declaration_not_current_checkout_assertion" }
          }
        },
        "expected_rbz": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "size_bytes", "sha256"],
          "properties": {
            "path": { "const": "out/releases/local-mcp-sketchup-mcp-0.1.0-rc.2.rbz" },
            "size_bytes": { "const": 70724 },
            "sha256": { "const": "sha256:4b20f4d26220d3e7b933b7a27f6eb6f74997fbad0bcb46ef5bc39b0a64e5ed0a" }
          }
        },
        "sidecar": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "declared_filename", "declared_sha256"],
          "properties": {
            "path": { "const": "out/releases/local-mcp-sketchup-mcp-0.1.0-rc.2.sha256" },
            "declared_filename": { "const": "local-mcp-sketchup-mcp-0.1.0-rc.2.rbz" },
            "declared_sha256": { "const": "sha256:4b20f4d26220d3e7b933b7a27f6eb6f74997fbad0bcb46ef5bc39b0a64e5ed0a" }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_and_sidecar_sha256_match",
        "manifest_and_current_rbz_size_match",
        "manifest_and_current_rbz_sha256_match",
        "sidecar_and_current_rbz_sha256_match",
        "manifest_sidecar_consistent_current_rbz_inconsistent",
        "size_delta_bytes",
        "mtime_semantics",
        "mtime_used_for_causal_attribution",
        "drift_cause"
      ],
      "properties": {
        "manifest_and_sidecar_sha256_match": { "const": true },
        "manifest_and_current_rbz_size_match": { "const": false },
        "manifest_and_current_rbz_sha256_match": { "const": false },
        "sidecar_and_current_rbz_sha256_match": { "const": false },
        "manifest_sidecar_consistent_current_rbz_inconsistent": { "const": true },
        "size_delta_bytes": { "const": 19708 },
        "mtime_semantics": { "const": "observation_only_not_causal_attribution" },
        "mtime_used_for_causal_attribution": { "const": false },
        "drift_cause": { "const": "undetermined" }
      }
    },
    "integrity_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_artifact_status",
        "signed_rc_identity_valid",
        "current_artifact_overwrite_allowed",
        "current_artifact_delete_allowed",
        "automatic_self_repair_allowed",
        "historical_manifest_or_sidecar_rewrite_allowed",
        "allowed_recovery_paths"
      ],
      "properties": {
        "current_artifact_status": { "const": "invalid_for_signed_rc" },
        "signed_rc_identity_valid": { "const": false },
        "current_artifact_overwrite_allowed": { "const": false },
        "current_artifact_delete_allowed": { "const": false },
        "automatic_self_repair_allowed": { "const": false },
        "historical_manifest_or_sidecar_rewrite_allowed": { "const": false },
        "allowed_recovery_paths": {
          "type": "array",
          "prefixItems": [
            { "const": "recover_historical_copy_matching_manifest_and_sidecar" },
            { "const": "rebuild_as_new_version_and_regenerate_manifest_sidecar_and_signature" }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "release_acceptance": { "const": false },
    "boundary": {
      "const": "This portable public evidence is a read-only integrity snapshot of exactly three repository-relative 0.1.0-rc.2 release artifacts. It records that the historical manifest and sidecar agree with each other, while the currently present RBZ differs in both byte size and SHA-256. File modification times are observations only and do not identify who or what caused the drift. The manifest branch and head are historical declarations, not assertions about the current checkout. This verifier does not authorize overwriting, deleting, repairing, repackaging, signing, or publishing any artifact, and it does not establish release acceptance."
    }
  },
  "$defs": {
    "observedArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size_bytes", "sha256", "mtime_observed"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^out/releases/[a-zA-Z0-9._-]+$"
        },
        "size_bytes": { "type": "integer", "minimum": 1 },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "mtime_observed": {
          "type": "string",
          "pattern": "^2026-07-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
        }
      }
    }
  }
}
