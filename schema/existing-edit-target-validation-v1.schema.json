{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/schema/existing-edit-target-validation-v1.schema.json",
  "title": "Existing Edit Target Validation v1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "source",
        "complete",
        "truncated",
        "indexed",
        "total_seen",
        "exact_target_count",
        "requested_target_count",
        "leaf_entities_materialized",
        "sufficient_for_review"
      ],
      "properties": {
        "version": { "const": "existing-edit-target-validation.v1" },
        "mode": { "const": "full_recursive" },
        "source": { "const": "default_full_recursive" },
        "complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "indexed": { "type": "integer", "minimum": 0 },
        "total_seen": { "type": "integer", "minimum": 0 },
        "exact_target_count": { "type": "integer", "minimum": 0 },
        "requested_target_count": { "type": "integer", "minimum": 1 },
        "leaf_entities_materialized": { "const": true },
        "sufficient_for_review": { "type": "boolean" }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "mode",
        "source",
        "projection_version",
        "complete",
        "truncated",
        "indexed",
        "total_seen",
        "total_seen_exact",
        "structural_group_limit",
        "exact_target_count",
        "requested_target_count",
        "exact_targets_verified",
        "leaf_entities_materialized",
        "sufficient_for_review"
      ],
      "properties": {
        "version": { "const": "existing-edit-target-validation.v1" },
        "mode": { "const": "structural_groups" },
        "source": { "const": "server_bound_source_proposal" },
        "projection_version": { "const": "structural-groups.v1" },
        "complete": { "type": "boolean" },
        "truncated": { "type": "boolean" },
        "indexed": { "type": "integer", "minimum": 0, "maximum": 5000 },
        "total_seen": { "type": "integer", "minimum": 0 },
        "total_seen_exact": { "type": "boolean" },
        "structural_group_limit": { "type": "integer", "minimum": 1, "maximum": 5000 },
        "exact_target_count": { "type": "integer", "minimum": 0 },
        "requested_target_count": { "type": "integer", "minimum": 1 },
        "exact_targets_verified": { "type": "boolean" },
        "leaf_entities_materialized": { "const": false },
        "sufficient_for_review": { "type": "boolean" }
      }
    }
  ]
}
