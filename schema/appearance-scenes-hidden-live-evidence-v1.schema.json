{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alma.local/schemas/appearance-scenes-hidden-live-evidence-v1.schema.json",
  "title": "Appearance Scenes Hidden Live Evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "kind",
    "captured_at",
    "branch",
    "result",
    "evidence_scope",
    "case_id",
    "runtime",
    "source_fixture",
    "appearance_contract",
    "live_verification",
    "artifacts",
    "source_sha256",
    "acceptance",
    "boundaries"
  ],
  "properties": {
    "version": { "const": "appearance-scenes-hidden-live-evidence.v1" },
    "kind": { "const": "appearance_scenes_hidden_live_evidence" },
    "captured_at": { "type": "string", "format": "date-time" },
    "branch": { "const": "codex/agent-contract-v1" },
    "result": { "const": "live_verified" },
    "evidence_scope": { "const": "single_hash_bound_controlled_appearance_overlay_and_save_reopen_case" },
    "case_id": { "const": "appearance-scenes-hidden" },
    "runtime": { "$ref": "#/$defs/runtime" },
    "source_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivation_class",
        "original_input_sha256",
        "original_bytes_unchanged",
        "texture_input_sha256",
        "texture_input_bytes_unchanged",
        "source_artifact_sha256",
        "uv_target_persistent_id",
        "hidden_target_persistent_id",
        "recursive_total",
        "recursive_materialized",
        "recursive_truncated"
      ],
      "properties": {
        "derivation_class": { "const": "controlled_fixture_overlay_on_user_authorized_real_model_copy" },
        "original_input_sha256": { "$ref": "#/$defs/sha256" },
        "original_bytes_unchanged": { "const": true },
        "texture_input_sha256": { "$ref": "#/$defs/sha256" },
        "texture_input_bytes_unchanged": { "const": true },
        "source_artifact_sha256": { "$ref": "#/$defs/prefixedSha256" },
        "uv_target_persistent_id": { "$ref": "#/$defs/persistentId" },
        "hidden_target_persistent_id": { "$ref": "#/$defs/persistentId" },
        "recursive_total": { "const": 5897 },
        "recursive_materialized": { "const": 5897 },
        "recursive_truncated": { "const": false }
      }
    },
    "appearance_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "material_name_untrusted",
        "scene_name_untrusted",
        "uv_id",
        "uv_evidence_kind",
        "face_uv_operation_applied_without_warning",
        "face_uv_payload_persisted",
        "textured_material_persisted",
        "hidden_target_persisted",
        "independent_uvhelper_coordinate_attestation",
        "arbitrary_uv_editing_proven"
      ],
      "properties": {
        "material_name_untrusted": { "const": "ALMA_Reliability_Appearance_Texture" },
        "scene_name_untrusted": { "const": "ALMA_Reliability_Appearance_Scene" },
        "uv_id": { "const": "reliability-appearance-face-uv" },
        "uv_evidence_kind": { "const": "face_uvs" },
        "face_uv_operation_applied_without_warning": { "const": true },
        "face_uv_payload_persisted": { "const": true },
        "textured_material_persisted": { "const": true },
        "hidden_target_persisted": { "const": true },
        "independent_uvhelper_coordinate_attestation": { "const": false },
        "arbitrary_uv_editing_proven": { "const": false }
      }
    },
    "live_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks_total",
        "tasks_passed",
        "uv_material_signature",
        "uv_material_signature_preserved",
        "scene_visibility_signature",
        "scene_visibility_signature_preserved",
        "scenes",
        "hidden_entities",
        "save_reopen_exact_identity",
        "recursive_entries_before",
        "recursive_entries_after",
        "model_revision_exact_match",
        "snapshot_error_diffs",
        "wrong_object_modification_count",
        "silent_geometry_corruption_count",
        "recovery_attempts",
        "recoveries",
        "recovery_rate",
        "queue_clean"
      ],
      "properties": {
        "tasks_total": { "const": 3 },
        "tasks_passed": { "const": 3 },
        "uv_material_signature": { "$ref": "#/$defs/prefixedSha256" },
        "uv_material_signature_preserved": { "const": true },
        "scene_visibility_signature": { "$ref": "#/$defs/prefixedSha256" },
        "scene_visibility_signature_preserved": { "const": true },
        "scenes": { "const": 1 },
        "hidden_entities": { "const": 1 },
        "save_reopen_exact_identity": { "const": true },
        "recursive_entries_before": { "const": 5897 },
        "recursive_entries_after": { "const": 5897 },
        "model_revision_exact_match": { "const": true },
        "snapshot_error_diffs": { "const": 0 },
        "wrong_object_modification_count": { "const": 0 },
        "silent_geometry_corruption_count": { "const": 0 },
        "recovery_attempts": { "const": 0 },
        "recoveries": { "const": 0 },
        "recovery_rate": { "const": 1 },
        "queue_clean": { "const": true }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "original_input",
        "texture_input",
        "finalization_report",
        "source_model",
        "source_contract",
        "success_report",
        "success_diagnostic",
        "verified_model"
      ],
      "properties": {
        "original_input": { "$ref": "#/$defs/artifact" },
        "texture_input": { "$ref": "#/$defs/artifact" },
        "finalization_report": { "$ref": "#/$defs/artifact" },
        "source_model": { "$ref": "#/$defs/artifact" },
        "source_contract": { "$ref": "#/$defs/artifact" },
        "success_report": { "$ref": "#/$defs/artifact" },
        "success_diagnostic": { "$ref": "#/$defs/artifact" },
        "verified_model": { "$ref": "#/$defs/artifact" }
      }
    },
    "source_sha256": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scripts/build-appearance-scenes-hidden-live-evidence.mjs",
        "scripts/prepare-appearance-scenes-hidden-live-fixture.mjs",
        "scripts/run-real-model-reliability-harness.mjs",
        "scripts/run-real-model-reliability-live-case.mjs",
        "schema/appearance-scenes-hidden-live-evidence-v1.schema.json",
        "schema/controlled-appearance-live-fixture-v1.schema.json",
        "schema/real-model-reliability-live-case-report-v1.schema.json",
        "schema/real-model-reliability-live-case-v1.schema.json",
        "sketchup_plugin/alma_sketchup_mcp/appearance_operations.rb",
        "sketchup_plugin/alma_sketchup_mcp/model_revision.rb",
        "sketchup_plugin/alma_sketchup_mcp/snapshot.rb"
      ],
      "properties": {
        "scripts/build-appearance-scenes-hidden-live-evidence.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/prepare-appearance-scenes-hidden-live-fixture.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/run-real-model-reliability-harness.mjs": { "$ref": "#/$defs/sha256" },
        "scripts/run-real-model-reliability-live-case.mjs": { "$ref": "#/$defs/sha256" },
        "schema/appearance-scenes-hidden-live-evidence-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/controlled-appearance-live-fixture-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/real-model-reliability-live-case-report-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "schema/real-model-reliability-live-case-v1.schema.json": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/alma_sketchup_mcp/appearance_operations.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/alma_sketchup_mcp/model_revision.rb": { "$ref": "#/$defs/sha256" },
        "sketchup_plugin/alma_sketchup_mcp/snapshot.rb": { "$ref": "#/$defs/sha256" }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_case_passed",
        "appearance_uv_hidden_preservation",
        "formal_corpus_cases_passed",
        "formal_corpus_cases_total",
        "formal_corpus_complete",
        "cross_version",
        "release_acceptance"
      ],
      "properties": {
        "selected_case_passed": { "const": true },
        "appearance_uv_hidden_preservation": { "const": true },
        "formal_corpus_cases_passed": { "const": 1 },
        "formal_corpus_cases_total": { "const": 7 },
        "formal_corpus_complete": { "const": false },
        "cross_version": { "const": "deferred_by_user" },
        "release_acceptance": { "const": false }
      }
    },
    "boundaries": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 40 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "prefixedSha256": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "persistentId": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:/|[A-Za-z]:[\\\\/]|file://|~/)" }
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "server_version",
        "plugin_version",
        "sketchup_version",
        "ruby_version",
        "capability_version",
        "manifest_version",
        "dsl_version",
        "occurrence_contract",
        "revision_strategy",
        "revision_source_sha256",
        "compatibility_ok"
      ],
      "properties": {
        "name": { "const": "queue" },
        "server_version": { "const": "0.1.0-rc.2" },
        "plugin_version": { "const": "0.1.0-rc.2" },
        "sketchup_version": { "const": "26.2.242" },
        "ruby_version": { "const": "3.2.2" },
        "capability_version": { "const": "0.1.0-rc.2-capabilities.7" },
        "manifest_version": { "const": "2026-07-agent-contract-v1.4" },
        "dsl_version": { "const": 1 },
        "occurrence_contract": { "const": "canonical-occurrence-path.v1" },
        "revision_strategy": { "const": "definition-merkle.v2" },
        "revision_source_sha256": { "$ref": "#/$defs/sha256" },
        "compatibility_ok": { "const": true }
      }
    }
  }
}
