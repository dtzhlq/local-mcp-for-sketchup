{
  "name": "sketchup-mcp-replica",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MVP replica of SketchUp Cloud MCP workflow for Alma.",
  "bin": {
    "sketchup-modeler": "./bin/sketchup-modeler"
  },
  "scripts": {
    "get-docs": "node src/cli.mjs get_docs",
    "demo": "node src/cli.mjs build_model --runtime mock --code-file examples/demo-room.json",
    "reset": "node src/cli.mjs reset_model --runtime mock",
    "save": "node src/cli.mjs save_model --runtime mock --path output/mock-model.json",
    "server": "node src/http-server.mjs",
    "mcp": "node src/mcp-server.mjs",
    "registry:sync": "node scripts/generate-ruby-operation-registry.mjs",
    "registry:check": "node scripts/generate-ruby-operation-registry.mjs --check",
    "plugin:check": "npm run registry:check && node scripts/package-sketchup-plugin.mjs --check",
    "plugin:install": "npm run registry:check && node scripts/package-sketchup-plugin.mjs --check --install",
    "plugin:package": "npm run registry:check && node scripts/package-sketchup-plugin.mjs --check --package",
    "qa:mock": "node scripts/generate-qa-reports.mjs --expected-runtime mock --actual-runtime mock --output-dir output/qa-reports/mock",
    "qa:queue": "node scripts/generate-qa-reports.mjs --expected-runtime mock --actual-runtime queue --timeout-ms 180000 --face-tolerance 1 --edge-tolerance 3 --output-dir output/qa-reports/queue",
    "qa:expert:mock": "node scripts/generate-expert-qa-reports.mjs --runtime mock --output-dir output/qa-reports/expert-mock",
    "qa:expert:queue": "node scripts/generate-expert-qa-reports.mjs --runtime queue --timeout-ms 180000 --output-dir output/qa-reports/expert-queue",
    "qa:budget:mock": "node scripts/run-performance-budgets.mjs --runtime mock --output-dir output/performance-budgets/mock",
    "qa:budget:queue": "node scripts/run-performance-budgets.mjs --runtime queue --timeout-ms 180000 --output-dir output/performance-budgets/queue",
    "qa:identity:mock": "node scripts/generate-qa-reports.mjs --example examples/editing-identity.json --expected-runtime mock --actual-runtime mock --output-dir output/qa-reports/identity-mock",
    "qa:identity:queue": "node scripts/generate-qa-reports.mjs --example examples/editing-identity.json --expected-runtime mock --actual-runtime queue --timeout-ms 60000 --output-dir output/qa-reports/identity-queue",
    "qa:model-layout": "node scripts/generate-model-qa-reports.mjs --output-dir output/model-qa",
    "qa:reference-visual": "node scripts/generate-reference-visual-qa-reports.mjs --output-dir output/reference-visual-qa",
    "qa:physical-consistency": "node scripts/generate-physical-consistency-reports.mjs --output-dir output/physical-consistency-qa",
    "qa:product-samples": "node scripts/generate-product-sample-reports.mjs --output-dir output/product-sample-qa",
    "qa:product-samples:queue": "node scripts/generate-product-sample-reports.mjs --runtime queue --timeout-ms 180000 --output-dir output/product-sample-qa/queue",
    "part-graph:compile-ambulance": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/vehicle_ambulance.json --part-graph examples/part-graphs/ambulance-reference.part-graph.json --output examples/acceptance-ambulance-reference.json",
    "part-graph:compile-switch": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/game_controller_switch.json --part-graph examples/part-graphs/switch-controller-reference.part-graph.json --output examples/acceptance-switch-controller.json",
    "part-graph:compile-fuji-camera": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/camera_fuji_x_t10.json --part-graph examples/part-graphs/fuji-camera-reference.part-graph.json --output examples/acceptance-fuji-camera.json",
    "acceptance:generate-ambulance": "node scripts/generate-ambulance-reference-demo.mjs --output examples/acceptance-ambulance-reference.json",
    "image-structured:analyze-switch": "node projects/image-structured-modeler/scripts/analyze-image-set.mjs --input test/手柄 --output projects/image-structured-modeler/examples/switch-controller/observations.json --view-hints-file projects/image-structured-modeler/examples/switch-controller/model-plan.example.json",
    "image-structured:generate-switch": "node projects/image-structured-modeler/scripts/generate-model-plan.mjs --input projects/image-structured-modeler/examples/switch-controller/observations.json --output projects/image-structured-modeler/examples/switch-controller/model-plan.json --manual-corrections projects/image-structured-modeler/examples/switch-controller/manual-corrections.json",
    "image-structured:compile-switch": "node projects/image-structured-modeler/scripts/compile-plan-to-sketchup-dsl.mjs --input projects/image-structured-modeler/examples/switch-controller/model-plan.json --output projects/image-structured-modeler/examples/switch-controller/output.json",
    "image-structured:review-switch": "node projects/image-structured-modeler/scripts/make-review-report.mjs --observations projects/image-structured-modeler/examples/switch-controller/observations.json --model-plan projects/image-structured-modeler/examples/switch-controller/model-plan.json --output-dsl projects/image-structured-modeler/examples/switch-controller/output.json --manual-corrections projects/image-structured-modeler/examples/switch-controller/manual-corrections.json --output projects/image-structured-modeler/examples/switch-controller/review/index.html",
    "image-structured:snapshot-switch": "node projects/image-structured-modeler/scripts/make-snapshot-report.mjs --output-dsl projects/image-structured-modeler/examples/switch-controller/output.json --output-dir projects/image-structured-modeler/examples/switch-controller/review",
    "image-structured:snapshot-switch:queue": "node projects/image-structured-modeler/scripts/make-snapshot-report.mjs --runtime queue --timeout-ms 180000 --save-skp output/image-structured-switch-controller.skp --output-dsl projects/image-structured-modeler/examples/switch-controller/output.json --output-dir projects/image-structured-modeler/examples/switch-controller/review --json-name snapshot-report-queue.json --markdown-name snapshot-report-queue.md",
    "image-structured:diff-switch:queue": "node projects/image-structured-modeler/scripts/make-snapshot-report.mjs --compare-runtime queue --timeout-ms 180000 --output-dsl projects/image-structured-modeler/examples/switch-controller/output.json --output-dir projects/image-structured-modeler/examples/switch-controller/review",
    "image-structured:build-switch": "npm run image-structured:analyze-switch && npm run image-structured:generate-switch && npm run image-structured:compile-switch && npm run image-structured:review-switch && npm run image-structured:snapshot-switch",
    "image-structured:generate-remote": "node projects/image-structured-modeler/scripts/generate-model-plan.mjs --input projects/image-structured-modeler/examples/compact-remote/observations.json --output projects/image-structured-modeler/examples/compact-remote/model-plan.json --manual-corrections projects/image-structured-modeler/examples/compact-remote/manual-corrections.json",
    "image-structured:compile-remote": "node projects/image-structured-modeler/scripts/compile-plan-to-sketchup-dsl.mjs --input projects/image-structured-modeler/examples/compact-remote/model-plan.json --output projects/image-structured-modeler/examples/compact-remote/output.json",
    "image-structured:review-remote": "node projects/image-structured-modeler/scripts/make-review-report.mjs --observations projects/image-structured-modeler/examples/compact-remote/observations.json --model-plan projects/image-structured-modeler/examples/compact-remote/model-plan.json --output-dsl projects/image-structured-modeler/examples/compact-remote/output.json --manual-corrections projects/image-structured-modeler/examples/compact-remote/manual-corrections.json --output projects/image-structured-modeler/examples/compact-remote/review/index.html",
    "image-structured:snapshot-remote": "node projects/image-structured-modeler/scripts/make-snapshot-report.mjs --output-dsl projects/image-structured-modeler/examples/compact-remote/output.json --output-dir projects/image-structured-modeler/examples/compact-remote/review",
    "image-structured:snapshot-remote:queue": "node projects/image-structured-modeler/scripts/make-snapshot-report.mjs --runtime queue --timeout-ms 180000 --save-skp output/image-structured-compact-remote.skp --output-dsl projects/image-structured-modeler/examples/compact-remote/output.json --output-dir projects/image-structured-modeler/examples/compact-remote/review --json-name snapshot-report-queue.json --markdown-name snapshot-report-queue.md",
    "image-structured:diff-remote:queue": "node projects/image-structured-modeler/scripts/make-snapshot-report.mjs --compare-runtime queue --timeout-ms 180000 --output-dsl projects/image-structured-modeler/examples/compact-remote/output.json --output-dir projects/image-structured-modeler/examples/compact-remote/review",
    "image-structured:build-remote": "npm run image-structured:generate-remote && npm run image-structured:compile-remote && npm run image-structured:review-remote && npm run image-structured:snapshot-remote",
    "image-structured:analyze-ambulance": "node projects/image-structured-modeler/scripts/analyze-image-set.mjs --input test/救护车 --object-type vehicle_ambulance --object-name \"Reference Toy Ambulance\" --output projects/image-structured-modeler/examples/ambulance/observations.json --overlay-dir projects/image-structured-modeler/examples/ambulance/review-overlays --view-hints-file examples/product-profiles/vehicle_ambulance.json",
    "image-structured:analyze-building-group": "node projects/image-structured-modeler/scripts/analyze-image-set.mjs --input test/建筑群 --object-type building_group --object-name \"GPT Image Industrial Campus\" --output projects/image-structured-modeler/examples/building-group/observations.json --overlay-dir projects/image-structured-modeler/examples/building-group/review-overlays --view-hints-file projects/image-structured-modeler/examples/building-group/view-hints.json",
    "image-structured:part-graph-building-group": "node projects/image-structured-modeler/scripts/generate-part-graph-from-observations.mjs --observations projects/image-structured-modeler/examples/building-group/observations.json --profile examples/product-profiles/building_group_industrial_campus.json --output projects/image-structured-modeler/examples/building-group/part-graph.massing.json --id building-group-image-evidence-massing-part-graph --product-name \"GPT Image Industrial Campus\"",
    "image-structured:compile-building-group": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.massing.json --output projects/image-structured-modeler/examples/building-group/output.massing.json",
    "image-structured:build-building-group": "npm run image-structured:analyze-building-group && npm run image-structured:part-graph-building-group && npm run image-structured:compile-building-group",
    "image-structured:qa-building-group-layout": "node scripts/generate-model-qa-reports.mjs --output-dir projects/image-structured-modeler/examples/building-group/layout-qa --example building-group-massing:projects/image-structured-modeler/examples/building-group/output.massing.json:examples/model-qa/building-group-massing.json",
    "image-structured:qa-building-group-reference": "node scripts/generate-reference-visual-qa-reports.mjs --output-dir projects/image-structured-modeler/examples/building-group/reference-visual-qa --example building-group-massing:projects/image-structured-modeler/examples/building-group/output.massing.json:examples/reference-visual-qa/building-group-massing.json",
    "image-structured:qa-building-group": "npm run image-structured:qa-building-group-layout && npm run image-structured:qa-building-group-reference",
    "image-structured:qa-building-group:queue": "node scripts/generate-model-qa-reports.mjs --runtime queue --timeout-ms 180000 --output-dir projects/image-structured-modeler/examples/building-group/layout-qa-queue --example building-group-massing:projects/image-structured-modeler/examples/building-group/output.massing.json:examples/model-qa/building-group-massing.json && node scripts/generate-reference-visual-qa-reports.mjs --runtime queue --timeout-ms 180000 --output-dir projects/image-structured-modeler/examples/building-group/reference-visual-qa-queue --example building-group-massing:projects/image-structured-modeler/examples/building-group/output.massing.json:examples/reference-visual-qa/building-group-massing.json && node src/cli.mjs save_model --runtime queue --timeout-ms 180000 --path output/image-structured-building-group-massing.skp",
    "image-structured:proposal-patch-building-group": "node projects/image-structured-modeler/scripts/build-part-graph-proposal-patch.mjs --part-graph projects/image-structured-modeler/examples/building-group/part-graph.massing.json --review projects/image-structured-modeler/examples/building-group/parameter-proposal-review.accepted.json --output-patch projects/image-structured-modeler/examples/building-group/correction-patch.detail-proposals.json --output-part-graph projects/image-structured-modeler/examples/building-group/part-graph.detail-proposal-applied.json",
    "image-structured:proposal-review-building-group": "node projects/image-structured-modeler/scripts/make-part-graph-proposal-review.mjs --part-graph projects/image-structured-modeler/examples/building-group/part-graph.massing.json --accepted-review projects/image-structured-modeler/examples/building-group/parameter-proposal-review.accepted.json --patch projects/image-structured-modeler/examples/building-group/correction-patch.detail-proposals.json --output projects/image-structured-modeler/examples/building-group/proposal-review/index.html",
    "image-structured:compile-building-group-proposal-applied": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.detail-proposal-applied.json --output projects/image-structured-modeler/examples/building-group/output.detail-proposal-applied.json",
    "image-structured:proposal-review-qa-building-group": "node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --name building-group-detail-proposal-applied --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.detail-proposal-applied.json --code projects/image-structured-modeler/examples/building-group/output.detail-proposal-applied.json --layout-spec examples/model-qa/building-group-massing.json --reference-spec examples/reference-visual-qa/building-group-massing.json --output-dir projects/image-structured-modeler/examples/building-group/proposal-qa",
    "image-structured:proposal-review-chain-building-group": "npm run image-structured:proposal-patch-building-group && npm run image-structured:proposal-review-building-group && npm run image-structured:compile-building-group-proposal-applied && npm run image-structured:proposal-review-qa-building-group",
    "image-structured:proposal-review-chain-building-group:queue": "npm run image-structured:proposal-patch-building-group && npm run image-structured:proposal-review-building-group && npm run image-structured:compile-building-group-proposal-applied && node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --name building-group-detail-proposal-applied --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.detail-proposal-applied.json --code projects/image-structured-modeler/examples/building-group/output.detail-proposal-applied.json --layout-spec examples/model-qa/building-group-massing.json --reference-spec examples/reference-visual-qa/building-group-massing.json --runtime queue --timeout-ms 180000 --save-skp output/image-structured-building-group-detail-proposal-applied.skp --output-dir projects/image-structured-modeler/examples/building-group/proposal-qa-queue",
    "image-structured:proposal-patch-building-group-all": "node projects/image-structured-modeler/scripts/build-part-graph-proposal-patch.mjs --part-graph projects/image-structured-modeler/examples/building-group/part-graph.massing.json --review projects/image-structured-modeler/examples/building-group/parameter-proposal-review.accepted-all.json --output-patch projects/image-structured-modeler/examples/building-group/correction-patch.detail-proposals-all.json --output-part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-final.json",
    "image-structured:proposal-review-building-group-all": "node projects/image-structured-modeler/scripts/make-part-graph-proposal-review.mjs --part-graph projects/image-structured-modeler/examples/building-group/part-graph.massing.json --accepted-review projects/image-structured-modeler/examples/building-group/parameter-proposal-review.accepted-all.json --patch projects/image-structured-modeler/examples/building-group/correction-patch.detail-proposals-all.json --output projects/image-structured-modeler/examples/building-group/proposal-review-r7-final/index.html",
    "image-structured:compile-building-group-r7-final": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-final.json --output projects/image-structured-modeler/examples/building-group/output.r7-final.json",
    "image-structured:qa-building-group-r7-final-layout": "node scripts/generate-model-qa-reports.mjs --output-dir projects/image-structured-modeler/examples/building-group/layout-qa-r7-final --example building-group-r7-final:projects/image-structured-modeler/examples/building-group/output.r7-final.json:examples/model-qa/building-group-massing.json",
    "image-structured:qa-building-group-r7-final-reference": "node scripts/generate-reference-visual-qa-reports.mjs --output-dir projects/image-structured-modeler/examples/building-group/reference-visual-qa-r7-final --example building-group-r7-final:projects/image-structured-modeler/examples/building-group/output.r7-final.json:examples/reference-visual-qa/building-group-r7-final.json",
    "image-structured:proposal-review-qa-building-group-all": "node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --name building-group-r7-final --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-final.json --code projects/image-structured-modeler/examples/building-group/output.r7-final.json --layout-spec examples/model-qa/building-group-massing.json --reference-spec examples/reference-visual-qa/building-group-r7-final.json --output-dir projects/image-structured-modeler/examples/building-group/proposal-qa-r7-final",
    "image-structured:proposal-review-chain-building-group-all": "npm run image-structured:proposal-patch-building-group-all && npm run image-structured:proposal-review-building-group-all && npm run image-structured:compile-building-group-r7-final && npm run image-structured:qa-building-group-r7-final-layout && npm run image-structured:qa-building-group-r7-final-reference && npm run image-structured:proposal-review-qa-building-group-all",
    "image-structured:proposal-review-chain-building-group-all:queue": "npm run image-structured:proposal-patch-building-group-all && npm run image-structured:proposal-review-building-group-all && npm run image-structured:compile-building-group-r7-final && node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --name building-group-r7-final --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-final.json --code projects/image-structured-modeler/examples/building-group/output.r7-final.json --layout-spec examples/model-qa/building-group-massing.json --reference-spec examples/reference-visual-qa/building-group-r7-final.json --runtime queue --timeout-ms 180000 --save-skp output/image-structured-building-group-r7-final.skp --output-dir projects/image-structured-modeler/examples/building-group/proposal-qa-r7-final-queue",
    "image-structured:part-graph-building-group-r7-photoreal": "node projects/image-structured-modeler/scripts/build-building-group-photoreal-part-graph.mjs --base-part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-final.json --output projects/image-structured-modeler/examples/building-group/part-graph.r7-photoreal.json",
    "image-structured:compile-building-group-r7-photoreal": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-photoreal.json --output projects/image-structured-modeler/examples/building-group/output.r7-photoreal.json",
    "image-structured:qa-building-group-r7-photoreal-layout": "node scripts/generate-model-qa-reports.mjs --output-dir projects/image-structured-modeler/examples/building-group/layout-qa-r7-photoreal --example building-group-r7-photoreal:projects/image-structured-modeler/examples/building-group/output.r7-photoreal.json:examples/model-qa/building-group-r7-photoreal.json",
    "image-structured:qa-building-group-r7-photoreal-reference": "node scripts/generate-reference-visual-qa-reports.mjs --output-dir projects/image-structured-modeler/examples/building-group/reference-visual-qa-r7-photoreal --example building-group-r7-photoreal:projects/image-structured-modeler/examples/building-group/output.r7-photoreal.json:examples/reference-visual-qa/building-group-r7-photoreal.json",
    "image-structured:proposal-review-qa-building-group-r7-photoreal": "node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --name building-group-r7-photoreal --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-photoreal.json --code projects/image-structured-modeler/examples/building-group/output.r7-photoreal.json --layout-spec examples/model-qa/building-group-r7-photoreal.json --reference-spec examples/reference-visual-qa/building-group-r7-photoreal.json --output-dir projects/image-structured-modeler/examples/building-group/proposal-qa-r7-photoreal",
    "image-structured:r7-building-group-photoreal": "npm run image-structured:part-graph-building-group-r7-photoreal && npm run image-structured:compile-building-group-r7-photoreal && npm run image-structured:qa-building-group-r7-photoreal-layout && npm run image-structured:qa-building-group-r7-photoreal-reference && npm run image-structured:proposal-review-qa-building-group-r7-photoreal",
    "image-structured:r7-building-group-photoreal:queue": "npm run image-structured:part-graph-building-group-r7-photoreal && npm run image-structured:compile-building-group-r7-photoreal && node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --name building-group-r7-photoreal --profile examples/product-profiles/building_group_industrial_campus.json --part-graph projects/image-structured-modeler/examples/building-group/part-graph.r7-photoreal.json --code projects/image-structured-modeler/examples/building-group/output.r7-photoreal.json --layout-spec examples/model-qa/building-group-r7-photoreal.json --reference-spec examples/reference-visual-qa/building-group-r7-photoreal.json --runtime queue --timeout-ms 180000 --save-skp output/image-structured-building-group-r7-photoreal.skp --output-dir projects/image-structured-modeler/examples/building-group/proposal-qa-r7-photoreal-queue",
    "image-structured:r7-building-group-final": "npm run image-structured:build-building-group && npm run image-structured:qa-building-group && npm run image-structured:proposal-review-chain-building-group && npm run image-structured:proposal-review-chain-building-group-all",
    "image-structured:r7-building-group-final:queue": "npm run image-structured:build-building-group && npm run image-structured:qa-building-group:queue && npm run image-structured:proposal-review-chain-building-group:queue && npm run image-structured:proposal-review-chain-building-group-all:queue",
    "image-structured:review-building-group": "npm run image-structured:build-building-group && npm run image-structured:qa-building-group && npm run image-structured:proposal-review-chain-building-group",
    "image-structured:part-graph-ambulance": "node projects/image-structured-modeler/scripts/generate-part-graph-from-observations.mjs --observations projects/image-structured-modeler/examples/ambulance/observations.json --profile examples/product-profiles/vehicle_ambulance.json --seed-part-graph examples/part-graphs/ambulance-reference.part-graph.json --output projects/image-structured-modeler/examples/ambulance/part-graph.generated.json --id ambulance-image-evidence-part-graph --product-name \"Reference Toy Ambulance\"",
    "image-structured:part-graph-ambulance-skeleton": "node projects/image-structured-modeler/scripts/generate-part-graph-from-observations.mjs --observations projects/image-structured-modeler/examples/ambulance/observations.json --profile examples/product-profiles/vehicle_ambulance.json --output projects/image-structured-modeler/examples/ambulance/part-graph.skeleton.json --id ambulance-image-evidence-skeleton-part-graph --product-name \"Reference Toy Ambulance\"",
    "image-structured:proposal-patch-ambulance": "node projects/image-structured-modeler/scripts/build-part-graph-proposal-patch.mjs --part-graph projects/image-structured-modeler/examples/ambulance/part-graph.skeleton.json --review projects/image-structured-modeler/examples/ambulance/parameter-proposal-review.accepted.json --output-patch projects/image-structured-modeler/examples/ambulance/correction-patch.parameter-proposals.json --output-part-graph projects/image-structured-modeler/examples/ambulance/part-graph.proposal-applied.json",
    "image-structured:proposal-review-ambulance": "node projects/image-structured-modeler/scripts/make-part-graph-proposal-review.mjs --part-graph projects/image-structured-modeler/examples/ambulance/part-graph.skeleton.json --accepted-review projects/image-structured-modeler/examples/ambulance/parameter-proposal-review.accepted.json --patch projects/image-structured-modeler/examples/ambulance/correction-patch.parameter-proposals.json --output projects/image-structured-modeler/examples/ambulance/proposal-review/index.html",
    "image-structured:compile-ambulance-proposal-applied": "node scripts/compile-part-graph-to-sketchup-dsl.mjs --profile examples/product-profiles/vehicle_ambulance.json --part-graph projects/image-structured-modeler/examples/ambulance/part-graph.proposal-applied.json --output projects/image-structured-modeler/examples/ambulance/output.proposal-applied.json",
    "image-structured:proposal-review-qa-ambulance": "node projects/image-structured-modeler/scripts/run-proposal-review-qa.mjs --output-dir output/image-structured-proposal-qa/ambulance",
